<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>

    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="coverlet.collector" Version="6.0.0" />
    <PackageReference Include="Microsoft.NET.Test.Sdk" Version="17.8.0" />
    <PackageReference Include="xunit" Version="2.5.3" />
    <PackageReference Include="xunit.runner.visualstudio" Version="2.5.3" />
    <!-- CAS-005: FluentAssertions + Configuration for the (currently Skip-marked) real-DB tests. -->
    <PackageReference Include="FluentAssertions" Version="6.12.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration" Version="8.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Json" Version="8.0.0" />
    <!-- CAS-002: self-hosted TestServer (Auth/CachetAuth cookie + policy round trip) and mocking
         for the fakes TestHostFactory wires up in place of the real DB/B2 dependencies. -->
    <PackageReference Include="Microsoft.AspNetCore.TestHost" Version="8.0.8" />
    <PackageReference Include="NSubstitute" Version="5.1.0" />
    <!-- CAS-002 coverage follow-up: WebApplicationFactory<Program> now that both Program.cs files
         expose `public partial class Program { }` — exercises the REAL DI/middleware wiring
         (OnValidatePrincipal, cookie scheme, policies) instead of TestHostFactory's hand-built
         copy, for line coverage on Program.cs itself. -->
    <PackageReference Include="Microsoft.AspNetCore.Mvc.Testing" Version="8.0.8" />
  </ItemGroup>

  <ItemGroup>
    <!-- Microsoft.NET.Sdk (not Sdk.Web) does not automatically flow the ASP.NET Core shared
         framework to this project; CAS-002's TestHostFactory needs Authentication.Cookies,
         Authorization, and Mvc APIs directly, not just transitively via the Api ProjectReference. -->
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
  </ItemGroup>

  <ItemGroup>
    <Using Include="Xunit" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cachet.ArchiveSync.Api\Cachet.ArchiveSync.Api.csproj" />
  </ItemGroup>

  <ItemGroup>
    <!-- CAS-040 §13: the one committed binary fixture, shared (linked, not copied) from Api.Tests. -->
    <None Include="..\Cachet.ArchiveSync.Api.Tests\TestAssets\legacy-word-sample.doc" Link="TestAssets\legacy-word-sample.doc" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
