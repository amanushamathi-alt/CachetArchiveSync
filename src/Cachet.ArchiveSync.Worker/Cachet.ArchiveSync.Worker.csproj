<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup Label="Globals">
    <SccProjectName>SAK</SccProjectName>
    <SccProvider>SAK</SccProvider>
    <SccAuxPath>SAK</SccAuxPath>
    <SccLocalPath>SAK</SccLocalPath>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-Cachet.ArchiveSync.Worker-e1344273-d7ea-4195-af73-c63e3f0ed991</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <!-- CAS-001 §6.1: Worker.csproj is Microsoft.NET.Sdk.Worker, not Sdk.Web, so it does not get
         the ASP.NET Core shared framework's implicit IHttpClientFactory support the way Api does
         — AddHttpClient needs this package explicitly here. -->
    <PackageReference Include="Microsoft.Extensions.Http" Version="8.0.1" />
    <!-- CAS-028 §3.6: AddWindowsService() — lets the Worker run as an auto-start Windows Service;
         a no-op under a console or test host. Version matches Microsoft.Extensions.Hosting. -->
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.0.1" />
    <!-- Rolling file log (path and levels come from appsettings.json "Serilog" section). -->
    <PackageReference Include="Serilog.Extensions.Hosting" Version="8.0.0" />
    <PackageReference Include="Serilog.Settings.Configuration" Version="8.0.4" />
    <PackageReference Include="Serilog.Sinks.File" Version="6.0.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- CAS-028 §13: WorkerTaskModuleMapTests asserts the internal task_type → tab_module map and
         the internal fixed failure-reason constants against the sweep SP's literals. -->
    <InternalsVisibleTo Include="Cachet.ArchiveSync.Worker.Tests" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\Cachet.ArchiveSync.Core\Cachet.ArchiveSync.Core.csproj" />
    <!-- CAS-005 §3/§17: Worker registers the same IAuditLogRepository/IAuditLogService
         implementations as Api (first Worker-side caller is CAS-001, not this spec). Direct
         project reference per clean-architecture skill: don't invent a shared Infrastructure
         project ahead of a second, genuinely different implementation-sharing need (P4). -->
    <ProjectReference Include="..\Cachet.ArchiveSync.Api\Cachet.ArchiveSync.Api.csproj" />
  </ItemGroup>

  <!-- Api is a Web SDK project, so its appsettings*.json flow through the ProjectReference into this
       project's publish list alongside the Worker's own, failing publish with NETSDK1152 (duplicate
       relative path). Drop Api's copies so only the Worker's settings are published. -->
  <PropertyGroup>
    <_ApiProjectDir>$([System.IO.Path]::GetFullPath('$(MSBuildThisFileDirectory)..\Cachet.ArchiveSync.Api\').ToLowerInvariant())</_ApiProjectDir>
  </PropertyGroup>
  <Target Name="ExcludeApiAppSettingsFromPublish" AfterTargets="ComputeFilesToPublish" BeforeTargets="_HandleFileConflictsForPublish">
    <ItemGroup>
      <ResolvedFileToPublish Remove="@(ResolvedFileToPublish)"
                             Condition="$([System.String]::Copy('%(Filename)').StartsWith('appsettings')) and '%(Extension)' == '.json' and $([System.String]::Copy('%(FullPath)').ToLowerInvariant().StartsWith('$(_ApiProjectDir)'))" />
    </ItemGroup>
  </Target>
</Project>
