{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.Hosting.Lifetime": "Information"
    }
  },
  "Serilog": {
    "WriteTo": [
      {
        "Name": "File",
        "Args": {
          "path": "Logs/worker-.log",
          "rollingInterval": "Day",
          "retainedFileCountLimit": 7,
          "shared": true,
          "outputTemplate": "{Timestamp:yyyy-MM-dd HH:mm:ss.fff zzz} [{Level:u3}] {SourceContext}: {Message:lj} {Properties:j}{NewLine}{Exception}"
        }
      }
    ]
  },
  "B2": {
    "// NOTE": "CAS-019: ConnectionStrings:CachetArchiveSync and B2:SystemKeyId/SystemApplicationKey/BucketName are supplied via environment variables in every environment (see docs/environment-variables.md) — never restore them here.",
    "CrossCheckMaxConcurrency": 8,
    "MaxRetryAttempts": 3,
    "RetryBaseDelayMs": 500,
    "MirrorSyncPageSize": 1000
  },
  "Search": {
    "MaxTermLength": 200
  },
  "Sync": {
    "MaxBatchSize": 100
  }
}
