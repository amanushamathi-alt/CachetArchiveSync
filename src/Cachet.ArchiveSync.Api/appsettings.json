{
  "Logging": {
    "LogLevel": {
      "Default": "Information",
      "Microsoft.AspNetCore": "Warning"
    }
  },
  "AllowedHosts": "*",
  "Worker": {
    "ResumeMaxAgeHours": 24
  },
  "Auth": {
    "CookieName": "CachetAuth",
    "SlidingExpirationHours": 8,
    "DataProtection": {
      "KeyRingPath": "../.dataprotection-keys"
    }
  },
  "Files": {
    "Preview": {
      "PdfMaxBytes": 52428800,
      "TextMaxBytes": 2097152,
      "OfficeMaxBytes": 20971520,
      "MaxSheets": 20,
      "MaxRowsPerSheet": 1000,
      "MaxColumns": 50,
      "MaxHtmlBytes": 5242880,
      "MaxUncompressedBytes": 209715200,
      "MaxCompressionRatio": 100,
      "TimeoutSeconds": 30,
      "MaxConcurrentConversions": 2
    }
  }
}
