@* CAS-040 §8.3/§8.4: File Viewer pop-up — a read-only rendering of one archive file plus a
   Download link for the unaltered original. Hosted by KeywordSearch.razor,
   ODriveSyncContentScan.razor and QuarantineQueueModal.razor; open while FileIndexId is not null.
   Metadata comes from Api GET files/{id}?context= through the existing cookie-forwarding
   "CachetApi" client. The preview iframe and the Download link point at Web's own /files/{id}/view
   and /download pass-through endpoints (Program.cs, §8.5) — plain browser navigations, so no file
   bytes ever cross the SignalR circuit and no IJSRuntime download/stream call is made (SC-16). *@
@using System.Globalization
@using Cachet.ArchiveSync.Core.Dtos

@if (FileIndexId is not null)
{
    <div class="cachet-modal-backdrop cachet-fv-backdrop">
        <div class="cachet-modal cachet-fv-modal"
             role="dialog"
             aria-modal="true"
             aria-labelledby="cachet-fv-title"
             @onkeydown="HandleKeyDownAsync">
            <div class="cachet-modal-header">
                <div class="cachet-fv-heading">
                    <h2 id="cachet-fv-title">@(metadata?.Name ?? "File Viewer")</h2>
                    @if (metadata is not null)
                    {
                        <span class="cachet-fv-meta">
                            @metadata.SizeBytes.ToString("N0", CultureInfo.InvariantCulture) bytes ·
                            Modified @FormatModified(metadata.ModifiedAt) ·
                            @SourceLabel(metadata.Source)
                        </span>
                    }
                </div>
                <button type="button" class="cachet-fv-close" aria-label="Close File Viewer" @onclick="CloseAsync">×</button>
            </div>

            @if (sessionExpired)
            {
                @* §8.3 point 6: the existing session-expired banner pattern. *@
                <div class="cachet-banner cachet-banner-error cachet-fv-error-banner">
                    @SessionExpiredMessage <a href="login">Sign in</a>
                </div>
            }

            @if (metadata is not null)
            {
                @if (metadata.PreviewTruncated)
                {
                    <div class="cachet-banner cachet-banner-notice cachet-fv-truncated-banner">@TruncatedMessage</div>
                }

                @if (metadata.ViewMode == FileViewModes.HtmlPreview)
                {
                    <div class="cachet-banner cachet-banner-notice cachet-fv-fidelity-banner">@HtmlPreviewMessage</div>
                }
                else if (metadata.ViewMode == FileViewModes.ExtractedText)
                {
                    <div class="cachet-banner cachet-banner-notice cachet-fv-text-only-banner">@ExtractedTextMessage</div>
                }
            }

            <div class="cachet-modal-body cachet-fv-body" aria-busy="@(isLoading ? "true" : "false")">
                @if (isLoading)
                {
                    <p class="cachet-modal-empty" aria-live="polite">Loading…</p>
                }
                else if (errorMessage is not null)
                {
                    <p class="cachet-modal-empty cachet-fv-error">@errorMessage</p>
                    @if (offerDownloadOnError)
                    {
                        <p class="cachet-modal-empty cachet-fv-download-hint"><strong>@DownloadHintMessage</strong></p>
                    }
                }
                else if (metadata is not null)
                {
                    @switch (metadata.ViewMode)
                    {
                        case FileViewModes.InlinePdf:
                            @* §8.1: no sandbox attribute — Chromium refuses to render PDFs in sandboxed frames. *@
                            <iframe class="cachet-fv-frame" src="@ViewUrl" title="@FrameTitle"></iframe>
                            break;
                        case FileViewModes.InlineText:
                        case FileViewModes.ExtractedText:
                        case FileViewModes.HtmlPreview:
                            <iframe class="cachet-fv-frame" src="@ViewUrl" title="@FrameTitle" sandbox=""></iframe>
                            break;
                        default:
                            <p class="cachet-modal-empty cachet-fv-download-only">@DownloadOnlyMessage(metadata)</p>
                            <p class="cachet-modal-empty cachet-fv-download-hint"><strong>@DownloadHintMessage</strong></p>
                            break;
                    }
                }
            </div>

            <div class="cachet-modal-footer cachet-fv-footer">
                @if (metadata is not null || offerDownloadOnError)
                {
                    <a class="cachet-btn cachet-fv-download" href="@DownloadUrl" download>Download</a>
                }
                <button type="button" class="cachet-btn cachet-fv-close-btn" @ref="closeButton" @onclick="CloseAsync">Close</button>
            </div>
        </div>
    </div>
}

@code {
    // §8.3 copy.
    private const string NotFoundMessage = "This file could not be found in the local mirror.";
    private const string GoneMessage = "This file is no longer in the archive.";
    private const string UnsupportedMessage = "This file type can't be opened here.";
    private const string DownloadHintMessage =
        "You can download the file and open it locally by clicking the Download button below.";
    private const string GenericErrorMessage = "The file could not be opened. See the Audit Log or contact support.";
    private const string HtmlPreviewMessage =
        "Read-only preview. Images, headers/footers, comments and tracked changes are not shown.";
    private const string ExtractedTextMessage = "Text-only preview of a legacy Word (.doc) file.";
    // Same text as KeywordSearch.razor's SessionExpiredMessage — duplicated locally, as ReportModal
    // already does (no shared constant exists, P4).
    private const string SessionExpiredMessage = "Your session has expired — sign in again to see results.";

    // §8.1/§8.3 "limit N MB" / "first N MB": the §9 Files:Preview defaults. Web has no config for
    // these (§9 — Web reuses Api:BaseUrl only) and the §6.1 metadata contract does not carry them.
    private const int PdfPreviewLimitMb = 50;
    private const int OfficePreviewLimitMb = 20;
    private const int TextPreviewLimitMb = 2;

    /// <summary>The file to show; the modal is open while this is not null.</summary>
    [Parameter] public int? FileIndexId { get; set; }

    /// <summary><c>KeywordSearch</c>, <c>ODriveSync</c>, <c>Quarantine</c> or <c>FileBrowser</c> (CAS-044) — forwarded unchanged.</summary>
    [Parameter] public string Context { get; set; } = string.Empty;

    [Parameter] public EventCallback OnClose { get; set; }

    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] private ILogger<FileViewerModal> Logger { get; set; } = default!;

    private ElementReference closeButton;
    private bool focusPending;

    // Guards against a superseded load overwriting the current state.
    private int loadGeneration;
    private int? loadedFileIndexId;
    private string? loadedContext;

    private bool isLoading;
    private FileMetadataResponse? metadata;
    private string? errorMessage;
    private bool sessionExpired;

    // The file exists but could not be opened here (unsupported type or a load error), so the
    // Download button is still offered. Not set for 401/404/410, where a download cannot succeed.
    private bool offerDownloadOnError;

    private string EncodedContext => Uri.EscapeDataString(Context ?? string.Empty);

    private string ViewUrl => $"files/{FileIndexId}/view?context={EncodedContext}";

    private string DownloadUrl => $"files/{FileIndexId}/download?context={EncodedContext}";

    private string FrameTitle => $"Preview of {metadata?.Name}";

    private static string TruncatedMessage =>
        $"Showing the first {TextPreviewLimitMb} MB. Download the file for the full content.";

    protected override async Task OnParametersSetAsync()
    {
        if (FileIndexId == loadedFileIndexId && string.Equals(Context, loadedContext, StringComparison.Ordinal))
        {
            return;
        }

        loadedFileIndexId = FileIndexId;
        loadedContext = Context;
        var generation = ++loadGeneration;

        // §8.3 point 7: closing (FileIndexId -> null) drops all state and removes the iframe, which
        // ends any in-flight stream; reopening issues fresh requests.
        metadata = null;
        errorMessage = null;
        sessionExpired = false;
        offerDownloadOnError = false;
        isLoading = false;

        if (FileIndexId is null)
        {
            return;
        }

        isLoading = true;
        focusPending = true;
        await LoadMetadataAsync(FileIndexId.Value, generation);
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (focusPending && FileIndexId is not null)
        {
            focusPending = false;
            // §8.4: focus moves to Close on open.
            try
            {
                await closeButton.FocusAsync();
            }
            catch (Exception ex) when (ex is JSException or JSDisconnectedException)
            {
                // Circuit gone — nothing to focus.
            }
        }
    }

    private async Task LoadMetadataAsync(int fileIndexId, int generation)
    {
        const string endpoint = "GET /files/{fileIndexId}";
        var client = HttpClientFactory.CreateClient("CachetApi");
        try
        {
            using var response = await client.GetAsync($"files/{fileIndexId}?context={EncodedContext}");
            if (generation != loadGeneration)
            {
                return;
            }

            if (response.IsSuccessStatusCode)
            {
                var body = await response.Content.ReadFromJsonAsync<FileMetadataResponse>();
                if (generation != loadGeneration)
                {
                    return;
                }

                if (body is null)
                {
                    errorMessage = GenericErrorMessage;
                    offerDownloadOnError = true;
                }
                else
                {
                    metadata = body;
                }
            }
            else
            {
                Logger.LogWarning("FileViewerModal: unexpected {StatusCode} from {Endpoint}", (int)response.StatusCode, endpoint);
                switch (response.StatusCode)
                {
                    case System.Net.HttpStatusCode.Unauthorized:
                        sessionExpired = true;
                        break;
                    case System.Net.HttpStatusCode.NotFound:
                        errorMessage = NotFoundMessage;
                        break;
                    case System.Net.HttpStatusCode.Gone:
                        errorMessage = GoneMessage;
                        break;
                    case System.Net.HttpStatusCode.UnsupportedMediaType:
                        errorMessage = UnsupportedMessage;
                        offerDownloadOnError = true;
                        break;
                    default:
                        errorMessage = GenericErrorMessage;
                        offerDownloadOnError = true;
                        break;
                }
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "FileViewerModal: unable to reach Api for {Endpoint}", endpoint);
            if (generation == loadGeneration)
            {
                errorMessage = GenericErrorMessage;
                offerDownloadOnError = true;
            }
        }
        catch (System.Text.Json.JsonException)
        {
            // Malformed 200 body — the response body is never logged.
            if (generation == loadGeneration)
            {
                errorMessage = GenericErrorMessage;
                offerDownloadOnError = true;
            }
        }
        finally
        {
            if (generation == loadGeneration)
            {
                isLoading = false;
            }
        }
    }

    private async Task HandleKeyDownAsync(KeyboardEventArgs e)
    {
        // §8.3 point 5: Esc closes the modal.
        if (string.Equals(e.Key, "Escape", StringComparison.Ordinal))
        {
            await CloseAsync();
        }
    }

    private Task CloseAsync() => OnClose.InvokeAsync();

    private static string DownloadOnlyMessage(FileMetadataResponse file) => file.DownloadOnlyReason switch
    {
        "TooLarge" =>
            $"This file is too large to preview (limit {(file.Extension == "pdf" ? PdfPreviewLimitMb : OfficePreviewLimitMb)} MB). Download it to view.",
        "SignatureMismatch" =>
            $"This file's content does not match its .{file.Extension} type, so it can't be previewed safely. You can still download it.",
        _ => "A preview is not available for this file. You can still download it."
    };

    private static string SourceLabel(string source) =>
        string.Equals(source, "B2", StringComparison.Ordinal) ? "B2 mirror" : "O-Drive mirror";

    // Shown exactly as read from the database: no time-zone conversion and no zone label.
    private static string FormatModified(DateTimeOffset value) =>
        value.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture);
}
