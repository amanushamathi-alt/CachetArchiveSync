@* CAS-031 §3/§8: shared Audit Log modal — read-only, paginated view of GET /audit-log (CAS-009 §6,
   FR-23/FR-24), filterable by Tab/Module and a UTC From/To date range. Same non-routed, @ref-opened
   convention as QuarantineQueueModal.razor (CAS-024) — opened from the per-page Audit Log toolbar
   button on KeywordSearch.razor and ODriveSyncContentScan.razor. Issues only GET requests (SC-9);
   every cell uses Razor's default encoding, never raw markup (§7 V5). *@
@using System.Globalization
@using Cachet.ArchiveSync.Core.Dtos

@if (isOpen)
{
    <div class="cachet-modal-backdrop">
        <div class="cachet-modal cachet-al-modal" role="dialog" aria-modal="true" aria-labelledby="cachet-al-title">
            <div class="cachet-modal-header">
                <h2 id="cachet-al-title">Audit Log</h2>
                <button type="button" class="cachet-al-close" aria-label="Close Audit Log" @onclick="Close">×</button>
            </div>

            @* §8.2: filter bar — changes take effect only on Apply. *@
            <div class="cachet-al-filters">
                <select class="cachet-al-tab-select"
                        aria-label="Filter by tab"
                        disabled="@isLoading"
                        @bind="selectedTab">
                    @foreach (var option in TabOptions)
                    {
                        <option value="@option">@option</option>
                    }
                </select>

                <label class="cachet-al-date-label">
                    From
                    <input type="date" id="cachet-al-date-from" class="cachet-al-date-from" disabled="@isLoading" @bind="dateFrom" />
                </label>

                <label class="cachet-al-date-label">
                    To
                    <input type="date" id="cachet-al-date-to" class="cachet-al-date-to" disabled="@isLoading" @bind="dateTo" />
                </label>

                <button type="button"
                        class="cachet-btn-primary cachet-al-apply"
                        disabled="@(isLoading || !IsRangeValid)"
                        @onclick="ApplyAsync">
                    Apply
                </button>
                <button type="button"
                        class="cachet-btn cachet-al-clear"
                        disabled="@isLoading"
                        @onclick="ClearAsync">
                    Clear
                </button>
            </div>

            @if (!IsRangeValid)
            {
                <div class="cachet-cell-error cachet-al-range-error">‘To’ date must be on or after ‘From’ date.</div>
            }

            <p class="cachet-al-caption">Times and dates are shown in UTC.</p>

            @if (errorBanner is not null)
            {
                <div class="cachet-banner cachet-banner-error cachet-al-error-banner">@errorBanner</div>
            }

            <div class="cachet-modal-body">
                @if (isLoading)
                {
                    <p class="cachet-modal-empty">Loading…</p>
                }
                else if (items.Count == 0 && errorBanner is null)
                {
                    <p class="cachet-modal-empty cachet-al-empty">No audit log entries match the selected filters.</p>
                }
                else if (items.Count > 0)
                {
                    <table class="cachet-grid-table cachet-al-table">
                        <thead>
                            <tr>
                                <th>Timestamp (UTC)</th>
                                <th>User</th>
                                <th>Tab/Module</th>
                                <th>Action</th>
                                <th>File/Path</th>
                                <th>Result/Detail</th>
                            </tr>
                        </thead>
                        <tbody>
                            @* §8.3: server order (newest first) — never re-sorted on the client. *@
                            @foreach (var item in items)
                            {
                                var isFailure = string.Equals(item.Result, "Failure", StringComparison.Ordinal);
                                <tr>
                                    <td class="cachet-al-timestamp">@item.Timestamp.UtcDateTime.ToString("yyyy-MM-dd HH:mm:ss", CultureInfo.InvariantCulture)</td>
                                    <td>@item.User</td>
                                    <td>@item.Tab</td>
                                    <td>@item.Action</td>
                                    <td>
                                        @if (item.FilePath is null)
                                        {
                                            <span>—</span>
                                        }
                                        else
                                        {
                                            <span class="cachet-cell-path cachet-al-path" title="@item.FilePath">@item.FilePath</span>
                                        }
                                    </td>
                                    <td>
                                        <span class="@ResultChipClass(item.Result)">@item.Result</span>
                                        @if (item.ResultDetail is not null)
                                        {
                                            <div class="@(isFailure ? "cachet-cell-error cachet-al-detail" : "cachet-al-detail cachet-al-detail-muted")">@item.ResultDetail</div>
                                        }
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @* §8.4: pager — shown only when totalCount > 0. *@
            @if (totalCount > 0)
            {
                <div class="cachet-al-pager">
                    <span class="cachet-al-pager-text">Showing @((page - 1) * PageSize + 1)–@(Math.Min(page * PageSize, totalCount)) of @totalCount</span>
                    <button type="button"
                            class="cachet-btn cachet-al-prev"
                            disabled="@(isLoading || page <= 1)"
                            @onclick="PreviousAsync">
                        Previous
                    </button>
                    <button type="button"
                            class="cachet-btn cachet-al-next"
                            disabled="@(isLoading || page * PageSize >= totalCount)"
                            @onclick="NextAsync">
                        Next
                    </button>
                </div>
            }

            <div class="cachet-modal-footer">
                <button type="button" class="cachet-btn cachet-al-close-btn" @onclick="Close">Close</button>
            </div>
        </div>
    </div>
}

@code {
    private const string LoadErrorMessage = "Unable to load the audit log. Please try again.";
    private const string AllTabs = "All";

    // §9: fixed page size — a code constant, not configuration (UI/UX §6.1, CAS-009 default).
    private const int PageSize = 50;

    // §7 V2 / §0 point 2: exactly these values, in this order.
    private static readonly string[] TabOptions =
    {
        AllTabs, "Auth", "Keyword Search", "O-Drive Sync", "Quarantine", "Task Manager", "Reports"
    };

    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] private ILogger<AuditLogModal> Logger { get; set; } = default!;

    private bool isOpen;
    private bool isLoading;
    private string? errorBanner;

    // Filter-bar edits (not yet applied).
    private string selectedTab = AllTabs;
    private DateOnly? dateFrom;
    private DateOnly? dateTo;

    // §8.4: the filters last sent to the API — the pager reuses these, not unapplied edits.
    private string appliedTab = AllTabs;
    private DateOnly? appliedFrom;
    private DateOnly? appliedTo;

    private int page = 1;
    private int totalCount;
    private IReadOnlyList<AuditLogListItem> items = Array.Empty<AuditLogListItem>();

    // §7 V1: To must be on or after From when both are set.
    private bool IsRangeValid => dateFrom is null || dateTo is null || dateTo.Value >= dateFrom.Value;

    /// <summary>Opens the modal with default filters and loads page 1 (§8.1). Invoked by a host page
    /// via <c>@ref</c> — this component is not a routed page.</summary>
    public async Task OpenAsync()
    {
        isOpen = true;
        ResetFilters();
        appliedTab = AllTabs;
        appliedFrom = null;
        appliedTo = null;
        await LoadAsync(1);
        StateHasChanged();
    }

    private void Close()
    {
        isOpen = false;
    }

    private void ResetFilters()
    {
        selectedTab = AllTabs;
        dateFrom = null;
        dateTo = null;
    }

    // §8.2 Apply / §7 V3: fetch page 1 with the current filter-bar values.
    private async Task ApplyAsync()
    {
        if (isLoading || !IsRangeValid)
        {
            // §7 V1: invalid range sends no request.
            return;
        }

        appliedTab = selectedTab;
        appliedFrom = dateFrom;
        appliedTo = dateTo;
        await LoadAsync(1);
    }

    // §8.2 Clear / §7 V3: reset to defaults and fetch page 1.
    private async Task ClearAsync()
    {
        if (isLoading)
        {
            return;
        }

        ResetFilters();
        await ApplyAsync();
    }

    private async Task PreviousAsync()
    {
        if (isLoading || page <= 1)
        {
            return;
        }

        await LoadAsync(page - 1);
    }

    private async Task NextAsync()
    {
        if (isLoading || page * PageSize >= totalCount)
        {
            return;
        }

        await LoadAsync(page + 1);
    }

    private async Task LoadAsync(int targetPage)
    {
        isLoading = true;
        errorBanner = null;
        StateHasChanged();

        var tab = appliedTab == AllTabs ? null : appliedTab;
        var url = BuildUrl(tab, appliedFrom, appliedTo, targetPage);

        var client = HttpClientFactory.CreateClient("CachetApi");
        HttpResponseMessage response;
        try
        {
            response = await client.GetAsync(url);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "AuditLogModal: load failed, Status={StatusCode}", (int?)null);
            SetLoadFailure();
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            Logger.LogWarning("AuditLogModal: load failed, Status={StatusCode}", (int?)response.StatusCode);
            SetLoadFailure();
            return;
        }

        var body = await response.Content.ReadFromJsonAsync<PagedResult<AuditLogListItem>>();
        items = body?.Items ?? Array.Empty<AuditLogListItem>();
        totalCount = body?.TotalCount ?? 0;
        page = targetPage;
        isLoading = false;

        // §11: counts, page and tab name only — never row contents.
        Logger.LogInformation(
            "AuditLogModal: loaded page {Page}, Tab={Tab}, HasDateFrom={HasDateFrom}, HasDateTo={HasDateTo}, Returned={ReturnedCount}, Total={TotalCount}",
            page, tab ?? AllTabs, appliedFrom is not null, appliedTo is not null, items.Count, totalCount);
    }

    // §8.5: stale rows are never shown under a failed load.
    private void SetLoadFailure()
    {
        errorBanner = LoadErrorMessage;
        items = Array.Empty<AuditLogListItem>();
        totalCount = 0;
        isLoading = false;
    }

    // §6: tab only when not All (URL-encoded); dates as UTC start/end of day so To is fully included.
    private static string BuildUrl(string? tab, DateOnly? from, DateOnly? to, int targetPage)
    {
        var query = new List<string>();
        if (tab is not null)
        {
            query.Add($"tab={Uri.EscapeDataString(tab)}");
        }

        if (from is not null)
        {
            query.Add($"dateFrom={from.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}T00:00:00Z");
        }

        if (to is not null)
        {
            query.Add($"dateTo={to.Value.ToString("yyyy-MM-dd", CultureInfo.InvariantCulture)}T23:59:59.9999999Z");
        }

        query.Add($"page={targetPage.ToString(CultureInfo.InvariantCulture)}");
        query.Add($"pageSize={PageSize.ToString(CultureInfo.InvariantCulture)}");
        return "audit-log?" + string.Join("&", query);
    }

    // §8.3: Success → green, Failure → red, anything else → neutral (defensive).
    private static string ResultChipClass(string? result) => result switch
    {
        "Success" => "cachet-chip cachet-chip-success cachet-al-chip",
        "Failure" => "cachet-chip cachet-chip-flagged cachet-al-chip",
        _ => "cachet-chip cachet-chip-neutral cachet-al-chip"
    };
}
