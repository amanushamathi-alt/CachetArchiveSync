@* CAS-052 §2.1/§2.2: shared Quarantine pager (page-size 25/50, Previous / Next, "Page x of y",
   range text "1–25 of 137"). Presentation only — the parent owns Page/PageSize/TotalCount and
   re-fetches in the callbacks. Always rendered (an empty queue shows "Page 1 of 1", never
   "Page 1 of 0"). Distinct from the generic windowed Pager.razor (CAS-045). *@
<nav aria-label="Quarantine pagination" class="cachet-qpager" data-testid="@($"{TestIdPrefix}-pager")">
    <label class="cachet-qpager-size">
        Rows per page
        <select class="cachet-qpager-size-select"
                aria-label="Rows per page"
                data-testid="@($"{TestIdPrefix}-page-size")"
                disabled="@IsLoading"
                value="@PageSize"
                @onchange="OnSizeChangedAsync">
            @foreach (var size in PageSizes)
            {
                <option value="@size" selected="@(size == PageSize)">@size</option>
            }
        </select>
    </label>

    <span class="cachet-qpager-range" data-testid="@($"{TestIdPrefix}-range")">@RangeText</span>

    <button type="button"
            class="cachet-btn cachet-qpager-btn"
            aria-label="Previous page"
            data-testid="@($"{TestIdPrefix}-prev")"
            disabled="@(IsLoading || Page <= 1)"
            @onclick="() => GoToAsync(Page - 1)">‹ Previous</button>
    <span class="cachet-qpager-page" data-testid="@($"{TestIdPrefix}-page-of")">Page @CurrentPage of @LastPage</span>
    <button type="button"
            class="cachet-btn cachet-qpager-btn"
            aria-label="Next page"
            data-testid="@($"{TestIdPrefix}-next")"
            disabled="@(IsLoading || Page >= LastPage)"
            @onclick="() => GoToAsync(Page + 1)">Next ›</button>
</nav>

@code {
    private static readonly int[] PageSizes = { 25, 50 };

    [Parameter] public int Page { get; set; } = 1;
    [Parameter] public int PageSize { get; set; } = 25;
    [Parameter] public int TotalCount { get; set; }
    [Parameter] public bool IsLoading { get; set; }
    /// <summary>Prefix for the data-testid hooks, e.g. "qq" (modal) or "ks-quarantine" (panel).</summary>
    [Parameter] public string TestIdPrefix { get; set; } = "quarantine";
    [Parameter] public EventCallback<int> OnPageChanged { get; set; }
    [Parameter] public EventCallback<int> OnPageSizeChanged { get; set; }

    private int LastPage => PageSize > 0 ? Math.Max(1, (int)Math.Ceiling(TotalCount / (double)PageSize)) : 1;

    private int CurrentPage => Math.Clamp(Page, 1, LastPage);

    private string RangeText
    {
        get
        {
            if (TotalCount <= 0)
            {
                return "0 of 0";
            }

            var first = (CurrentPage - 1) * PageSize + 1;
            var last = Math.Min(TotalCount, CurrentPage * PageSize);
            return $"{first}–{last} of {TotalCount}";
        }
    }

    // §9 V1: page stays within 1..LastPage.
    private async Task GoToAsync(int page)
    {
        var target = Math.Clamp(page, 1, LastPage);
        if (IsLoading || target == Page)
        {
            return;
        }

        await OnPageChanged.InvokeAsync(target);
    }

    // §9 V1: only 25 or 50 are accepted; anything else is ignored.
    private async Task OnSizeChangedAsync(ChangeEventArgs e)
    {
        if (IsLoading
            || !int.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.None,
                System.Globalization.CultureInfo.InvariantCulture, out var size)
            || !PageSizes.Contains(size)
            || size == PageSize)
        {
            return;
        }

        await OnPageSizeChanged.InvokeAsync(size);
    }
}
