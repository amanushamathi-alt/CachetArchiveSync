@inherits LayoutComponentBase

@* Wireframe layout (2.UI-UX/CACHET-Archive Files Search and Sync.html): brand accent bar, navy
   header bar (wordmark | title … user, B2 key badge, Sign Out), white tab strip, the page, and the
   navy footer status bar. The toolbar row (search, Task Manager, Quarantine Queue, Audit Log) and the
   report row belong to each page, because in the wireframe they sit beside page-owned controls and
   this layout is statically rendered (no interactive event handlers can run here). *@

@if (isAuthenticated)
{
    <div class="cachet-app">
        <div class="cachet-brand-bar" aria-hidden="true">
            <span class="cachet-brand-bar-red"></span>
            <span class="cachet-brand-bar-gap"></span>
            <span class="cachet-brand-bar-navy"></span>
        </div>

        <header class="cachet-header-bar">
            <div class="cachet-header-brand">
                <span class="cachet-header-wordmark">CACHET</span>
                <span class="cachet-header-divider" aria-hidden="true"></span>
                <span class="cachet-header-title">Archive Files Search &amp; Sync</span>
            </div>

            <div class="cachet-header-identity">
                @if (displayName is not null)
                {
                    <span class="cachet-header-user">@displayName</span>
                }

                @if (b2AccessLabel is not null)
                {
                    <span class="cachet-badge-pill">B2 Access: @b2AccessLabel</span>
                }

                @* CAS-021 §8.4 / CAS-025 §8.3: a real HTTP POST (not a Blazor event handler) so the
                   browser's session cookie is genuinely cleared via Web's /logout endpoint. *@
                <form method="post" action="logout" class="cachet-sign-out-form">
                    <AntiforgeryToken />
                    <button type="submit" class="cachet-sign-out-btn">Sign Out</button>
                </form>
            </div>
        </header>

        @* CAS-025 §3/§8.1: NavLink's built-in active-route matching drives the red underline.
           Match=All on "" so Keyword Search isn't active as a prefix of every other route. *@
        <nav class="cachet-tabs">
            <NavLink class="cachet-header-tab" href="" Match="NavLinkMatch.All">Keyword Search</NavLink>
            <NavLink class="cachet-header-tab" href="odrive-sync">O-Drive Sync and content Scan</NavLink>
        </nav>

        <main class="cachet-app-body">
            @Body
        </main>

        @* CAS-025 §3/§8.2: wireframe-confirmed empty-state copy only. *@
        <footer class="cachet-footer-bar">Local Cache: not yet populated.</footer>
    </div>
}
else
{
    @* CAS-021 §8.6: the brand accent bar renders on the unauthenticated Sign-In page too; the
       header/tab/footer chrome does not. *@
    <div class="cachet-brand-bar" aria-hidden="true">
        <span class="cachet-brand-bar-red"></span>
        <span class="cachet-brand-bar-gap"></span>
        <span class="cachet-brand-bar-navy"></span>
    </div>

    @Body
}

<div id="blazor-error-ui">
    An unhandled error has occurred.
    <a href="" class="reload">Reload</a>
    <a class="dismiss">🗙</a>
</div>

@code {
    [CascadingParameter]
    private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    private string? b2AccessLabel;
    private string? displayName;
    private bool isAuthenticated;

    protected override async Task OnParametersSetAsync()
    {
        if (AuthenticationStateTask is null)
        {
            return;
        }

        var authState = await AuthenticationStateTask;
        isAuthenticated = authState.User.Identity?.IsAuthenticated == true;
        b2AccessLabel = authState.User.FindFirst("b2_capability")?.Value;
        // CAS-025 §8.1: username-as-stopgap display value (CAS-021 §15).
        displayName = authState.User.Identity?.Name;
    }
}
