    private static string FormatRelativeTime(DateTimeOffset? at)
    {
        if (at is null)
        {
            return "just now";
        }

        var elapsed = DateTimeOffset.UtcNow - at.Value;
        if (elapsed < TimeSpan.FromMinutes(1))
        {
            return "less than a minute";
        }

        if (elapsed < TimeSpan.FromHours(1))
        {
            var minutes = (int)elapsed.TotalMinutes;
            return $"{minutes} minute{(minutes == 1 ? string.Empty : "s")}";
        }

        var hours = (int)elapsed.TotalHours;
        return $"{hours} hour{(hours == 1 ? string.Empty : "s")}";
    }

    private async Task RefreshProgressAsync(HttpClient client, int taskId, CancellationToken ct)
    {
        try
        {
            using var response = await client.GetAsync($"tasks/{taskId}", ct);
            if (!response.IsSuccessStatusCode)
            {
                return;
            }

            var task = await response.Content.ReadFromJsonAsync<TaskDetailResponse>(cancellationToken: ct);
            if (task is null)
            {
                return;
            }

            progressProcessed = task.ItemsProcessed;
            progressTotal = task.ItemsTotal;
            progressStartedAtUtc = task.StartTime;
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            // Progress is advisory — a missed refresh just leaves the previous figures on screen.
            Logger.LogWarning(ex, "KeywordSearch screen: unable to reach Api for {Endpoint}", "GET /tasks/{taskId}");
        }
    }

    private static string FormatElapsed(TimeSpan span)
    {
        if (span < TimeSpan.Zero)
        {
            span = TimeSpan.Zero;
        }

        if (span.TotalHours >= 1)
        {
            return $"{(int)span.TotalHours}h {span.Minutes}m";
        }

        return span.TotalMinutes >= 1 ? $"{(int)span.TotalMinutes}m {span.Seconds}s" : $"{(int)span.TotalSeconds}s";
    }

    // Estimate = measured rate so far, extrapolated; only offered past a minimum sample (EtaMinFractionDone
    // of the items and EtaMinElapsed of running time) so an early, noisy rate is never shown as a prediction.
    private string? ProgressDetailText
    {
        get
        {
            if (progressProcessed is not { } done || progressTotal is not { } total || total <= 0)
            {
                return null;
            }

            var detail = $"{done:N0} of {total:N0} items processed ({100.0 * done / total:0}%).";

            var runningSince = progressStartedAtUtc ?? submittedAtUtc;
            if (runningSince is null || done <= 0 || done >= total)
            {
                return detail;
            }

            var runningFor = DateTimeOffset.UtcNow - runningSince.Value;
            if ((double)done / total < EtaMinFractionDone || runningFor < EtaMinElapsed)
            {
                return detail;
            }

            var remaining = TimeSpan.FromTicks((long)(runningFor.Ticks * ((double)(total - done) / done)));
            return $"{detail} Estimated time remaining: about {FormatElapsed(remaining)}.";
        }
    }

    // CAS-027 §8.3: a deep-linked task has no known submittedAtUtc — this fallback omits the
    // elapsed-time clause rather than showing a broken/blank relative-time string.
    private string ProgressBannerText
    {
        get
        {
            // CAS-057 §2.3: replaces the progress text while a cancel is pending.
            if (isCancelRequested)
            {
                return CancellingBannerText;
            }

            // Filename and Date searches are fast — a plain message, no timer or estimate.
            if (!string.Equals(resultsMode, KeywordMode, StringComparison.Ordinal))
            {
                return "Search in progress. Results will appear here automatically when ready.";
            }

            var text = submittedAtUtc is not null
                ? $"Search in progress — running for {FormatElapsed(DateTimeOffset.UtcNow - submittedAtUtc.Value)}."
                : "Search in progress.";

            if (ProgressDetailText is { } detail)
            {
                text += " " + detail;
            }

            return text + " Results will appear here automatically when ready.";
        }
    }

    public async ValueTask DisposeAsync()
    {
        pollCts?.Cancel();
        pollTimer?.Dispose();
        pollCts?.Dispose();
        await ValueTask.CompletedTask;
    }
}
