    // The Api mode of the selected radio; only meaningful outside Files mode (V3).
    private string CurrentMode => isFilenameMode ? FilenameMode : isDateMode ? DateMode : KeywordMode;

    private string TermPlaceholder => isFilesMode ? FilesModeTermPlaceholder
        : isFilenameMode ? FilenameModeTermPlaceholder
        : KeywordModeTermPlaceholder;

    private bool ShowResultsExplorer =>
        !isFilesMode && !sessionExpired && activeTaskId is not null
        // CAS-057 §2.4/§2.5: a Cancelled task shows its partial results only when it has at least one match.
        && (taskState == "Completed" || (taskState == "Cancelled" && totalMatches > 0))
        && string.Equals(resultsMode, CurrentMode, StringComparison.Ordinal);

    // CAS-057 §2.1: Keyword-mode search in flight with a known task; never in Files mode.
    private bool CanCancelSearch =>
        isSearchInFlight && !isFilesMode && activeTaskId is not null
        && string.Equals(resultsMode, KeywordMode, StringComparison.Ordinal);

    private string ResultsEmptyMessage => resultsMode == DateMode ? NoFilesInDateRangeText : NoFilesMatchedText;

    // CAS-057 §2.5: a Cancelled task without matches leaves the results area as it was before the search.
    private string ResultsPlaceholder =>
        !string.Equals(resultsMode, CurrentMode, StringComparison.Ordinal) || taskState is "None" or "Cancelled" ? ResultsPromptText
        : isSearchInFlight ? "Waiting for results…"
        : "No results to show.";
    private string fromDateText = string.Empty;
    private string toDateText = string.Empty;

    private static DateOnly TodayUtc => DateOnly.FromDateTime(DateTime.UtcNow);

    private static bool TryParseDate(string value, out DateOnly date) =>
        DateOnly.TryParseExact(value, DateFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out date);

    // CAS-039 §9 V6: a non-empty field that does not parse exactly as MM/dd/yyyy.
    private bool DateFormatHintVisible =>
        (fromDateText.Length > 0 && !TryParseDate(fromDateText, out _))
        || (toDateText.Length > 0 && !TryParseDate(toDateText, out _));

    // CAS-039 §9 V8: only evaluable once both dates parse.
    private bool DateOrderHintVisible =>
        TryParseDate(fromDateText, out var from) && TryParseDate(toDateText, out var to) && from > to;

    // CAS-039 §9 V9: either parsed date after today (UTC).
    private bool DateFutureHintVisible =>
        (TryParseDate(fromDateText, out var from) && from > TodayUtc)
        || (TryParseDate(toDateText, out var to) && to > TodayUtc);

    // CAS-039 §2.5/§9 V6–V9 (V7: both required): always satisfied in Keyword mode.
    private bool DateRangeValid =>
        !isDateMode
        || (TryParseDate(fromDateText, out var from)
            && TryParseDate(toDateText, out var to)
            && from <= to
            && to <= TodayUtc);

    // CAS-039 A2 §9 V10: Date mode, blank term, both dates parse, inclusive range over the limit.
    // CAS-039 A3: the term is always empty in Date mode, so V10 always applies there.
    private bool DateOnlyRangeHintVisible =>
        isDateMode
        && string.IsNullOrWhiteSpace(searchTerm)
        && TryParseDate(fromDateText, out var from)
        && TryParseDate(toDateText, out var to)
        && to.DayNumber - from.DayNumber + 1 > MaxDateOnlyRangeDays;

    // CAS-039 A3 §2.6b/§9 V1: Keyword mode requires a valid term; Date mode has no term (always
    // empty, date-only search).
    private bool TermConditionMet => isDateMode || SearchTermValid;

    // CAS-039 §2.5: the existing Search conditions AND (Keyword mode OR V6–V9 satisfied);
    // CAS-039 A2/A3: term condition per mode, AND V10.
    private bool CanSearch =>
        !isFilesMode && TermConditionMet && !isSearchInFlight && !string.IsNullOrWhiteSpace(bucketName) && DateRangeValid
        && !DateOnlyRangeHintVisible;

    // CAS-039 §2.6: context-header suffix for a reloaded task that carries a date range; null (so
    // the header is unchanged) otherwise.
    private string? ReloadedDateRangeSuffix =>
        reloadedSearchParameters is { FromDate: { } from, ToDate: { } to }
            ? $", created {from.ToString(DateFormat, CultureInfo.InvariantCulture)} – {to.ToString(DateFormat, CultureInfo.InvariantCulture)}"
            : null;

    private void SelectFilesMode()
    {
        // CAS-044 V3: the dates are not shown in Files mode, so clear them (a hidden stale date is
        // never sent, CAS-039 SC-5); a typed keyword is kept for when Keyword mode is picked again.
        isFilesMode = true;
        isFilenameMode = false;
        isDateMode = false;
        fromDateText = string.Empty;
        toDateText = string.Empty;
        selectedResultIds.Clear();
    }

    private void SelectFilenameMode()
    {
        // CAS-048 V3: Filename never posts dates, so clear them like Keyword mode does.
        isFilesMode = false;
        isFilenameMode = true;
        isDateMode = false;
        fromDateText = string.Empty;
        toDateText = string.Empty;
        selectedResultIds.Clear();
    }

    private void SelectKeywordMode()
    {
        // CAS-039 §2.4: clear both fields (and so their hints) so a hidden stale date is never sent.
        isFilesMode = false;
        isFilenameMode = false;
        isDateMode = false;
        fromDateText = string.Empty;
        toDateText = string.Empty;
        selectedResultIds.Clear();
    }

    private void SelectDateMode()
    {
        // CAS-039 A3 §2.6b: Date mode is date-only — clear the keyword (its input is not rendered),
        // so switching back to Keyword mode also shows an empty term.
        isFilesMode = false;
        isFilenameMode = false;
        isDateMode = true;
        searchTerm = string.Empty;
        selectedResultIds.Clear();
    }

    // CAS-048 §2.4: a deep link selects the mode of the task it opens.
    private void SelectModeFor(string mode)
    {
        switch (mode)
        {
            case FilenameMode:
                SelectFilenameMode();
                break;
            case DateMode:
                SelectDateMode();
                break;
            default:
                SelectKeywordMode();
                break;
        }
    }

    // CAS-039 §2.3 A1: calendar picker. The native input's value is always ISO yyyy-MM-dd whatever
    // the browser locale; the text field always shows MM/dd/yyyy (InvariantCulture).
    // Opening the picker is browser-side only (js/datepicker.js delegated click listener on the
    // buttons' data-cachet-date-picker-for), so no SignalR round trip can expire showPicker()'s
    // user-activation requirement.
    private const string NativeDateFormat = "yyyy-MM-dd";

    // CAS-039 §2.3 A1: the picker's max is today (UTC).
    private static string TodayIso => TodayUtc.ToString(NativeDateFormat, CultureInfo.InvariantCulture);

    // CAS-039 §2.3 A1: the picker opens on the field's current value, if valid.
    private static string ToNativeValue(string text) =>
        TryParseDate(text, out var date) ? date.ToString(NativeDateFormat, CultureInfo.InvariantCulture) : string.Empty;

    private static readonly RenderFragment CalendarIcon = @<svg class="cachet-ks-date-picker-icon" width="16" height="16" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true" focusable="false"><rect x="3" y="4" width="18" height="18" rx="2" /><line x1="16" y1="2" x2="16" y2="6" /><line x1="8" y1="2" x2="8" y2="6" /><line x1="3" y1="10" x2="21" y2="10" /></svg>;

    // CAS-039 §2.3 A1: a picked ISO date is written into the same field the text input binds to,
    // so V6–V9 and CanSearch recompute exactly as for a typed value. Empty/unparseable: no change.
    private void OnFromPicked(ChangeEventArgs e)
    {
        if (TryParsePicked(e, out var text))
        {
            fromDateText = text;
        }
    }

    private void OnToPicked(ChangeEventArgs e)
    {
        if (TryParsePicked(e, out var text))
        {
            toDateText = text;
        }
    }

    private static bool TryParsePicked(ChangeEventArgs e, out string text)
    {
        if (e.Value is string value
            && DateOnly.TryParseExact(value, NativeDateFormat, CultureInfo.InvariantCulture, DateTimeStyles.None, out var date))
        {
            text = date.ToString(DateFormat, CultureInfo.InvariantCulture);
            return true;
        }

        text = string.Empty;
        return false;
    }

    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // CAS-051 §2.8: same b2_capability claim mechanism as QuarantineQueueModal.
    private bool hasFullAccess;

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            hasFullAccess = string.Equals(
                authState.User.FindFirst("b2_capability")?.Value, "Full Access", StringComparison.Ordinal);
        }

        bucketName = Configuration["B2:BucketName"];
        await LoadQuarantineAsync();
        // CAS-030 §8.2 supersedes CAS-027's deep-link polling: ReloadTaskAsync handles ?taskId=.
        loadedTaskIdParameter = TaskId;
        await ReloadTaskAsync();
    }

    // CAS-048 §2.4: ReloadTaskAsync also runs when ?taskId= changes while the page is open (a Task Manager
    // click while already on "/"). Any running poll is cancelled and the previous task state cleared first.
    protected override async Task OnParametersSetAsync()
    {
        if (string.Equals(TaskId, loadedTaskIdParameter, StringComparison.Ordinal))
        {
            return;
        }

        loadedTaskIdParameter = TaskId;
        ResetTaskState();
        await ReloadTaskAsync();
    }

    private void ResetTaskState()
    {
        pollCts?.Cancel();
        pollTimer?.Dispose();
        isSearchInFlight = false;
        activeTaskId = null;
        submittedAtUtc = null;
        taskState = "None";
        resultsMode = null;
        totalMatches = null;
        selectedResultIds.Clear();
        taskNotice = null;
        failureDetail = null;
        searchErrorBanner = null;
        reloadedSearchParameters = null;
        reloadedSubmittedAtUtc = null;
        ackEligibleTaskId = null;
        showCancelConfirm = false;
        isCancelRequested = false;
    }

    // CAS-030 §8.5: acknowledge only after the finished state has actually been rendered.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ackEligibleTaskId is { } taskId
            && activeTaskId == taskId
            && !isSearchInFlight
            && taskState is "Completed" or "Failed")
        {
            ackEligibleTaskId = null;
            await AcknowledgeAsync(taskId);
        }
    }

    // CAS-030 §8.2 (FR-21): reload the user's latest KeywordSearch task, or the ?taskId= one.
    // Reads stored state only — never POST /search, never a new task, never B2 (SC-7).
    private async Task ReloadTaskAsync()
    {
        var client = HttpClientFactory.CreateClient("CachetApi");
        var isDeepLink = TaskId is not null;
        int taskId;

        if (isDeepLink)
        {
            if (!int.TryParse(TaskId, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out taskId)
                || taskId <= 0)
            {
                taskNotice = TaskNotFoundNotice;
                return;
            }
        }
        else
        {
            using var listResponse = await TryGetAsync(client, $"tasks?type={TaskTypeName}&page=1&pageSize=1", "GET /tasks");
            if (listResponse is null || !listResponse.IsSuccessStatusCode)
            {
                return;
            }

            var list = await listResponse.Content.ReadFromJsonAsync<PagedResult<TaskListItem>>();
            if (list is null || list.Items.Count == 0)
            {
                return;
            }

            taskId = list.Items[0].TaskId;
        }

        using var detailResponse = await TryGetAsync(client, $"tasks/{taskId}", "GET /tasks/{taskId}");
        if (detailResponse is null)
        {
            return;
        }

        TaskDetailResponse? task = null;
        if (detailResponse.IsSuccessStatusCode)
        {
            task = await detailResponse.Content.ReadFromJsonAsync<TaskDetailResponse>();
        }
        else if (detailResponse.StatusCode != System.Net.HttpStatusCode.NotFound)
        {
            Logger.LogWarning("{Component}: unexpected {StatusCode} from {Endpoint}", ScreenName, (int)detailResponse.StatusCode, "GET /tasks/{taskId}");
            return;
        }

        if (task is null || !string.Equals(task.Type, TaskTypeName, StringComparison.Ordinal))
        {
            if (isDeepLink)
            {
                taskNotice = TaskNotFoundNotice;
            }

            return;
        }

        Logger.LogInformation("{Screen}: reloaded task {TaskId} with status {Status}", ScreenName, task.TaskId, task.Status);

        switch (task.Status)
        {
            case "Queued":
            case "Running":
                ApplyReloadedContext(task, isDeepLink);
                PrefillFilterFromRunningTask(task.SearchParameters);
                activeTaskId = task.TaskId;
                submittedAtUtc = task.SubmittedAt;
                isSearchInFlight = true;
                taskState = "InProgress";
                pollCount = 0;
                _ = PollTaskAsync(task.TaskId);
                break;

            case "Completed":
                ApplyReloadedContext(task, isDeepLink);
                await LoadCompletedResultsAsync(client, task.TaskId);
                break;

            case "Failed":
                // A failure the user already dismissed (acknowledged) is not shown again on a plain open.
                if (!isDeepLink && task.IsAcknowledged)
                {
                    break;
                }

                ApplyReloadedContext(task, isDeepLink);
                activeTaskId = task.TaskId;
                taskState = "Failed";
                failureDetail = task.ResultDetail;
                break;

            case "Cancelled":
            {
                // CAS-057 §2.8: with matches -> partial results + notice; none -> unchanged empty state on a
                // plain open, the notice alone on a deep link. A Cancelled task is never acknowledged (§2.9).
                var cancelled = await GetCancelledResultAsync(client, task.TaskId);
                if (cancelled is null || sessionExpired || (TotalMatchesOf(cancelled) is not > 0 && !isDeepLink))
                {
                    break;
                }

                ApplyReloadedContext(task, isDeepLink);
                ackEligibleTaskId = null;
                activeTaskId = task.TaskId;
                taskState = "Cancelled";
                ApplyCancelledResult(cancelled);
                break;
            }

            default:
                break;
        }
    }

    // CAS-057: best-effort fetch of a Cancelled task's totals and counts (page 1, size 1); null when
    // unreadable, so the caller falls back to the plain empty state.
    private async Task<SearchResultsResponse?> GetCancelledResultAsync(HttpClient client, int taskId)
    {
        using var response = await TryGetAsync(client, $"search/{taskId}/results?page=1&pageSize=1", "GET /search/{taskId}/results");
        if (response is null)
        {
            return null;
        }

        if (!response.IsSuccessStatusCode)
        {
            Logger.LogWarning("KeywordSearch screen: unexpected {StatusCode} from {Endpoint}", (int)response.StatusCode, "GET /search/{taskId}/results");
            return null;
        }

        try
        {
            return await response.Content.ReadFromJsonAsync<SearchResultsResponse>();
        }
        catch (System.Text.Json.JsonException)
        {
            Logger.LogWarning("KeywordSearch screen: unreadable body from {Endpoint}", "GET /search/{taskId}/results");
            return null;
        }
    }

    // CAS-057 §2.4/§2.5: match total plus the "Search cancelled ..." notice (checked/total from the result).
    private void ApplyCancelledResult(SearchResultsResponse result)
    {
        totalMatches = TotalMatchesOf(result);
        var matches = totalMatches ?? 0;
        var checkedText = result.ItemsProcessed is { } done && result.ItemsTotal is { } total
            ? $" — {done:N0} of {total:N0} items were checked"
            : string.Empty;

        taskNotice = matches > 0
            ? $"Search cancelled{checkedText}. Showing the {matches:N0} matches found so far; these results are incomplete."
            : $"Search cancelled{checkedText}; no matches were found.";
    }

    private void ApplyReloadedContext(TaskDetailResponse task, bool isDeepLink)
    {
        // CAS-048 V10: only a task the user explicitly opened (a deep link) is acknowledged from here;
        // the silent latest-task reload on a plain open must not clear the badge.
        ackEligibleTaskId = isDeepLink && !task.IsAcknowledged ? task.TaskId : null;
        reloadedSubmittedAtUtc = task.SubmittedAt;
        reloadedSearchParameters = task.SearchParameters;
        resultsMode = ModeOf(task.SearchParameters);

        // CAS-039 A4 (supersedes CAS-030 §8.2 step 3 filter-bar prefill for this screen): the task's
        // term, extension and dates are NOT copied into the filter bar, which keeps its field
        // initialisers (empty term, empty dates, Extension "All") on every open. The task is described
        // by the context header (reloadedSearchParameters) instead.

        // CAS-048 §2.4: a deep link selects the mode from the task; a plain open stays in Files, and the
        // reloaded results appear when that mode is selected.
        if (isDeepLink)
        {
            SelectModeFor(resultsMode);
        }
    }

    // A search still Queued/Running when the page opens (refresh, new tab, deep link) restores the criteria
    // the user submitted - mode, term, extension and dates - so the filter bar keeps describing the running
    // search. Narrows CAS-039 A4's "never prefill" to running tasks only; finished tasks still open with the
    // default filter bar and are described by the context header.
    private void PrefillFilterFromRunningTask(TaskSearchParameters? parameters)
    {
        if (parameters is null)
        {
            return;
        }

        SelectModeFor(ModeOf(parameters));

        if (!isDateMode)
        {
            searchTerm = parameters.Term ?? string.Empty;
        }

        var extension = ExtensionOptions.FirstOrDefault(e => string.Equals(e, parameters.Extension, StringComparison.OrdinalIgnoreCase));
        if (extension is not null)
        {
            selectedExtension = extension;
        }

        if (isDateMode)
        {
            fromDateText = parameters.FromDate?.ToString(DateFormat, CultureInfo.InvariantCulture) ?? string.Empty;
            toDateText = parameters.ToDate?.ToString(DateFormat, CultureInfo.InvariantCulture) ?? string.Empty;
        }
    }

    // CAS-048 §2.3/§2.4: the task's mode; a legacy task (mode null) is Keyword Search, except legacy
    // date-only (blank term with both dates), which is Date Search.
    private static string ModeOf(TaskSearchParameters? parameters) => parameters switch
    {
        { Mode: FilenameMode } => FilenameMode,
        { Mode: KeywordMode } => KeywordMode,
        { Mode: DateMode } => DateMode,
        { Mode: null, FromDate: not null, ToDate: not null } when string.IsNullOrEmpty(parameters.Term) => DateMode,
        _ => KeywordMode
    };

    // CAS-048 §2.2/§2.4: a Completed task needs no search rerun and no result fetch here — the explorer
    // reads stored rows through browse. Only the "M matches in total" figure is requested, best effort.
    private async Task LoadCompletedResultsAsync(HttpClient client, int taskId)
    {
        activeTaskId = taskId;
        taskState = "Completed";
        totalMatches = null;

        using var response = await TryGetAsync(client, $"search/{taskId}/results?page=1&pageSize=1", "GET /search/{taskId}/results");
        if (response is null)
        {
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            Logger.LogWarning("KeywordSearch screen: unexpected {StatusCode} from {Endpoint}", (int)response.StatusCode, "GET /search/{taskId}/results");
            return;
        }

        try
        {
            var result = await response.Content.ReadFromJsonAsync<SearchResultsResponse>();
            totalMatches = TotalMatchesOf(result);
        }
        catch (System.Text.Json.JsonException)
        {
            Logger.LogWarning("KeywordSearch screen: unreadable body from {Endpoint}", "GET /search/{taskId}/results");
        }
    }

    // The status-bar figure: filename plus content totals (a new-mode task only has one kind of row).
    private static int? TotalMatchesOf(SearchResultsResponse? result) =>
        result is null || result.Status is not ("Completed" or "Cancelled")
            ? null
            : (result.FilenameMatches?.TotalCount ?? 0) + (result.ContentMatches?.TotalCount ?? 0);

    /// <summary>
    /// CAS-030 §7 V9/V10 for the reload calls: <c>null</c> on a 401 (sets the session-expired
    /// state) or on a transient network failure (logged); otherwise the response.
    /// </summary>
    private async Task<HttpResponseMessage?> TryGetAsync(HttpClient client, string uri, string endpoint)
    {
        HttpResponseMessage response;
        try
        {
            response = await client.GetAsync(uri);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("{Component}: transient poll failure on {Endpoint}", ScreenName, endpoint);
            return null;
        }

        if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Logger.LogWarning("{Component}: poll stopped on 401 from {Endpoint}", ScreenName, endpoint);
            sessionExpired = true;
            response.Dispose();
            return null;
        }

        return response;
    }

    // Dismiss the failed-search banner: acknowledge the task so it stays hidden on later opens.
    private async Task DismissFailureAsync()
    {
        if (activeTaskId is { } taskId)
        {
            await AcknowledgeAsync(taskId);
        }

        taskState = "None";
        failureDetail = null;
        activeTaskId = null;
        ackEligibleTaskId = null;
        reloadedSearchParameters = null;
        reloadedSubmittedAtUtc = null;
    }

    // CAS-030 §8.5: failures are logged at Warning and never shown; the next open retries.
    private async Task AcknowledgeAsync(int taskId)
    {
        var client = HttpClientFactory.CreateClient("CachetApi");
        try
        {
            using var response = await client.PostAsync($"tasks/{taskId}/acknowledge", content: null);
            if (response.StatusCode != System.Net.HttpStatusCode.NoContent)
            {
                Logger.LogWarning("{Component}: acknowledge of task {TaskId} returned {StatusCode}", ScreenName, taskId, (int)response.StatusCode);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("{Component}: acknowledge of task {TaskId} failed to reach the Api", ScreenName, taskId);
        }
    }

    private async Task LoadQuarantineAsync()
    {
        quarantineErrorBanner = null;
        quarantineLoading = true;
        try
        {
            // CAS-052: an out-of-range page (rows deleted in the modal) clamps to the new last page
            // with one re-request; an empty queue is page 1 of 1.
            for (var attempt = 0; attempt < 2; attempt++)
            {
                if (!await FetchQuarantinePageAsync())
                {
                    return;
                }

                var lastPage = Math.Max(1, (int)Math.Ceiling(quarantineTotalCount / (double)quarantinePageSize));
                if (quarantinePage <= lastPage)
                {
                    break;
                }

                quarantinePage = lastPage;
            }
        }
        finally
        {
            quarantineLoading = false;
        }
    }

    // Returns false when the request failed (banner set).
    private async Task<bool> FetchQuarantinePageAsync()
    {
        var client = HttpClientFactory.CreateClient("CachetApi");
        HttpResponseMessage response;
        try
        {
            response = await client.GetAsync($"quarantine?page={quarantinePage}&pageSize={quarantinePageSize}");
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "KeywordSearch screen: unable to reach Api for {Endpoint}", "GET /quarantine");
            quarantineErrorBanner = GenericErrorMessage;
            return false;
        }

        if (!response.IsSuccessStatusCode)
        {
            Logger.LogWarning("KeywordSearch screen: unexpected {StatusCode} from {Endpoint}", (int)response.StatusCode, "GET /quarantine");
            quarantineErrorBanner = GenericErrorMessage;
            return false;
        }

        var body = await response.Content.ReadFromJsonAsync<QuarantineListResponse>();
        quarantineItems = body?.Items ?? Array.Empty<QuarantineListItem>();
        quarantineTotalCount = body?.TotalCount ?? 0;
        if (quarantineTotalCount == 0)
        {
            quarantinePage = 1;
        }

        return true;
    }

    private async Task GoToQuarantinePageAsync(int target)
    {
        quarantinePage = target;
        await LoadQuarantineAsync();
    }

    private async Task ChangeQuarantinePageSizeAsync(int size)
    {
        quarantinePageSize = size;
        quarantinePage = 1;
        await LoadQuarantineAsync();
    }

