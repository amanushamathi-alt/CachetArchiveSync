@page "/"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "CachetAuthenticated")]
@implements IAsyncDisposable
@using Cachet.ArchiveSync.Core.Dtos
@using Microsoft.Extensions.Options
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization

@* CAS-022 §8.2: InteractiveServer is required here (unlike CAS-021's static-SSR Login.razor) —
   this screen polls its own submitted task and auto-populates the match panels in place over a
   live SignalR circuit, with no cookie being issued and no page navigation involved. *@

@* Bug fix (2026-09-23): explicit [Authorize] here, rather than relying on Program.cs's
   FallbackPolicy, because that FallbackPolicy also applied to ASP.NET Core's own endpoint
   serving _framework/blazor.web.js (no [AllowAnonymous] of its own), redirecting it to /login
   for any unauthenticated request and breaking Blazor's client runtime on the login page itself
   ("Uncaught SyntaxError: Unexpected token '<'" — the script tag received the login page's HTML
   instead of JS). AuthorizeRouteView (Routes.razor, CAS-021 §8.5) enforces this attribute at the
   component level only, so it protects this page without touching unrelated endpoints. *@

<PageTitle>Keyword Search</PageTitle>

@* Wireframe layout: toolbar row (search, Bucket, Extension, Search … Task Manager, Quarantine
   Queue, Audit Log), report row, then the three side-by-side, collapsible panels. *@
<div class="cachet-page">
    <div class="cachet-toolbar @(isFilesMode ? "is-files-mode" : null)">
        @* CAS-039 §2.1/§2.3 (requester's mockup): mode radios directly above the search input, and
           in Date mode the From/To fields below it. CAS-039 A3: the modes are exclusive — the term
           input is rendered (and required) only in Keyword mode; Date mode is date-only.
           CAS-044 §8.1: a third mode, Files (the default), disables every search control. *@
        <div class="cachet-ks-search-group">
            <div class="cachet-ks-mode" role="radiogroup" aria-label="Search mode">
                <label class="cachet-ks-mode-option">
                    <input id="ks-mode-files"
                           type="radio"
                           name="ks-mode"
                           value="files"
                           checked="@isFilesMode"
                           @onchange="SelectFilesMode" />
                    <span>Files</span>
                </label>
                <label class="cachet-ks-mode-option">
                    <input id="ks-mode-filename"
                           type="radio"
                           name="ks-mode"
                           value="filename"
                           checked="@isFilenameMode"
                           @onchange="SelectFilenameMode" />
                    <span>Filename Search</span>
                </label>
                <label class="cachet-ks-mode-option">
                    <input id="ks-mode-keyword"
                           type="radio"
                           name="ks-mode"
                           value="keyword"
                           checked="@(!isFilesMode && !isFilenameMode && !isDateMode)"
                           @onchange="SelectKeywordMode" />
                    <span>Keyword Search</span>
                </label>
                <label class="cachet-ks-mode-option">
                    <input id="ks-mode-date"
                           type="radio"
                           name="ks-mode"
                           value="date"
                           checked="@isDateMode"
                           @onchange="SelectDateMode" />
                    <span>Date Search</span>
                </label>
            </div>

            @* CAS-039 A3 §2.6b: the term input and its V1 hint are not rendered in Date mode.
               CAS-044 V1: in Files mode the input is shown but disabled. *@
            @if (!isDateMode)
            {
                <div class="cachet-toolbar-search">
                    <label for="ks-term" class="cachet-visually-hidden">Search term</label>
                    <input id="ks-term"
                           class="cachet-input"
                           type="text"
                           placeholder="@TermPlaceholder"
                           disabled="@isFilesMode"
                           @bind="searchTerm"
                           @bind:event="oninput" />
                    @* CAS-048 §2.1/V1: Filename and Keyword need a trimmed term of 3-200 characters. *@
                    @if (!isFilesMode && !string.IsNullOrEmpty(searchTerm) && !SearchTermValid)
                    {
                        <span class="cachet-input-hint">@(searchTerm.Trim().Length < MinTermLength ? TermTooShortHint : TermTooLongHint)</span>
                    }
                </div>
            }

            @* CAS-039 §2.2: the date controls are not rendered at all in Keyword mode. *@
            @if (isDateMode)
            {
                <div class="cachet-ks-date-row">
                    <div class="cachet-ks-date-field">
                        <label for="ks-from-date" class="cachet-toolbar-label">From date</label>
                        @* CAS-039 §2.3 A1: text input + calendar button; the hidden native date input
                           is what the browser's picker opens on and reports back through. *@
                        <div class="cachet-ks-date-input-wrap">
                            <input id="ks-from-date"
                                   class="cachet-input cachet-ks-date-input"
                                   type="text"
                                   placeholder="@DateFormat"
                                   inputmode="numeric"
                                   @bind="fromDateText"
                                   @bind:event="oninput" />
                            <button type="button"
                                    id="ks-from-date-picker-btn"
                                    class="cachet-ks-date-picker-btn"
                                    aria-label="Choose From date"
                                    data-cachet-date-picker-for="ks-from-date-native">
                                @CalendarIcon
                            </button>
                            <input id="ks-from-date-native"
                                   class="cachet-ks-date-native"
                                   type="date"
                                   tabindex="-1"
                                   aria-hidden="true"
                                   max="@TodayIso"
                                   value="@ToNativeValue(fromDateText)"
                                   @onchange="OnFromPicked" />
                        </div>
                    </div>
                    <div class="cachet-ks-date-field">
                        <label for="ks-to-date" class="cachet-toolbar-label">To date</label>
                        <div class="cachet-ks-date-input-wrap">
                            <input id="ks-to-date"
                                   class="cachet-input cachet-ks-date-input"
                                   type="text"
                                   placeholder="@DateFormat"
                                   inputmode="numeric"
                                   @bind="toDateText"
                                   @bind:event="oninput" />
                            <button type="button"
                                    id="ks-to-date-picker-btn"
                                    class="cachet-ks-date-picker-btn"
                                    aria-label="Choose To date"
                                    data-cachet-date-picker-for="ks-to-date-native">
                                @CalendarIcon
                            </button>
                            <input id="ks-to-date-native"
                                   class="cachet-ks-date-native"
                                   type="date"
                                   tabindex="-1"
                                   aria-hidden="true"
                                   max="@TodayIso"
                                   value="@ToNativeValue(toDateText)"
                                   @onchange="OnToPicked" />
                        </div>
                    </div>
                </div>

                @* CAS-039 §2.5/§9: one inline hint per failing rule (V7 has no copy of its own).
                   CAS-039 A4: grouped in an out-of-flow wrapper (like app.css's V1 hint) so a hint
                   appearing never lifts the date inputs off the toolbar's shared bottom line. *@
                <div class="cachet-ks-date-hints">
                    @if (DateFormatHintVisible)
                    {
                        <span class="cachet-ks-date-hint cachet-ks-date-hint-format">@DateFormatHint</span>
                    }
                    @if (DateOrderHintVisible)
                    {
                        <span class="cachet-ks-date-hint cachet-ks-date-hint-order">@DateOrderHint</span>
                    }
                    @if (DateFutureHintVisible)
                    {
                        <span class="cachet-ks-date-hint cachet-ks-date-hint-future">@DateFutureHint</span>
                    }
                    @* CAS-039 A2 §9 V10: date-only range limit (CAS-039 A3: always applies in Date mode). *@
                    @if (DateOnlyRangeHintVisible)
                    {
                        <span class="cachet-ks-date-hint cachet-ks-date-hint-range">@DateOnlyRangeHint</span>
                    }
                </div>
            }
        </div>

        @* CAS-039 A4: each inline label + select pair is one bottom-aligned toolbar item, with the
           label vertically centred on its select. *@
        <div class="cachet-ks-inline-field">
            <label for="ks-bucket" class="cachet-toolbar-label">Bucket</label>
            <select id="ks-bucket" class="cachet-select" disabled>
                <option>@(bucketName ?? "(bucket not configured)")</option>
            </select>
        </div>

        <div class="cachet-ks-inline-field">
            <label for="ks-extension" class="cachet-toolbar-label">Extension</label>
            <select id="ks-extension" class="cachet-select" disabled="@isFilesMode" @bind="selectedExtension">
                @foreach (var extension in ExtensionOptions)
                {
                    <option value="@extension">@extension</option>
                }
            </select>
        </div>

        <button type="button"
                class="cachet-btn-primary cachet-ks-search-btn"
                disabled="@(!CanSearch)"
                @onclick="HandleSearchAsync">
            Search
        </button>

        <span class="cachet-toolbar-spacer"></span>

        @* CAS-030 §8.1: Task Manager button + live badge, immediately left of Quarantine Queue. *@
        <TaskManagerBadge />

        @* CAS-024 §3/§8.1: live Quarantine Queue trigger; badge count reuses quarantineItems, already
           loaded for the embedded Quarantine panel below. *@
        @if (hasFullAccess)
        {
            <button type="button"
                    class="cachet-btn cachet-btn-square cachet-ks-quarantine-trigger-btn"
                    @onclick="OpenQuarantineQueueModal">
                Quarantine Queue <span class="cachet-btn-count cachet-btn-count-amber">@quarantineTotalCount</span>
            </button>
        }

        @* CAS-031 §3: live Audit Log trigger (replaces CAS-025 §0's disabled placeholder); no count
           badge (CAS-031 §0 point 3). *@
        <button type="button"
                class="cachet-btn cachet-btn-square cachet-al-trigger-btn"
                @onclick="OpenAuditLogModal">
            Audit Log
        </button>
    </div>

    @* Pre-/Post-Action Report buttons hidden by request. To restore, re-add inside a .cachet-actionbar div:
       <button type="button" class="cachet-btn" @onclick="@(() => OpenReportModal(ReportKind.PreAction))">Pre-Action Report</button>
       <button type="button" class="cachet-btn" @onclick="@(() => OpenReportModal(ReportKind.PostAction))">Post-Action Report</button> *@

    <QuarantineQueueModal @ref="quarantineModal" OnDeleteCompleted="LoadQuarantineAsync" OnClosed="LoadQuarantineAsync" />
    <ReportModal @ref="reportModal" ActiveTabLabel="Keyword Search" />
    <AuditLogModal @ref="auditLogModal" />

    @* CAS-040 §8.2/§8.3: File Viewer for the Filename/Content Matches names (context KeywordSearch)
       and the quarantine panel's names (context Quarantine). *@
    <FileViewerModal FileIndexId="viewerFileIndexId" Context="@viewerContext" OnClose="CloseFileViewerAsync" />

    <div class="cachet-banners">
        @if (toastMessage is not null)
        {
            <div class="cachet-banner cachet-banner-toast cachet-ks-toast">@toastMessage</div>
        }

        @* CAS-030 §7 V7: unknown, non-integer, or wrong-type ?taskId= — filter bar stays usable. *@
        @if (taskNotice is not null)
        {
            <div class="cachet-banner cachet-banner-notice cachet-ks-notice">@taskNotice</div>
        }

        @* CAS-030 §7 V9: a 401 stopped a poll/reload call. *@
        @if (sessionExpired)
        {
            <div class="cachet-banner cachet-banner-error cachet-ks-error-banner">
                @SessionExpiredMessage <a href="login">Sign in</a>
            </div>
        }

        @* A running Keyword search always shows its elapsed-time/progress/estimate banner, in any mode.
           Filename/Date searches get a generic one; Files mode browsing needs no banner. *@
        @if (isSearchInFlight)
        {
            if (CanCancelSearch)
            {
                @* CAS-057 §2.1-§2.3: Keyword-mode bar with a right-aligned Cancel search button (same inline
                   flex layout as the Failed banner), an inline two-step confirm, and a button-less
                   Cancelling state. *@
                <div class="cachet-banner cachet-banner-progress cachet-ks-progress-banner" style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
                    <span>@ProgressBannerText</span>
                    @if (showCancelConfirm)
                    {
                        <span class="cachet-ks-cancel-confirm" style="display:inline-flex;align-items:center;gap:8px;">
                            <span>Stop this search? Matches found so far are kept.</span>
                            <button type="button" class="cachet-btn cachet-ks-cancel-stop" @onclick="CancelSearchAsync">Stop search</button>
                            <button type="button" class="cachet-btn cachet-ks-cancel-keep" @onclick="KeepSearchRunning">Keep running</button>
                        </span>
                    }
                    else if (!isCancelRequested)
                    {
                        <button type="button" class="cachet-btn cachet-ks-cancel-btn" aria-label="Cancel search" @onclick="ShowCancelConfirm">Cancel search</button>
                    }
                </div>
            }
            else if (!isFilesMode || string.Equals(resultsMode, KeywordMode, StringComparison.Ordinal))
            {
                <div class="cachet-banner cachet-banner-progress cachet-ks-progress-banner">@ProgressBannerText</div>
            }
        }
        else if (taskState == "Failed")
        {
            <div class="cachet-banner cachet-banner-error cachet-ks-error-banner" style="display:flex;justify-content:space-between;align-items:center;gap:12px;">
                <span>This search did not complete successfully.@(failureDetail is not null ? $" {failureDetail}" : null)</span>
                <button type="button" class="cachet-btn cachet-ks-error-dismiss" aria-label="Dismiss" title="Dismiss" @onclick="DismissFailureAsync">✕</button>
            </div>
        }

        @if (searchErrorBanner is not null)
        {
            <div class="cachet-banner cachet-banner-error cachet-ks-error-banner">@searchErrorBanner</div>
        }

        @* CAS-030 §8.2 point 3: a reloaded or deep-linked task's results always say which search they belong to.
           CAS-039 A4: reads only reloadedSearchParameters, never the (reset) filter-bar fields. *@
        @* CAS-057 §2.4: a Cancelled task with at least one match gets the same header, worded "partial results". *@
        @if (reloadedSearchParameters is not null && !isSearchInFlight && !sessionExpired
            && (taskState == "Completed" || (taskState == "Cancelled" && totalMatches > 0)))
        {
            var resultsWord = taskState == "Cancelled" ? "partial results" : "results";
            <p class="cachet-context-header cachet-ks-context-header">
                @* CAS-039 A2 §2.6a: a date-only task (blank term, both dates) reads "all files". *@
                @if (string.IsNullOrEmpty(reloadedSearchParameters.Term) && ReloadedDateRangeSuffix is not null)
                {
                    @:Showing @resultsWord for all files (@reloadedSearchParameters.Extension)@ReloadedDateRangeSuffix, submitted @FormatRelativeTime(reloadedSubmittedAtUtc) ago.
                }
                else
                {
                    @:Showing @resultsWord for "@reloadedSearchParameters.Term" (@reloadedSearchParameters.Extension)@ReloadedDateRangeSuffix, submitted @FormatRelativeTime(reloadedSubmittedAtUtc) ago.
                }
            </p>
        }
    </div>

    @* CAS-044 §8.2 / CAS-048 §2.2: Files mode (default) shows the Files explorer. Every other mode shows
       the same explorer over that mode's search results (the Filename/Content Matches panels are gone),
       above the unchanged read-only Quarantine panel. Results belong to the mode that produced them. *@
    @if (isFilesMode)
    {
        <FileExplorer @ref="fileExplorer" OnFileOpened="OpenBrowserFileViewer" OnQuarantineChanged="LoadQuarantineAsync" />
    }
    else
    {
    @* Results explorer on the left, Quarantine panel on the right (side by side; stacks on narrow screens). *@
    <div class="cachet-ks-results-layout">
    <div class="cachet-ks-results-host">
        @if (ShowResultsExplorer)
        {
            @* CAS-051 §2.8: results-mode quarantine writes require Full Access (CAS-050 §2.8). *@
            @if (hasFullAccess)
            {
                <div class="cachet-ks-results-actions">
                    <button type="button"
                            id="ks-send-to-quarantine"
                            class="cachet-btn-bulk"
                            disabled="@(selectedResultIds.Count == 0)"
                            @onclick="SendToQuarantineAsync">
                        Send to Quarantine (@selectedResultIds.Count)
                    </button>
                </div>
            }
            <FileExplorer @key="activeTaskId"
                          @ref="fileExplorer"
                          ResultsTaskId="activeTaskId"
                          Selectable="@hasFullAccess"
                          SelectedIds="selectedResultIds"
                          OnSelectionChanged="OnResultSelectionChanged"
                          OnFileOpened="OpenResultFileViewer"
                          ResultsEmptyMessage="@ResultsEmptyMessage"
                          TotalMatches="totalMatches" />
        }
        else
        {
            <p class="cachet-panel-empty cachet-ks-results-prompt">@ResultsPlaceholder</p>
        }
    </div>

    @* Quarantine is a Full Access feature and is shown only alongside displayed results. *@
    @if (hasFullAccess && ShowResultsExplorer)
    {
    <div class="cachet-panels cachet-ks-quarantine-row">
        @* CAS-022 §8.5: read-only embedded view — the permanent-delete action lives in the Quarantine
           Queue modal (UI/UX Spec §3), so this panel has no row checkboxes or bulk actions. Quarantine
           is Keyword Search-only (BRD §12.1), hence the fixed Source Tab value. *@
        <section class="cachet-panel cachet-ks-panel cachet-ks-quarantine-panel @(collapsedPanels.Contains(QuarantinePanel) ? "is-collapsed" : null)">
            <div class="cachet-panel-header">
                <div class="cachet-panel-heading">
                    <button type="button" class="cachet-panel-toggle" aria-label="Collapse or expand Quarantine" @onclick="() => ToggleCollapsed(QuarantinePanel)">@CollapseIcon(QuarantinePanel)</button>
                    <h2>Quarantine<span class="cachet-panel-count">@quarantineTotalCount</span></h2>
                </div>
            </div>

            <div class="cachet-panel-body">
                @if (quarantineErrorBanner is not null)
                {
                    <div class="cachet-banners"><div class="cachet-banner cachet-banner-error cachet-ks-error-banner">@quarantineErrorBanner</div></div>
                }
                else if (quarantineItems.Count == 0)
                {
                    <p class="cachet-panel-empty">
                        Quarantine is empty. Files sent to quarantine from Keyword Search or the Files browser
                        appear here for final review before permanent deletion.
                    </p>
                }
                else
                {
                    <table class="cachet-grid-table">
                        <thead>
                            <tr>
                                <th>Name / Path</th>
                                <th class="cachet-col-a">Source Tab</th>
                                <th class="cachet-col-b">Quarantined On</th>
                                <th class="cachet-col-status">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in quarantineItems)
                            {
                                <tr>
                                    <td>
                                        <button type="button" class="cachet-cell-name cachet-file-link" title="Open @item.Name" @ref="fileLinkRefs[FileLinkKey(QuarantinePanel, item.FileId)]" @onclick="@(() => OpenFileViewer(item.FileIndexId, QuarantineContext, FileLinkKey(QuarantinePanel, item.FileId)))">@item.Name</button>
                                        <span class="cachet-cell-path" title="@item.Path">@item.Path</span>
                                    </td>
                                    <td class="cachet-ks-quarantine-source-tab">@item.SourceTab</td>
                                    <td>@item.QuarantinedOn</td>
                                    <td><span class="@ChipClass(item.Status)">@item.Status</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }

                @* CAS-052 §2.2: panel paging, independent of the modal's own page state. *@
                @if (quarantineErrorBanner is null)
                {
                    <QuarantinePager Page="quarantinePage"
                                     PageSize="quarantinePageSize"
                                     TotalCount="quarantineTotalCount"
                                     IsLoading="quarantineLoading"
                                     TestIdPrefix="ks-quarantine"
                                     OnPageChanged="GoToQuarantinePageAsync"
                                     OnPageSizeChanged="ChangeQuarantinePageSizeAsync" />
                }
            </div>
        </section>
    </div>
    }
    </div>
    }
</div>

@code {
    // CAS-022 §8.1/FR-04: fixed superset per the BRD, not the original wireframe's shorter list.
    private static readonly string[] ExtensionOptions = { "All", "PDF", "DOC", "DOCX", "XLS", "XLSX", "TXT" };

    private const string GenericErrorMessage = "Something went wrong. Please try again.";

    // CAS-030 §7 V7/V9, §8.2.
    private const string ScreenName = "KeywordSearch";
    private const string TaskTypeName = "KeywordSearch";
    private const string TaskNotFoundNotice = "That task could not be found.";
    private const string SessionExpiredMessage = "Your session has expired — sign in again to see results.";

    // CAS-039 §2.3/§9 V6–V9: display/parse format (InvariantCulture) and inline hint copy.
    private const string DateFormat = "MM/dd/yyyy";
    private const string DateFormatHint = "Enter a date as MM/dd/yyyy.";
    private const string DateOrderHint = "From date must be on or before To date.";
    private const string DateFutureHint = "Dates cannot be in the future.";

    // CAS-039 A2 §2.6a/§9 V10: date-only search — max inclusive range and hint. CAS-039 A3: the term
    // input exists only in Keyword mode, so only the original placeholder remains.
    private const int MaxDateOnlyRangeDays = 31;
    private const string DateOnlyRangeHint = "Without a keyword, the date range can be at most 31 days.";
    private const string FilesModeTermPlaceholder = "Global search - filename or path…";

    // CAS-048 §2.1/V1: per-mode term rules and copy (placeholders per §14 Q2's proposed text).
    private const int MinTermLength = 3;
    private const int MaxTermLength = 200;
    private const string FilenameModeTermPlaceholder = "Filename contains (min 3 characters)…";
    private const string KeywordModeTermPlaceholder = "Text to find inside files…";
    private const string TermTooShortHint = "Enter at least 3 characters";
    private const string TermTooLongHint = "Search term must be at most 200 characters.";
    private const string ResultsPromptText = "Enter a search…";
    private const string NoFilesMatchedText = "No files matched.";
    private const string NoFilesInDateRangeText = "No files in that date range.";

    // CAS-048 §2.2: the Api's mode values (CAS-047 §2).
    private const string FilenameMode = "Filename";
    private const string KeywordMode = "Keyword";
    private const string DateMode = "Date";

    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] private IConfiguration Configuration { get; set; } = default!;
    [Inject] private ILogger<KeywordSearch> Logger { get; set; } = default!;
    [Inject] private IOptions<TaskPollingOptions> PollingOptions { get; set; } = default!;

    // CAS-030 §8.2 deep link. Bound as a string (the spec shows int?) so that a non-integer value
    // reaches V7's "not found" notice instead of failing Blazor's query-string binding.
    [SupplyParameterFromQuery(Name = "taskId")]
    public string? TaskId { get; set; }

    // CAS-030 §8.2/§8.5/V7/V9 state.
    private string? taskNotice;
    private bool sessionExpired;
    private string? failureDetail;
    private TaskSearchParameters? reloadedSearchParameters;
    private DateTimeOffset? reloadedSubmittedAtUtc;
    // §8.5: set only for a task resolved through GET /tasks[/{taskId}] with isAcknowledged=false;
    // cleared once the acknowledge is sent, so it is sent at most once per component instance.
    private int? ackEligibleTaskId;

    // CAS-022 §8.1: read-only, single-value dropdown (BLOCKED note, see implementer report — no
    // §6 endpoint and no §9 config key exist to source this value; read directly from Web's own
    // IConfiguration under the same "B2:BucketName" key Api uses, which requires that key to also
    // be supplied to the Web process at deploy time; not registered here since no code change to
    // configuration loading is needed for that to work once/if the env var is present for Web too).
    private string? bucketName;

    private string searchTerm = string.Empty;
    private string selectedExtension = "All";

    private bool isSearchInFlight;
    private int? activeTaskId;
    private DateTimeOffset? submittedAtUtc;

    // CAS-029 measured progress for the running task (from GET /tasks/{id}); null until the Worker reports.
    private int? progressProcessed;
    private int? progressTotal;
    private DateTimeOffset? progressStartedAtUtc;

    // The remaining-time estimate is shown only once the sample is large enough to be realistic.
    private const double EtaMinFractionDone = 0.05;
    private static readonly TimeSpan EtaMinElapsed = TimeSpan.FromMinutes(2);

    private int pollCount;
    private PeriodicTimer? pollTimer;
    private CancellationTokenSource? pollCts;

    // None | InProgress | Completed | Failed | Cancelled
    private string taskState = "None";

    // CAS-057 §2.2/§2.3: inline cancel confirm is open / the cancel POST was accepted (or is in flight) and
    // the page is waiting for the task to reach a terminal state. The 2 s cancelling poll is a local
    // constant, not a config key (§6).
    private bool showCancelConfirm;
    private bool isCancelRequested;
    private static readonly TimeSpan CancellingPollInterval = TimeSpan.FromSeconds(2);
    private const string CancellingBannerText = "Cancelling search — stopping and gathering the matches found so far…";

    // CAS-048 §2.2: the mode ("Filename" | "Keyword" | "Date") that produced the current task's results.
    // The explorer shows only while the selected mode equals it, so no stale rows appear in another mode.
    private string? resultsMode;

    // CAS-048 §2.2: "M matches in total" (from GET /search/{id}/results totals); null = omitted.
    private int? totalMatches;

    // CAS-048 §2.2: selected searchResultIds (from browse / result-ids responses only, V6). Persists while
    // navigating folders; cleared after a send, a new search, a task reload or a mode switch.
    private readonly HashSet<int> selectedResultIds = new();

    // The TaskId query value the page last reloaded for (CAS-048 §2.4); a change re-runs the reload.
    private string? loadedTaskIdParameter;

