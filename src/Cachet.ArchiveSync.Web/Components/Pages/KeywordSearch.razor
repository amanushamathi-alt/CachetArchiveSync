    private async Task HandleSearchAsync()
    {
        // CAS-039 §2.5: same condition as the Search button's disabled state.
        if (!CanSearch)
        {
            return;
        }

        // CAS-039 §2.2/§2.3: dates only in Date mode (already validated by CanSearch above); the
        // user's mode and date entries are left as-is for the next search.
        DateOnly? fromDate = null;
        DateOnly? toDate = null;
        if (isDateMode && TryParseDate(fromDateText, out var parsedFrom) && TryParseDate(toDateText, out var parsedTo))
        {
            fromDate = parsedFrom;
            toDate = parsedTo;
        }

        searchErrorBanner = null;
        // CAS-048 §2.2/SC-8: a new search hides the previous results and clears the selection.
        taskState = "None";
        resultsMode = null;
        totalMatches = null;
        // CAS-030: a new search replaces any reloaded/deep-linked task context (§8.2).
        taskNotice = null;
        failureDetail = null;
        reloadedSearchParameters = null;
        ackEligibleTaskId = null;
        selectedResultIds.Clear();

        // CAS-039 A2/A3: in Date mode the term is always empty (cleared on entering Date mode), so it
        // is posted as Term = "" (date-only search).
        var trimmedTerm = searchTerm.Trim();
        var bucket = bucketName!; // CanSearch above already returned on string.IsNullOrWhiteSpace(bucketName)

        var client = HttpClientFactory.CreateClient("CachetApi");
        HttpResponseMessage response;
        try
        {
            response = await client.PostAsJsonAsync("search", new SearchRequest
            {
                Term = trimmedTerm,
                Bucket = bucket,
                Extension = selectedExtension,
                FromDate = fromDate,
                ToDate = toDate,
                // CAS-048 V3: always the selected radio's mode; Filename and Keyword post no dates.
                Mode = CurrentMode
            });
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "KeywordSearch screen: unable to reach Api for {Endpoint}", "POST /search");
            searchErrorBanner = GenericErrorMessage;
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            Logger.LogWarning("KeywordSearch screen: unexpected {StatusCode} from {Endpoint}", (int)response.StatusCode, "POST /search");
            searchErrorBanner = GenericErrorMessage;
            return;
        }

        var submitted = await response.Content.ReadFromJsonAsync<SearchSubmittedResponse>();
        if (submitted is null)
        {
            searchErrorBanner = GenericErrorMessage;
            return;
        }

        resultsMode = CurrentMode;
        activeTaskId = submitted.TaskId;
        submittedAtUtc = submitted.SubmittedAt;
        isSearchInFlight = true;
        taskState = "InProgress";
        pollCount = 0;
        progressProcessed = null;
        progressTotal = null;
        progressStartedAtUtc = null;
        // The in-progress banner is the single status message for a running search (no separate
        // "Search submitted" toast); a stale toast from an earlier action is cleared.
        toastMessage = null;

        Logger.LogInformation("KeywordSearch screen: search submitted, TaskId={TaskId}", activeTaskId);

        // Fire-and-forget: the poll loop reports back into component state via InvokeAsync/StateHasChanged.
        _ = PollTaskAsync(activeTaskId.Value);
    }

    private async Task PollTaskAsync(int taskId, TimeSpan? interval = null)
    {
        pollCts?.Cancel();
        pollCts?.Dispose();
        pollCts = new CancellationTokenSource();
        pollTimer?.Dispose();
        // CAS-030 §8.4: one config-bound interval (Worker:TaskManagerPollIntervalSeconds, default 10 s);
        // CAS-057 §2.3: restarted at CancellingPollInterval while a cancel is pending.
        pollTimer = new PeriodicTimer(interval ?? PollingOptions.Value.PollInterval);
        var client = HttpClientFactory.CreateClient("CachetApi");

        try
        {
            while (await pollTimer.WaitForNextTickAsync(pollCts.Token))
            {
                pollCount++;

                HttpResponseMessage response;
                try
                {
                    response = await client.GetAsync($"search/{taskId}/results", pollCts.Token);
                }
                catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
                {
                    // Transient network/server error while polling (§8.5) — keep polling rather
                    // than surfacing a banner for a single missed tick.
                    Logger.LogWarning(ex, "KeywordSearch screen: unable to reach Api for {Endpoint}", "GET /search/{taskId}/results");
                    continue;
                }

                if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
                {
                    // 409 task-not-complete (CAS-006 §6.2) — refresh progress, redraw the elapsed time, keep polling.
                    await RefreshProgressAsync(client, taskId, pollCts.Token);
                    await InvokeAsync(StateHasChanged);
                    continue;
                }

                if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    // CAS-030 §7 V9: stop this loop and tell the user to sign in again.
                    Logger.LogWarning("{Component}: poll stopped on 401 from {Endpoint}", ScreenName, "GET /search/{taskId}/results");
                    sessionExpired = true;
                    isSearchInFlight = false;
                    isCancelRequested = false;
                    showCancelConfirm = false;
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                if (!response.IsSuccessStatusCode)
                {
                    Logger.LogWarning("KeywordSearch screen: unexpected {StatusCode} from {Endpoint}", (int)response.StatusCode, "GET /search/{taskId}/results");
                    searchErrorBanner = GenericErrorMessage;
                    isSearchInFlight = false;
                    isCancelRequested = false;
                    showCancelConfirm = false;
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                var result = await response.Content.ReadFromJsonAsync<SearchResultsResponse>(cancellationToken: pollCts.Token);
                if (result is null)
                {
                    continue;
                }

                isSearchInFlight = false;
                var wasCancelling = isCancelRequested;
                isCancelRequested = false;
                showCancelConfirm = false;

                if (string.Equals(result.Status, "Completed", StringComparison.Ordinal))
                {
                    taskState = "Completed";
                    totalMatches = TotalMatchesOf(result);

                    // CAS-057 §2.6: the search finished before the cancel took effect.
                    if (wasCancelling)
                    {
                        toastMessage = "The search finished before it could be cancelled.";
                    }
                }
                else if (string.Equals(result.Status, "Cancelled", StringComparison.Ordinal))
                {
                    // CAS-057 §2.4/§2.5: partial results (if any) + notice; never "Failed".
                    taskState = "Cancelled";
                    ApplyCancelledResult(result);
                }
                else
                {
                    taskState = "Failed";
                }

                Logger.LogInformation("KeywordSearch screen: task {TaskId} completed after {PollCount} polls", taskId, pollCount);

                await InvokeAsync(StateHasChanged);
                return;
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed or a new search superseded this poll loop — stop silently.
        }
    }

    // CAS-057 §2.2: first click only opens the inline confirm; [Keep running] restores the button.
    private void ShowCancelConfirm() => showCancelConfirm = true;

    private void KeepSearchRunning() => showCancelConfirm = false;

    // CAS-057 §2.3: POST tasks/{id}/cancel, only after the confirm. isCancelRequested is the single-shot guard
    // (set before the first await). Logs the task id and status only — never term, path or file name.
    private async Task CancelSearchAsync()
    {
        if (isCancelRequested || activeTaskId is not { } taskId)
        {
            return;
        }

        isCancelRequested = true;
        showCancelConfirm = false;

        var client = HttpClientFactory.CreateClient("CachetApi");
        HttpResponseMessage response;
        try
        {
            response = await client.PostAsync($"tasks/{taskId}/cancel", null);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "KeywordSearch screen: unable to reach Api for {Endpoint}, TaskId={TaskId}", "POST /tasks/{taskId}/cancel", taskId);
            isCancelRequested = false;
            searchErrorBanner = GenericErrorMessage;
            return;
        }

        using (response)
        {
            Logger.LogInformation("KeywordSearch screen: cancel requested, TaskId={TaskId}, StatusCode={StatusCode}", taskId, (int)response.StatusCode);

            switch (response.StatusCode)
            {
                case System.Net.HttpStatusCode.OK:
                case System.Net.HttpStatusCode.Accepted:
                    // Stay "Cancelling" (filter bar disabled); poll faster until the task leaves Running.
                    _ = PollTaskAsync(taskId, CancellingPollInterval);
                    break;

                case System.Net.HttpStatusCode.Conflict:
                    // task-not-cancellable: it just finished — the running poll renders the real outcome.
                    isCancelRequested = false;
                    toastMessage = "The search had already finished.";
                    break;

                case System.Net.HttpStatusCode.Unauthorized:
                    // Same handling as a 401 from the poll (CAS-030 §7 V9).
                    pollCts?.Cancel();
                    sessionExpired = true;
                    isSearchInFlight = false;
                    isCancelRequested = false;
                    break;

                default:
                    isCancelRequested = false;
                    searchErrorBanner = GenericErrorMessage;
                    break;
            }
        }
    }

    // CAS-048 §2.2/V6: the explorer reports ids it got from browse / result-ids responses; nothing typed
    // or built here is ever added.
    private void OnResultSelectionChanged(FileExplorer.SelectionChange change)
    {
        foreach (var id in change.Ids)
        {
            if (change.Selected)
            {
                selectedResultIds.Add(id);
            }
            else
            {
                selectedResultIds.Remove(id);
            }
        }
    }

    private async Task SendToQuarantineAsync()
    {
        var selectedIds = selectedResultIds;
        if (selectedIds.Count == 0 || activeTaskId is null)
        {
            return;
        }

        var fileIds = selectedIds.ToList();

        var client = HttpClientFactory.CreateClient("CachetApi");
        HttpResponseMessage response;
        try
        {
            response = await client.PostAsJsonAsync("search/results/quarantine", new QuarantineAddRequest
            {
                TaskId = activeTaskId.Value,
                FileIds = fileIds
            });
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "KeywordSearch screen: unable to reach Api for {Endpoint}", "POST /search/results/quarantine");
            searchErrorBanner = GenericErrorMessage;
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            Logger.LogWarning("KeywordSearch screen: unexpected {StatusCode} from {Endpoint}", (int)response.StatusCode, "POST /search/results/quarantine");
            searchErrorBanner = GenericErrorMessage;
            return;
        }

        var body = await response.Content.ReadFromJsonAsync<QuarantineAddResponse>();
        var addedCount = body?.Items.Count ?? 0;

        // §10 SC-7: partial-success warnings surfaced without discarding the files that did
        // succeed — clear the selection for the rows just processed either way.
        selectedIds.Clear();

        toastMessage = body?.Warnings is { Count: > 0 } warnings
            ? $"{addedCount} file(s) sent to Quarantine. {string.Join(" ", warnings)}"
            : $"{addedCount} file(s) sent to Quarantine.";

        await LoadQuarantineAsync();
    }

    // CAS-025 §3/§8.5: display-only chip color mapping (UI/UX Spec §1.3). No DTO/API/event-handler
    // change — purely which CSS class a given status string renders with. The cachet-chip-* classes
    // carry the wireframe colors (app.css); the cachet-ks-chip-* names are kept as stable hooks.
    private static string ChipClass(string? status) => status switch
    {
        "Flagged" => "cachet-chip cachet-chip-flagged cachet-ks-chip cachet-ks-chip-flagged",
        "Needs Review" => "cachet-chip cachet-chip-needs-review cachet-ks-chip cachet-ks-chip-needs-review",
        "Informational" => "cachet-chip cachet-chip-informational cachet-ks-chip cachet-ks-chip-informational",
        "Quarantined" => "cachet-chip cachet-chip-needs-review cachet-ks-chip",
        _ => "cachet-chip cachet-chip-neutral cachet-ks-chip"
    };

