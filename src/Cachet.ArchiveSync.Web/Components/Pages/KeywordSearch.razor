    // CAS-048 V1: Filename and Keyword need a trimmed term of 3-200 characters (Date has no term).
    private bool SearchTermValid =>
        searchTerm.Trim().Length is >= MinTermLength and <= MaxTermLength;

    // CAS-044 §8.1 / CAS-048 §2.1: Files is the mode on every plain load. Files, Filename, Keyword and
    // Date are exclusive: isFilesMode, else isFilenameMode, else isDateMode, else Keyword.
    private bool isFilesMode = true;
    private bool isFilenameMode;
    private bool isDateMode;
