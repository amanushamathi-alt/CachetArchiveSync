    private async Task HandleRunScanAsync()
    {
        if (isScanInFlight)
        {
            return;
        }

        scanErrorBanner = null;
        // CAS-030: a new scan replaces any reloaded/deep-linked scan context (§8.3).
        taskNotice = null;
        failureDetail = null;
        ackEligibleTaskId = null;
        newItems.Clear();
        removedItems.Clear();
        modifiedItems.Clear();
        selectedNewIds.Clear();
        selectedRemovedIds.Clear();
        selectedModifiedIds.Clear();
        foreach (var paging in new[] { removedPaging, newPaging, modifiedPaging })
        {
            paging.Page = 1;
            paging.TotalCount = 0;
            paging.HasError = false;
        }

        scanCompletedAt = null;

        var client = HttpClientFactory.CreateClient("CachetApi");
        HttpResponseMessage response;
        try
        {
            response = await client.PostAsync("sync/scan", content: null);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "ODriveSyncContentScan screen: unable to reach Api for {Endpoint}", "POST /sync/scan");
            scanErrorBanner = GenericErrorMessage;
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            Logger.LogWarning("ODriveSyncContentScan screen: unexpected {StatusCode} from {Endpoint}", (int)response.StatusCode, "POST /sync/scan");
            scanErrorBanner = GenericErrorMessage;
            return;
        }

        var submitted = await response.Content.ReadFromJsonAsync<TaskSubmittedResponse>();
        if (submitted is null)
        {
            scanErrorBanner = GenericErrorMessage;
            return;
        }

        scanTaskId = submitted.TaskId;
        scanSubmittedAtUtc = submitted.SubmittedAt;
        isScanInFlight = true;
        scanState = "InProgress";
        scanPollCount = 0;
        // CAS-023 §8.2 point 1 — Task Manager reference dropped from this copy (§0/§4).
        toastMessage = "Content Scan submitted — this may take anywhere from a few minutes to a full day depending on data volume.";

        Logger.LogInformation("ODriveSyncContentScan screen: scan submitted, TaskId={TaskId}", scanTaskId);

        // Fire-and-forget: the poll loop reports back into component state via InvokeAsync/StateHasChanged.
        _ = PollScanAsync(scanTaskId.Value);
    }

    private async Task PollScanAsync(int taskId)
    {
        scanPollCts?.Cancel();
        scanPollCts?.Dispose();
        scanPollCts = new CancellationTokenSource();
        scanPollTimer?.Dispose();
        scanPollTimer = new PeriodicTimer(PollInterval);
        var client = HttpClientFactory.CreateClient("CachetApi");

        try
        {
            while (await scanPollTimer.WaitForNextTickAsync(scanPollCts.Token))
            {
                scanPollCount++;

                HttpResponseMessage response;
                try
                {
                    response = await client.GetAsync(ResultsUri(taskId, RemovedPanel, NewPanel, ModifiedPanel), scanPollCts.Token);
                }
                catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
                {
                    // Transient network/server error while polling (§8.5) — keep polling rather
                    // than surfacing a banner for a single missed tick.
                    Logger.LogWarning(ex, "ODriveSyncContentScan screen: unable to reach Api for {Endpoint}", "GET /sync/{taskId}/results");
                    continue;
                }

                if (response.StatusCode == System.Net.HttpStatusCode.Conflict)
                {
                    // 409 task-not-complete (CAS-007 §6.2) — keep polling.
                    continue;
                }

                if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    // CAS-030 §7 V9: stop this loop and tell the user to sign in again.
                    Logger.LogWarning("{Component}: poll stopped on 401 from {Endpoint}", ScreenName, "GET /sync/{taskId}/results");
                    sessionExpired = true;
                    isScanInFlight = false;
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                if (!response.IsSuccessStatusCode)
                {
                    Logger.LogWarning("ODriveSyncContentScan screen: unexpected {StatusCode} from {Endpoint}", (int)response.StatusCode, "GET /sync/{taskId}/results");
                    scanErrorBanner = GenericErrorMessage;
                    isScanInFlight = false;
                    await InvokeAsync(StateHasChanged);
                    return;
                }

                var result = await response.Content.ReadFromJsonAsync<SyncScanResultsResponse>(cancellationToken: scanPollCts.Token);
                if (result is null)
                {
                    continue;
                }

                isScanInFlight = false;

                if (string.Equals(result.Status, "Completed", StringComparison.Ordinal))
                {
                    scanState = "Completed";
                    scanCompletedAt = DateTimeOffset.UtcNow;
                    ApplyResults(result);
                }
                else
                {
                    scanState = "Failed";
                }

                Logger.LogInformation("ODriveSyncContentScan screen: scan task {TaskId} completed after {PollCount} polls", taskId, scanPollCount);

                await InvokeAsync(StateHasChanged);
                return;
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed or a new scan superseded this poll loop — stop silently.
        }
    }

    private void ToggleSelection(HashSet<int> selection, int fileId, bool isChecked)
    {
        if (isChecked)
        {
            // CAS-045 §9 V6: never grow the cumulative selection past the cap.
            if (selection.Count < MaxSelection)
            {
                selection.Add(fileId);
            }
        }
        else
        {
            selection.Remove(fileId);
        }
    }

