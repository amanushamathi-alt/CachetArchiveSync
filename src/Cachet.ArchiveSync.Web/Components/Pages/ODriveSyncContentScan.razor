    private async Task ConfirmPurgeAsync()
    {
        showPurgeConfirm = false;
        await SubmitSyncActionAsync("SyncPurge", "sync/actions/purge", selectedRemovedIds, purgeState, confirm: true);
    }

    private async Task SubmitSyncActionAsync(
        string actionType, string endpoint, HashSet<int> selectedIds, ActionPollState state, bool confirm = false)
    {
        if (selectedIds.Count == 0 || state.IsInFlight || scanTaskId is null || !hasFullAccess)
        {
            return;
        }

        var fileIds = selectedIds.ToList();
        scanErrorBanner = null;

        var client = HttpClientFactory.CreateClient("CachetApi");
        HttpResponseMessage response;
        try
        {
            response = confirm
                ? await client.PostAsJsonAsync(endpoint, new SyncPurgeRequest
                {
                    TaskId = scanTaskId.Value,
                    FileIds = fileIds,
                    Confirm = true
                })
                : await client.PostAsJsonAsync(endpoint, new SyncActionRequest
                {
                    TaskId = scanTaskId.Value,
                    FileIds = fileIds
                });
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "ODriveSyncContentScan screen: unable to reach Api for {Endpoint}", endpoint);
            scanErrorBanner = GenericErrorMessage;
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            // Covers §7 V4: an unexpected 403/404/409/422 from any §6 endpoint renders the inline
            // banner rather than an unhandled exception/blank screen.
            Logger.LogWarning("ODriveSyncContentScan screen: unexpected {StatusCode} from {Endpoint}", (int)response.StatusCode, endpoint);
            scanErrorBanner = GenericErrorMessage;
            return;
        }

        var submitted = await response.Content.ReadFromJsonAsync<TaskSubmittedResponse>();
        if (submitted is null)
        {
            scanErrorBanner = GenericErrorMessage;
            return;
        }

        Logger.LogInformation(
            "ODriveSyncContentScan screen: {ActionType} submitted, TaskId={TaskId}, FileCount={FileCount}",
            actionType, submitted.TaskId, fileIds.Count);

        toastMessage = $"{fileIds.Count} file(s) submitted.";

        state.IsInFlight = true;
        selectedIds.Clear();

        // CAS-045 §2.4: track the action's own task (SyncCopy/SyncUpdate/SyncPurge are allowed
        // GET /tasks/{id} types), then reload the affected panel's current page.
        _ = PollActionAsync(actionType, submitted.TaskId, state);
    }

    // CAS-045 §2.4: polls GET tasks/{actionTaskId} every PollInterval; on Completed/Failed (any
    // terminal status) reloads the affected panel's current page — the server excludes Synced rows,
    // so the reload is the single source of truth for rows and TotalCount.
    private async Task PollActionAsync(string actionType, int actionTaskId, ActionPollState state)
    {
        state.Cts?.Cancel();
        state.Cts?.Dispose();
        state.Cts = new CancellationTokenSource();
        // CAS-060: captured now — state.Cts may be disposed (page closed) or replaced (next action)
        // before the mirror-sync trigger below reads it.
        var pollToken = state.Cts.Token;
        state.Timer?.Dispose();
        state.Timer = new PeriodicTimer(PollInterval);
        var client = HttpClientFactory.CreateClient("CachetApi");
        string? terminalStatus = null;

        try
        {
            while (await state.Timer.WaitForNextTickAsync(state.Cts.Token))
            {
                HttpResponseMessage response;
                try
                {
                    response = await client.GetAsync($"tasks/{actionTaskId}", state.Cts.Token);
                }
                catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
                {
                    Logger.LogWarning(ex, "ODriveSyncContentScan screen: unable to reach Api for {Endpoint}", "GET /tasks/{taskId}");
                    continue;
                }

                using (response)
                {
                    if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                    {
                        // CAS-030 §7 V9: stop this loop and tell the user to sign in again.
                        Logger.LogWarning("{Component}: poll stopped on 401 from {Endpoint}", ScreenName, "GET /tasks/{taskId}");
                        sessionExpired = true;
                        state.IsInFlight = false;
                        await InvokeAsync(StateHasChanged);
                        return;
                    }

                    if (!response.IsSuccessStatusCode)
                    {
                        Logger.LogWarning("ODriveSyncContentScan screen: unexpected {StatusCode} from {Endpoint}", (int)response.StatusCode, "GET /tasks/{taskId}");
                        scanErrorBanner = GenericErrorMessage;
                        state.IsInFlight = false;
                        await InvokeAsync(StateHasChanged);
                        return;
                    }

                    var task = await response.Content.ReadFromJsonAsync<TaskDetailResponse>(cancellationToken: state.Cts.Token);
                    if (task is null || task.Status is "Queued" or "Running")
                    {
                        continue;
                    }

                    terminalStatus = task.Status;
                }

                var panel = actionType switch
                {
                    "SyncCopy" => NewPanel,
                    "SyncUpdate" => ModifiedPanel,
                    _ => RemovedPanel
                };

                await LoadPanelAsync(panel);
                state.IsInFlight = false;
                await InvokeAsync(StateHasChanged);

                // CAS-060: a completed Copy refreshes the local B2 mirror, so the copied files can be
                // opened from the B2 side. CAS-061: a completed Purge calls it too (client request);
                // Mirror Sync only downloads, so purged files are not removed from the mirror.
                // CAS-063: a completed Update calls it too, so the mirror gets the new version
                // (CAS-059 re-downloads changed content even at the same size).
                // No action is changed by this, and it never affects their outcome.
                if (actionType is "SyncCopy" or "SyncUpdate" or "SyncPurge" && terminalStatus == "Completed" && !pollToken.IsCancellationRequested)
                {
                    await TriggerMirrorSyncAsync(client, actionType, pollToken);
                    await InvokeAsync(StateHasChanged);
                }

                return;
            }
        }
        catch (OperationCanceledException)
        {
            // Component disposed or superseded — stop silently.
        }
    }

    // CAS-060/CAS-061/CAS-063: POST sync/mirror-sync once (after Copy, Purge or Update). 409 means a sync is already Queued/Running and may
    // have listed B2 before this action finished, so retry each poll interval up to
    // MirrorSyncMaxAttempts. Every outcome is a toast only — the action's result and the reloaded
    // panel are never touched.
    private async Task TriggerMirrorSyncAsync(HttpClient client, string actionType, CancellationToken ct)
    {
        var maxAttempts = Math.Max(1, PollingOptions.Value.MirrorSyncMaxAttempts);
        var actionDone = actionType switch
        {
            "SyncPurge" => "Files purged.",
            "SyncUpdate" => "Files updated.",
            _ => "Files copied."
        };
        for (var attempt = 1; ; attempt++)
        {
            HttpResponseMessage response;
            try
            {
                response = await client.PostAsync("sync/mirror-sync", content: null, ct);
            }
            catch (Exception ex) when (ex is HttpRequestException || (ex is TaskCanceledException && !ct.IsCancellationRequested))
            {
                // Api unreachable, or an HttpClient timeout (not a page close / superseded poll).
                Logger.LogWarning(ex, "ODriveSyncContentScan screen: unable to reach Api for {Endpoint}", "POST /sync/mirror-sync");
                toastMessage = $"{actionDone} {MirrorSyncFailedMessage}";
                return;
            }

            using (response)
            {
                if (response.IsSuccessStatusCode)
                {
                    TaskSubmittedResponse? submitted = null;
                    try
                    {
                        submitted = await response.Content.ReadFromJsonAsync<TaskSubmittedResponse>(cancellationToken: ct);
                    }
                    catch (System.Text.Json.JsonException ex)
                    {
                        // Accepted, but the body is unreadable: the sync was still queued.
                        Logger.LogWarning(ex, "ODriveSyncContentScan screen: unreadable 2xx body from {Endpoint}", "POST /sync/mirror-sync");
                    }

                    Logger.LogInformation("ODriveSyncContentScan screen: B2MirrorSync submitted after {ActionType}, TaskId={TaskId}", actionType, submitted?.TaskId);
                    toastMessage = submitted is null
                        ? "B2 mirror refresh started."
                        : $"B2 mirror refresh started (Task #{submitted.TaskId}).";
                    return;
                }

                if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
                {
                    // CAS-030 §7 V9: same handling as the poll loops.
                    Logger.LogWarning("{Component}: mirror sync stopped on 401 from {Endpoint}", ScreenName, "POST /sync/mirror-sync");
                    sessionExpired = true;
                    return;
                }

                if (response.StatusCode != System.Net.HttpStatusCode.Conflict)
                {
                    Logger.LogWarning("ODriveSyncContentScan screen: unexpected {StatusCode} from {Endpoint}", (int)response.StatusCode, "POST /sync/mirror-sync");
                    toastMessage = $"{actionDone} {MirrorSyncFailedMessage}";
                    return;
                }
            }

            if (attempt >= maxAttempts)
            {
                Logger.LogInformation("ODriveSyncContentScan screen: B2MirrorSync still busy after {Attempts} attempt(s); not submitted", attempt);
                toastMessage = $"{actionDone} The B2 mirror will be refreshed by the next B2 Mirror Sync.";
                return;
            }

            await Task.Delay(PollInterval, ct);
        }
    }

    private static string FormatRelativeTime(DateTimeOffset? at)
    {
        if (at is null)
        {
            return "just now";
        }

        var elapsed = DateTimeOffset.UtcNow - at.Value;
        if (elapsed < TimeSpan.FromMinutes(1))
        {
            return "less than a minute";
        }

        if (elapsed < TimeSpan.FromHours(1))
        {
            var minutes = (int)elapsed.TotalMinutes;
            return $"{minutes} minute{(minutes == 1 ? string.Empty : "s")}";
        }

        var hours = (int)elapsed.TotalHours;
        return $"{hours} hour{(hours == 1 ? string.Empty : "s")}";
    }

    // CAS-027 §8.3: a deep-linked scan task has no known scanSubmittedAtUtc — this fallback omits
    // the "submitted X ago" clause rather than showing a broken/blank relative-time string, mirroring
    // KeywordSearch.razor's ProgressBannerText.
    private string ScanProgressBannerText => scanSubmittedAtUtc is not null
        ? $"Content Scan in progress — submitted {FormatRelativeTime(scanSubmittedAtUtc)} ago. Results will appear here automatically when ready."
        : "Content Scan in progress. Results will appear here automatically when ready.";

    public async ValueTask DisposeAsync()
    {
        scanPollCts?.Cancel();
        scanPollTimer?.Dispose();
        scanPollCts?.Dispose();

        foreach (var state in new[] { copyState, updateState, purgeState })
        {
            state.Cts?.Cancel();
            state.Timer?.Dispose();
            state.Cts?.Dispose();
        }

        await ValueTask.CompletedTask;
    }
}
