    private void OpenPurgeConfirm()
    {
        if (selectedRemovedIds.Count == 0 || purgeState.IsInFlight || !hasFullAccess)
        {
            return;
        }

        // CAS-023 §7 V3/§8.4: snapshot the count for the dialog's copy; the dialog does not submit
        // anything until ConfirmPurgeAsync is explicitly invoked (V3, SC-8) — cancel leaves the
        // selection intact and sends no request (CancelPurge below).
        purgeConfirmCount = selectedRemovedIds.Count;
        showPurgeConfirm = true;
    }

    private void CancelPurge()
    {
