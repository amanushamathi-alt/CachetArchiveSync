@page "/odrive-sync"
@rendermode InteractiveServer
@attribute [Microsoft.AspNetCore.Authorization.Authorize(Policy = "CachetAuthenticated")]
@implements IAsyncDisposable
@using Cachet.ArchiveSync.Core.Dtos
@using Microsoft.Extensions.Options

@* CAS-023 §8.2: InteractiveServer is required here (same rationale as CAS-022's KeywordSearch.razor)
   — this screen polls its own submitted scan task and up to three of its own submitted sync-action
   tasks, auto-populating the three panels in place over a live SignalR circuit. *@

@* Bug fix (2026-09-23, cross-referenced from CAS-022's own login-flow investigation): this page
   relied on Program.cs's global FallbackPolicy for its "requires authentication" guarantee
   (§12), but that policy was removed because it also blocked the framework endpoint serving
   _framework/blazor.web.js on the unauthenticated login page. Restoring equivalent protection
   here via an explicit page-level [Authorize] attribute, enforced by AuthorizeRouteView
   (Routes.razor) — same fix applied to KeywordSearch.razor. *@

<PageTitle>O-Drive Sync and Content Scan</PageTitle>

@* Wireframe layout: toolbar row (no global search on this tab … Task Manager, Quarantine Queue,
   Audit Log), action row (Run Content Scan … reports), then the three side-by-side, collapsible
   panels in the wireframe's order: Removed | New | Modified. *@
<div class="cachet-page">
    <div class="cachet-toolbar">
        <span class="cachet-toolbar-spacer"></span>

        @* CAS-030 §8.1: Task Manager button + live badge, immediately left of Quarantine Queue. *@
        <TaskManagerBadge />

        @* CAS-024 §3/§8.1: live Quarantine Queue trigger; this page has no quarantine list of its
           own, so quarantineCount is fetched separately (below). *@
        <button type="button"
                class="cachet-btn cachet-btn-square cachet-sync-quarantine-trigger-btn"
                @onclick="OpenQuarantineQueueModal">
            Quarantine Queue <span class="cachet-btn-count cachet-btn-count-amber">@quarantineCount</span>
        </button>

        @* CAS-031 §3: live Audit Log trigger (replaces CAS-025 §0's disabled placeholder); no count
           badge (CAS-031 §0 point 3). *@
        <button type="button"
                class="cachet-btn cachet-btn-square cachet-al-trigger-btn"
                @onclick="OpenAuditLogModal">
            Audit Log
        </button>
    </div>

    <div class="cachet-actionbar">
        <button type="button"
                class="cachet-btn-primary cachet-sync-scan-btn"
                disabled="@isScanInFlight"
                @onclick="HandleRunScanAsync">
            Run Content Scan
        </button>

        <span class="cachet-toolbar-spacer"></span>

        @* Pre-/Post-Action Report buttons hidden by request. To restore, re-add:
           <button type="button" class="cachet-btn" @onclick="@(() => OpenReportModal(ReportKind.PreAction))">Pre-Action Report</button>
           <button type="button" class="cachet-btn" @onclick="@(() => OpenReportModal(ReportKind.PostAction))">Post-Action Report</button> *@
    </div>

    <QuarantineQueueModal @ref="quarantineModal" OnDeleteCompleted="LoadQuarantineCountAsync" />
    @* §8.1: exact tab text in MainLayout.razor. *@
    <ReportModal @ref="reportModal" ActiveTabLabel="O-Drive Sync and content Scan" />
    <AuditLogModal @ref="auditLogModal" />
    @* CAS-040 §8.2/§8.3: File Viewer for the three panels' clickable file names (Removed rows open
       the B2 mirror copy, New/Modified rows the O-Drive mirror copy — §6.5). *@
    <FileViewerModal FileIndexId="viewerFileIndexId" Context="ODriveSync" OnClose="CloseFileViewerAsync" />

    <div class="cachet-banners">
        @if (toastMessage is not null)
        {
            <div class="cachet-banner cachet-banner-toast cachet-sync-toast">@toastMessage</div>
        }

        @* CAS-030 §7 V7: unknown, non-integer, or wrong-type ?taskId= (including a Sync* task, §8.3). *@
        @if (taskNotice is not null)
        {
            <div class="cachet-banner cachet-banner-notice cachet-sync-notice">@taskNotice</div>
        }

        @* CAS-030 §7 V9: a 401 stopped a poll/reload call. *@
        @if (sessionExpired)
        {
            <div class="cachet-banner cachet-banner-error cachet-sync-error-banner">
                @SessionExpiredMessage <a href="login">Sign in</a>
            </div>
        }

        @if (isScanInFlight)
        {
            <div class="cachet-banner cachet-banner-progress cachet-sync-progress-banner">@ScanProgressBannerText</div>
        }
        else if (scanState == "Failed")
        {
            <div class="cachet-banner cachet-banner-error cachet-sync-error-banner">This Content Scan did not complete successfully.@(failureDetail is not null ? $" {failureDetail}" : null)</div>
        }

        @if (scanErrorBanner is not null)
        {
            <div class="cachet-banner cachet-banner-error cachet-sync-error-banner">@scanErrorBanner</div>
        }
    </div>

    @* CAS-045 §2.1: scan summary strip — remaining actionable rows (Synced excluded server-side, §2.4). *@
    @if (scanState == "Completed" && !sessionExpired)
    {
        <div class="cachet-sync-summary" title="Remaining to review">
            <span class="cachet-sync-summary-caption">Remaining to review</span>
            <span class="cachet-sync-summary-total">Removed from O-Drive <strong>@removedPaging.TotalCount.ToString("N0")</strong></span>
            <span class="cachet-sync-summary-total">New on O-Drive <strong>@newPaging.TotalCount.ToString("N0")</strong></span>
            <span class="cachet-sync-summary-total">Modified on O-Drive <strong>@modifiedPaging.TotalCount.ToString("N0")</strong></span>
            <span class="cachet-sync-summary-caption">Completed @(scanCompletedAt is null ? "" : scanCompletedAt.Value.ToLocalTime().ToString("g") + " ")· Task #@scanTaskId</span>
        </div>
    }

    <div class="cachet-panels">
        @* Panels stay mounted in every state (in progress, failed, session expired) so the
           three-column layout never collapses; only their contents change. *@
        <section class="cachet-panel cachet-sync-panel @(collapsedPanels.Contains(RemovedPanel) ? "is-collapsed" : null)">
            <div class="cachet-panel-header">
                <div class="cachet-panel-heading">
                    <button type="button" class="cachet-panel-toggle" aria-label="Collapse or expand Removed from O-Drive" @onclick="() => ToggleCollapsed(RemovedPanel)">@CollapseIcon(RemovedPanel)</button>
                    <h2>Removed from O-Drive @if (scanState == "Completed") {<span class="cachet-panel-count">@removedPaging.TotalCount.ToString("N0")</span>}</h2>
                </div>
                @if (scanState == "Completed" && removedItems.Count > 0)
                {
                    <div class="cachet-panel-actions">
                        <button type="button"
                                class="cachet-btn-bulk cachet-btn-bulk-danger"
                                disabled="@(selectedRemovedIds.Count == 0 || purgeState.IsInFlight || !hasFullAccess)"
                                title="@(hasFullAccess ? null : "Requires Full Access")"
                                @onclick="OpenPurgeConfirm">
                            Purge from B2 (@selectedRemovedIds.Count)
                        </button>
                    </div>
                }
            </div>

            <div class="cachet-panel-body cachet-sync-panel-body-wrap @(removedPaging.IsLoading ? "is-loading" : null)" aria-busy="@(removedPaging.IsLoading ? "true" : "false")">
                @if (removedPaging.IsLoading)
                {
                    <span class="cachet-sync-spinner" role="status" aria-label="Loading"></span>
                }
                @if (removedPaging.HasError)
                {
                    <div class="cachet-sync-panel-error" role="alert">
                        Could not load this page. <button type="button" class="cachet-sync-clear-selection" @onclick="() => LoadPanelAsync(RemovedPanel)">Retry</button>
                    </div>
                }
                @if (scanState == "None")
                {
                    <p class="cachet-panel-empty">No comparison run yet — run a Content Scan to get started.</p>
                }
                else if (isScanInFlight)
                {
                    <p class="cachet-panel-empty">Waiting for results…</p>
                }
                else if (scanState != "Completed" || sessionExpired)
                {
                    <p class="cachet-panel-empty">No results to show.</p>
                }
                else if (removedItems.Count == 0)
                {
                    <p class="cachet-panel-empty">No files removed.</p>
                }
                else
                {
                    <table class="cachet-grid-table">
                        <thead>
                            <tr>
                                <th class="cachet-col-check">
                                    <input type="checkbox"
                                           aria-label="Select all removed files"
                                           checked="@AllSelected(selectedRemovedIds, removedItems.Select(i => i.FileId))"
                                           disabled="@(!AllSelected(selectedRemovedIds, removedItems.Select(i => i.FileId)) && selectedRemovedIds.Count >= MaxSelection)"
                                           @onchange="@(e => SetAll(selectedRemovedIds, removedItems.Select(i => i.FileId), (bool)e.Value!))" />
                                </th>
                                <th>Name / Path</th>
                                <th class="cachet-col-b">Last Seen</th>
                                <th class="cachet-col-status">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in removedItems)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox"
                                               checked="@selectedRemovedIds.Contains(item.FileId)"
                                               disabled="@(!selectedRemovedIds.Contains(item.FileId) && selectedRemovedIds.Count >= MaxSelection)"
                                               @onchange="@(e => ToggleSelection(selectedRemovedIds, item.FileId, (bool)e.Value!))" />
                                    </td>
                                    <td>
                                        <button type="button" class="cachet-cell-name cachet-file-link" title="Open @item.Name" @ref="fileLinkRefs[FileLinkKey(RemovedPanel, item.FileId)]" @onclick="@(() => OpenFileViewer(item.FileIndexId, FileLinkKey(RemovedPanel, item.FileId)))">@item.Name</button>
                                        <span class="cachet-cell-path" title="@item.Path">@item.Path</span>
                                    </td>
                                    <td>@item.LastSeen</td>
                                    <td><span class="@SyncChipClass(item.SyncStatus)">@item.SyncStatus</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @PanelFooter(RemovedPanel, removedPaging, selectedRemovedIds)
        </section>

        <div class="cachet-panel-divider" aria-hidden="true"></div>

        <section class="cachet-panel cachet-sync-panel @(collapsedPanels.Contains(NewPanel) ? "is-collapsed" : null)">
            <div class="cachet-panel-header">
                <div class="cachet-panel-heading">
                    <button type="button" class="cachet-panel-toggle" aria-label="Collapse or expand New on O-Drive" @onclick="() => ToggleCollapsed(NewPanel)">@CollapseIcon(NewPanel)</button>
                    <h2>New on O-Drive @if (scanState == "Completed") {<span class="cachet-panel-count">@newPaging.TotalCount.ToString("N0")</span>}</h2>
                </div>
                @if (scanState == "Completed" && newItems.Count > 0)
                {
                    <div class="cachet-panel-actions">
                        <button type="button"
                                class="cachet-btn-bulk"
                                disabled="@(selectedNewIds.Count == 0 || copyState.IsInFlight || !hasFullAccess)"
                                title="@(hasFullAccess ? null : "Requires Full Access")"
                                @onclick="HandleCopyClick">
                            Copy to B2 (@selectedNewIds.Count)
                        </button>
                    </div>
                }
            </div>

            <div class="cachet-panel-body cachet-sync-panel-body-wrap @(newPaging.IsLoading ? "is-loading" : null)" aria-busy="@(newPaging.IsLoading ? "true" : "false")">
                @if (newPaging.IsLoading)
                {
                    <span class="cachet-sync-spinner" role="status" aria-label="Loading"></span>
                }
                @if (newPaging.HasError)
                {
                    <div class="cachet-sync-panel-error" role="alert">
                        Could not load this page. <button type="button" class="cachet-sync-clear-selection" @onclick="() => LoadPanelAsync(NewPanel)">Retry</button>
                    </div>
                }
                @if (scanState == "None")
                {
                    <p class="cachet-panel-empty">No comparison run yet — run a Content Scan to get started.</p>
                }
                else if (isScanInFlight)
                {
                    <p class="cachet-panel-empty">Waiting for results…</p>
                }
                else if (scanState != "Completed" || sessionExpired)
                {
                    <p class="cachet-panel-empty">No results to show.</p>
                }
                else if (newItems.Count == 0)
                {
                    <p class="cachet-panel-empty">No files added.</p>
                }
                else
                {
                    <table class="cachet-grid-table">
                        <thead>
                            <tr>
                                <th class="cachet-col-check">
                                    <input type="checkbox"
                                           aria-label="Select all new files"
                                           checked="@AllSelected(selectedNewIds, newItems.Select(i => i.FileId))"
                                           disabled="@(!AllSelected(selectedNewIds, newItems.Select(i => i.FileId)) && selectedNewIds.Count >= MaxSelection)"
                                           @onchange="@(e => SetAll(selectedNewIds, newItems.Select(i => i.FileId), (bool)e.Value!))" />
                                </th>
                                <th>Name / Path</th>
                                <th class="cachet-col-a">Size</th>
                                <th class="cachet-col-b">Modified</th>
                                <th class="cachet-col-status">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in newItems)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox"
                                               checked="@selectedNewIds.Contains(item.FileId)"
                                               disabled="@(!selectedNewIds.Contains(item.FileId) && selectedNewIds.Count >= MaxSelection)"
                                               @onchange="@(e => ToggleSelection(selectedNewIds, item.FileId, (bool)e.Value!))" />
                                    </td>
                                    <td>
                                        <button type="button" class="cachet-cell-name cachet-file-link" title="Open @item.Name" @ref="fileLinkRefs[FileLinkKey(NewPanel, item.FileId)]" @onclick="@(() => OpenFileViewer(item.FileIndexId, FileLinkKey(NewPanel, item.FileId)))">@item.Name</button>
                                        <span class="cachet-cell-path" title="@item.Path">@item.Path</span>
                                    </td>
                                    <td>@item.Size</td>
                                    <td>@item.ModifiedAt</td>
                                    <td><span class="@SyncChipClass(item.SyncStatus)">@item.SyncStatus</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @PanelFooter(NewPanel, newPaging, selectedNewIds)
        </section>

        <div class="cachet-panel-divider" aria-hidden="true"></div>

        <section class="cachet-panel cachet-sync-panel @(collapsedPanels.Contains(ModifiedPanel) ? "is-collapsed" : null)">
            <div class="cachet-panel-header">
                <div class="cachet-panel-heading">
                    <button type="button" class="cachet-panel-toggle" aria-label="Collapse or expand Modified files on O-Drive" @onclick="() => ToggleCollapsed(ModifiedPanel)">@CollapseIcon(ModifiedPanel)</button>
                    <h2>Modified files on O-Drive @if (scanState == "Completed") {<span class="cachet-panel-count">@modifiedPaging.TotalCount.ToString("N0")</span>}</h2>
                </div>
                @if (scanState == "Completed" && modifiedItems.Count > 0)
                {
                    <div class="cachet-panel-actions">
                        <button type="button"
                                class="cachet-btn-bulk"
                                disabled="@(selectedModifiedIds.Count == 0 || updateState.IsInFlight || !hasFullAccess)"
                                title="@(hasFullAccess ? null : "Requires Full Access")"
                                @onclick="HandleUpdateClick">
                            Update in B2 (@selectedModifiedIds.Count)
                        </button>
                    </div>
                }
            </div>

            <div class="cachet-panel-body cachet-sync-panel-body-wrap @(modifiedPaging.IsLoading ? "is-loading" : null)" aria-busy="@(modifiedPaging.IsLoading ? "true" : "false")">
                @if (modifiedPaging.IsLoading)
                {
                    <span class="cachet-sync-spinner" role="status" aria-label="Loading"></span>
                }
                @if (modifiedPaging.HasError)
                {
                    <div class="cachet-sync-panel-error" role="alert">
                        Could not load this page. <button type="button" class="cachet-sync-clear-selection" @onclick="() => LoadPanelAsync(ModifiedPanel)">Retry</button>
                    </div>
                }
                @if (scanState == "None")
                {
                    <p class="cachet-panel-empty">No comparison run yet — run a Content Scan to get started.</p>
                }
                else if (isScanInFlight)
                {
                    <p class="cachet-panel-empty">Waiting for results…</p>
                }
                else if (scanState != "Completed" || sessionExpired)
                {
                    <p class="cachet-panel-empty">No results to show.</p>
                }
                else if (modifiedItems.Count == 0)
                {
                    <p class="cachet-panel-empty">No files modified.</p>
                }
                else
                {
                    <table class="cachet-grid-table">
                        <thead>
                            <tr>
                                <th class="cachet-col-check">
                                    <input type="checkbox"
                                           aria-label="Select all modified files"
                                           checked="@AllSelected(selectedModifiedIds, modifiedItems.Select(i => i.FileId))"
                                           disabled="@(!AllSelected(selectedModifiedIds, modifiedItems.Select(i => i.FileId)) && selectedModifiedIds.Count >= MaxSelection)"
                                           @onchange="@(e => SetAll(selectedModifiedIds, modifiedItems.Select(i => i.FileId), (bool)e.Value!))" />
                                </th>
                                <th>Name / Path</th>
                                <th class="cachet-col-a">Modified</th>
                                <th class="cachet-col-b">SHA1 Changed</th>
                                <th class="cachet-col-status">Status</th>
                            </tr>
                        </thead>
                        <tbody>
                            @foreach (var item in modifiedItems)
                            {
                                <tr>
                                    <td>
                                        <input type="checkbox"
                                               checked="@selectedModifiedIds.Contains(item.FileId)"
                                               disabled="@(!selectedModifiedIds.Contains(item.FileId) && selectedModifiedIds.Count >= MaxSelection)"
                                               @onchange="@(e => ToggleSelection(selectedModifiedIds, item.FileId, (bool)e.Value!))" />
                                    </td>
                                    <td>
                                        <button type="button" class="cachet-cell-name cachet-file-link" title="Open @item.Name" @ref="fileLinkRefs[FileLinkKey(ModifiedPanel, item.FileId)]" @onclick="@(() => OpenFileViewer(item.FileIndexId, FileLinkKey(ModifiedPanel, item.FileId)))">@item.Name</button>
                                        <span class="cachet-cell-path" title="@item.Path">@item.Path</span>
                                    </td>
                                    <td>@item.ModifiedAt</td>
                                    <td>@(item.Sha1Changed ? "Yes" : "No")</td>
                                    <td><span class="@SyncChipClass(item.SyncStatus)">@item.SyncStatus</span></td>
                                </tr>
                            }
                        </tbody>
                    </table>
                }
            </div>

            @PanelFooter(ModifiedPanel, modifiedPaging, selectedModifiedIds)
        </section>
    </div>
</div>

@if (showPurgeConfirm)
{
    <div class="cachet-modal-backdrop cachet-modal-backdrop-top">
        <div class="cachet-confirm cachet-sync-modal" role="dialog" aria-modal="true">
            <h2 class="cachet-confirm-title">Purge from B2</h2>
            <p class="cachet-confirm-warning">
                This will permanently delete @purgeConfirmCount file(s) from Backblaze B2. This action
                cannot be undone.
            </p>
            <div class="cachet-confirm-actions">
                <button type="button" class="cachet-btn-danger" @onclick="ConfirmPurgeAsync">Confirm</button>
                <button type="button" class="cachet-btn" @onclick="CancelPurge">Cancel</button>
            </div>
        </div>
    </div>
}

@code {
    // CAS-030 §8.4: one config-bound interval (Worker:TaskManagerPollIntervalSeconds, default 10 s)
    // replaces CAS-023 §9's 5-second constant.
    private TimeSpan PollInterval => PollingOptions.Value.PollInterval;

    private const string GenericErrorMessage = "Something went wrong. Please try again.";
    private const string MirrorSyncFailedMessage = "The B2 mirror could not be refreshed automatically.";

    // CAS-030 §7 V7/V9, §8.3.
    private const string ScreenName = "ODriveSyncContentScan";
    private const string TaskTypeName = "ContentScan";
    private const string TaskNotFoundNotice = "That task could not be found.";
    private const string SessionExpiredMessage = "Your session has expired — sign in again to see results.";

    [Inject] private IHttpClientFactory HttpClientFactory { get; set; } = default!;
    [Inject] private ILogger<ODriveSyncContentScan> Logger { get; set; } = default!;
    [Inject] private IOptions<TaskPollingOptions> PollingOptions { get; set; } = default!;
    [Inject] private IConfiguration Configuration { get; set; } = default!;

    // CAS-045 §2.3/§9 V6/§14 Q3: cumulative-selection cap; mirrors Api Sync:MaxBatchSize (default 100).
    // The Api stays authoritative. A missing or non-positive value falls back to 100.
    private const int DefaultMaxSelection = 100;
    private int MaxSelection =>
        Configuration.GetValue<int?>("ODriveSync:MaxSelectionPerAction") is > 0 and var configured
            ? configured
            : DefaultMaxSelection;

    // CAS-045 §9 V1: the only page sizes offered (and ever sent).
    private static readonly int[] PageSizeOptions = { 25, 50, 100 };

    // CAS-030 §8.3 deep link. Bound as a string (the spec shows int?) so that a non-integer value
    // reaches V7's "not found" notice instead of failing Blazor's query-string binding.
    [SupplyParameterFromQuery(Name = "taskId")]
    public string? TaskId { get; set; }

    // CAS-030 §8.3/§8.5/V7/V9 state.
    private string? taskNotice;
    private bool sessionExpired;
    private string? failureDetail;
    // §8.5: set only for a scan resolved through GET /tasks[/{taskId}] with isAcknowledged=false;
    // cleared once the acknowledge is sent, so it is sent at most once per component instance.
    private int? ackEligibleTaskId;
    [CascadingParameter] private Task<AuthenticationState>? AuthenticationStateTask { get; set; }

    // CAS-023 §7 V5/§8: CachetFullAccess is exposed to this circuit as the "b2_capability" claim
    // (same claim MainLayout.razor already reads for the B2 Access badge, CAS-002 §6.4's
    // "Full Access" claim value backing the CachetFullAccess policy in Program.cs) — so, unlike the
    // task brief's caution, this capability IS reachable from the Blazor circuit without inventing
    // anything; no BLOCKED needed here.
    private bool hasFullAccess;

    // CAS-024 §3/§8.1: this page has no existing quarantine list of its own (unlike
    // KeywordSearch.razor's embedded panel), so the trigger button's badge count is sourced from
    // its own lightweight GET /quarantine fetch rather than a shared state service (§3 task note —
    // no shared state service beyond what's needed for this).
    private int quarantineCount;
    private QuarantineQueueModal? quarantineModal;

    // CAS-032 §8.1: opened via @ref from this page's report buttons.
    private ReportModal? reportModal;

    // CAS-031 §3: opened via @ref from this page's Audit Log button.
    private AuditLogModal? auditLogModal;

    // CAS-040 §8.2/§8.4: File Viewer state. The modal is open while viewerFileIndexId is not null;
    // focus returns to the clicked name button (tracked by panel + row key) on close.
    private int? viewerFileIndexId;
    private string? viewerReturnFocusKey;
    private readonly Dictionary<string, ElementReference> fileLinkRefs = new();

    // None | InProgress | Completed | Failed
    private string scanState = "None";
    private bool isScanInFlight;
    private int? scanTaskId;
    private DateTimeOffset? scanSubmittedAtUtc;
    private DateTimeOffset? scanCompletedAt;
    private int scanPollCount;
    private PeriodicTimer? scanPollTimer;
    private CancellationTokenSource? scanPollCts;

    private readonly List<NewOnODriveItem> newItems = new();
    private readonly List<RemovedFromODriveItem> removedItems = new();
    private readonly List<ModifiedOnODriveItem> modifiedItems = new();

    // CAS-045 §2.2: independent paging state per panel. TotalCount counts remaining (non-Synced) rows.
    private sealed class PanelPaging
    {
        public int Page = 1;
        public int PageSize = 50;
        public int TotalCount;
        public bool IsLoading;
        public bool HasError;
    }

    private readonly PanelPaging removedPaging = new();
    private readonly PanelPaging newPaging = new();
    private readonly PanelPaging modifiedPaging = new();

    private readonly HashSet<int> selectedNewIds = new();
    private readonly HashSet<int> selectedRemovedIds = new();
    private readonly HashSet<int> selectedModifiedIds = new();

    private bool showPurgeConfirm;
    private int purgeConfirmCount;

    private string? toastMessage;
    private string? scanErrorBanner;

    // CAS-023 §8.4: one independent poll loop per action type (Copy/Update/Purge — up to three
    // concurrent, plus the scan's own), tracked via a small per-file-type record of in-flight state.
    // A single private nested type used three times within this one file, not a new cross-file
    // abstraction (Karpathy P4).
    private sealed class ActionPollState
    {
        public bool IsInFlight;
        public PeriodicTimer? Timer;
        public CancellationTokenSource? Cts;
    }

    // Wireframe panel collapse (▾/▸) — display state only, per circuit.
    private const string RemovedPanel = "removed";
    private const string NewPanel = "new";
    private const string ModifiedPanel = "modified";
    private readonly HashSet<string> collapsedPanels = new();

    private readonly ActionPollState copyState = new();
    private readonly ActionPollState updateState = new();
    private readonly ActionPollState purgeState = new();

    protected override async Task OnInitializedAsync()
    {
        if (AuthenticationStateTask is not null)
        {
            var authState = await AuthenticationStateTask;
            hasFullAccess = string.Equals(
                authState.User.FindFirst("b2_capability")?.Value, "Full Access", StringComparison.Ordinal);
        }

        await LoadQuarantineCountAsync();
        // CAS-030 §8.3 supersedes CAS-027's deep-link polling: ReloadScanAsync handles ?taskId=.
        await ReloadScanAsync();
    }

    // CAS-030 §8.5: acknowledge only after the finished state has actually been rendered.
    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (ackEligibleTaskId is { } taskId
            && scanTaskId == taskId
            && !isScanInFlight
            && scanState is "Completed" or "Failed")
        {
            ackEligibleTaskId = null;
            await AcknowledgeAsync(taskId);
        }
    }

    // CAS-030 §8.3 (FR-21): reload the user's latest ContentScan, or the ?taskId= one. Reads
    // stored state only — never POST /sync/scan, never a new task, never B2.
    private async Task ReloadScanAsync()
    {
        var client = HttpClientFactory.CreateClient("CachetApi");
        var isDeepLink = TaskId is not null;
        int taskId;

        if (isDeepLink)
        {
            if (!int.TryParse(TaskId, System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out taskId)
                || taskId <= 0)
            {
                taskNotice = TaskNotFoundNotice;
                return;
            }
        }
        else
        {
            using var listResponse = await TryGetAsync(client, $"tasks?type={TaskTypeName}&page=1&pageSize=1", "GET /tasks");
            if (listResponse is null || !listResponse.IsSuccessStatusCode)
            {
                return;
            }

            var list = await listResponse.Content.ReadFromJsonAsync<PagedResult<TaskListItem>>();
            if (list is null || list.Items.Count == 0)
            {
                return;
            }

            taskId = list.Items[0].TaskId;
        }

        using var detailResponse = await TryGetAsync(client, $"tasks/{taskId}", "GET /tasks/{taskId}");
        if (detailResponse is null)
        {
            return;
        }

        TaskDetailResponse? task = null;
        if (detailResponse.IsSuccessStatusCode)
        {
            task = await detailResponse.Content.ReadFromJsonAsync<TaskDetailResponse>();
        }
        else if (detailResponse.StatusCode != System.Net.HttpStatusCode.NotFound)
        {
            Logger.LogWarning("{Component}: unexpected {StatusCode} from {Endpoint}", ScreenName, (int)detailResponse.StatusCode, "GET /tasks/{taskId}");
            return;
        }

        // §8.3: a Sync* task's own id is not a deep link — its results are the scan's rows (V7).
        if (task is null || !string.Equals(task.Type, TaskTypeName, StringComparison.Ordinal))
        {
            if (isDeepLink)
            {
                taskNotice = TaskNotFoundNotice;
            }

            return;
        }

        Logger.LogInformation("{Screen}: reloaded task {TaskId} with status {Status}", ScreenName, task.TaskId, task.Status);

        switch (task.Status)
        {
            case "Queued":
            case "Running":
                ackEligibleTaskId = task.IsAcknowledged ? null : task.TaskId;
                scanTaskId = task.TaskId;
                scanSubmittedAtUtc = task.SubmittedAt;
                isScanInFlight = true;
                scanState = "InProgress";
                scanPollCount = 0;
                _ = PollScanAsync(task.TaskId);
                break;

            case "Completed":
                ackEligibleTaskId = task.IsAcknowledged ? null : task.TaskId;
                scanCompletedAt = task.CompletedAt;
                await LoadCompletedScanAsync(client, task.TaskId);
                break;

            case "Failed":
                ackEligibleTaskId = task.IsAcknowledged ? null : task.TaskId;
                scanTaskId = task.TaskId;
                scanState = "Failed";
                failureDetail = task.ResultDetail;
                break;

            default:
                // Cancelled: no results to load — keep the empty initial state (§4, §8.2).
                break;
        }
    }

    private async Task LoadCompletedScanAsync(HttpClient client, int taskId)
    {
        using var response = await TryGetAsync(client, ResultsUri(taskId, RemovedPanel, NewPanel, ModifiedPanel), "GET /sync/{taskId}/results");
        if (response is null)
        {
            if (!sessionExpired)
            {
                scanErrorBanner = GenericErrorMessage;
            }

            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            Logger.LogWarning("ODriveSyncContentScan screen: unexpected {StatusCode} from {Endpoint}", (int)response.StatusCode, "GET /sync/{taskId}/results");
            scanErrorBanner = GenericErrorMessage;
            return;
        }

        var result = await response.Content.ReadFromJsonAsync<SyncScanResultsResponse>();
        if (result is null || !string.Equals(result.Status, "Completed", StringComparison.Ordinal))
        {
            scanErrorBanner = GenericErrorMessage;
            return;
        }

        scanTaskId = taskId;
        scanState = "Completed";
        ApplyResults(result);

        // §8.3: resume an in-progress Copy/Update/Purge. New → Copy, Modified → Update, Removed →
        // Purge. A scan writes every row as Pending before any action is submitted, so only resume
        // when the user's latest task of that action type is actually Queued/Running (and the panel
        // still has remaining rows); otherwise the rows stay selectable. CAS-045 §2.4: the resumed
        // poll watches that action task's own id, not the scan's result rows.
        await ResumePendingActionAsync(client, "SyncCopy", copyState, newPaging.TotalCount > 0);
        await ResumePendingActionAsync(client, "SyncUpdate", updateState, modifiedPaging.TotalCount > 0);
        await ResumePendingActionAsync(client, "SyncPurge", purgeState, removedPaging.TotalCount > 0);
    }

    // CAS-045 §2.1/§2.4: replaces all three panels from one results response (initial load only).
    private void ApplyResults(SyncScanResultsResponse result)
    {
        ApplyPanel(newItems, newPaging, result.NewOnODrive);
        ApplyPanel(removedItems, removedPaging, result.RemovedFromODrive);
        ApplyPanel(modifiedItems, modifiedPaging, result.ModifiedOnODrive);
    }

    private static void ApplyPanel<T>(List<T> items, PanelPaging paging, PagedResult<T>? slice)
    {
        items.Clear();
        items.AddRange(slice?.Items ?? Array.Empty<T>());
        paging.TotalCount = slice?.TotalCount ?? 0;
    }

    private static string QueryPrefix(string panel) => panel switch
    {
        RemovedPanel => "removedFromODrive",
        NewPanel => "newOnODrive",
        _ => "modifiedOnODrive"
    };

    private PanelPaging PagingFor(string panel) => panel switch
    {
        RemovedPanel => removedPaging,
        NewPanel => newPaging,
        _ => modifiedPaging
    };

    // CAS-045 §8.3: every results call sends excludeSynced=true plus each requested panel's own
    // page/pageSize (page sizes are always one of 25/50/100 — §9 V1).
    private string ResultsUri(int taskId, params string[] panels)
    {
        var query = new System.Text.StringBuilder("excludeSynced=true");
        foreach (var panel in panels)
        {
            var paging = PagingFor(panel);
            query.Append($"&{QueryPrefix(panel)}Page={paging.Page}&{QueryPrefix(panel)}PageSize={paging.PageSize}");
        }

        return $"sync/{taskId}/results?{query}";
    }

    private async Task ResumePendingActionAsync(HttpClient client, string actionType, ActionPollState state, bool panelHasRows)
    {
        if (!panelHasRows || await GetActiveTaskIdAsync(client, actionType) is not { } activeTaskId)
        {
            return;
        }

        state.IsInFlight = true;
        _ = PollActionAsync(actionType, activeTaskId, state);
    }

    // The user's most recent task of this type, when Queued/Running (GET /tasks is own-scoped,
    // newest first — CAS-030 §6).
    private async Task<int?> GetActiveTaskIdAsync(HttpClient client, string taskType)
    {
        using var response = await TryGetAsync(client, $"tasks?type={taskType}&page=1&pageSize=1", "GET /tasks");
        if (response is null || !response.IsSuccessStatusCode)
        {
            return null;
        }

        var list = await response.Content.ReadFromJsonAsync<PagedResult<TaskListItem>>();
        return list is { Items.Count: > 0 } && list.Items[0].Status is "Queued" or "Running"
            ? list.Items[0].TaskId
            : null;
    }

    // CAS-045 §2.2/§2.4: re-fetches ONLY the given panel's current page and replaces only that
    // panel's rows and TotalCount. Loading dims the rows; an error keeps the previous rows and
    // shows an inline retry. If the current page is now beyond the last page (rows shrank after an
    // action), clamps to the new last page and re-fetches once.
    private async Task LoadPanelAsync(string panel)
    {
        if (scanTaskId is not { } taskId)
        {
            return;
        }

        var paging = PagingFor(panel);
        paging.IsLoading = true;
        paging.HasError = false;
        await InvokeAsync(StateHasChanged);

        try
        {
            for (var attempt = 0; attempt < 2; attempt++)
            {
                var client = HttpClientFactory.CreateClient("CachetApi");
                using var response = await TryGetAsync(client, ResultsUri(taskId, panel), "GET /sync/{taskId}/results");
                if (response is null || !response.IsSuccessStatusCode)
                {
                    if (response is not null)
                    {
                        Logger.LogWarning("{Component}: unexpected {StatusCode} from {Endpoint}", ScreenName, (int)response.StatusCode, "GET /sync/{taskId}/results");
                    }

                    paging.HasError = true;
                    return;
                }

                var result = await response.Content.ReadFromJsonAsync<SyncScanResultsResponse>();
                if (result is null || !string.Equals(result.Status, "Completed", StringComparison.Ordinal))
                {
                    paging.HasError = true;
                    return;
                }

                var totalCount = panel switch
                {
                    RemovedPanel => result.RemovedFromODrive?.TotalCount ?? 0,
                    NewPanel => result.NewOnODrive?.TotalCount ?? 0,
                    _ => result.ModifiedOnODrive?.TotalCount ?? 0
                };
                var lastPage = Math.Max(1, (int)Math.Ceiling(totalCount / (double)paging.PageSize));
                if (paging.Page > lastPage && attempt == 0)
                {
                    paging.Page = lastPage;
                    continue;
                }

                switch (panel)
                {
                    case RemovedPanel: ApplyPanel(removedItems, paging, result.RemovedFromODrive); break;
                    case NewPanel: ApplyPanel(newItems, paging, result.NewOnODrive); break;
                    default: ApplyPanel(modifiedItems, paging, result.ModifiedOnODrive); break;
                }

                Logger.LogInformation(
                    "{Component}: loaded {Panel} page {Page} (size {PageSize}), TotalCount={TotalCount}",
                    ScreenName, panel, paging.Page, paging.PageSize, paging.TotalCount);
                return;
            }
        }
        finally
        {
            paging.IsLoading = false;
            await InvokeAsync(StateHasChanged);
        }
    }

    private async Task ChangePageAsync(string panel, int page)
    {
        PagingFor(panel).Page = page;
        await LoadPanelAsync(panel);
    }

    // §9 V1: any value outside 25/50/100 is ignored; a valid change resets that panel to page 1.
    private async Task ChangePageSizeAsync(string panel, ChangeEventArgs e)
    {
        if (!int.TryParse(e.Value?.ToString(), System.Globalization.NumberStyles.None, System.Globalization.CultureInfo.InvariantCulture, out var size)
            || !PageSizeOptions.Contains(size))
        {
            return;
        }

        var paging = PagingFor(panel);
        paging.PageSize = size;
        paging.Page = 1;
        await LoadPanelAsync(panel);
    }

    private static string RangeText(PanelPaging paging)
    {
        var from = (paging.Page - 1) * paging.PageSize + 1;
        var to = Math.Min(paging.Page * paging.PageSize, paging.TotalCount);
        return $"Showing {from:N0}–{to:N0} of {paging.TotalCount:N0}";
    }

    // CAS-045 §2.1–§2.3: footer = range text, page-size selector, pager, plus the cumulative
    // selection notice / Clear selection link. Hidden while there is nothing to show.
    private RenderFragment PanelFooter(string panel, PanelPaging paging, HashSet<int> selected) => @<text>
        @if (scanState == "Completed" && !sessionExpired && paging.TotalCount > 0)
        {
            <div class="cachet-sync-panel-footer">
                <span class="cachet-sync-range">@RangeText(paging)</span>
                <label class="cachet-sync-pagesize">
                    Rows per page
                    <select aria-label="Rows per page" disabled="@paging.IsLoading" @onchange="e => ChangePageSizeAsync(panel, e)">
                        @foreach (var size in PageSizeOptions)
                        {
                            <option value="@size" selected="@(size == paging.PageSize)">@size</option>
                        }
                    </select>
                </label>
                <Pager Page="paging.Page" PageSize="paging.PageSize" TotalCount="paging.TotalCount" IsLoading="paging.IsLoading" OnPageChanged="page => ChangePageAsync(panel, page)" />
                @if (selected.Count > 0)
                {
                    <button type="button" class="cachet-sync-clear-selection" @onclick="selected.Clear">Clear selection</button>
                }
                @if (selected.Count >= MaxSelection)
                {
                    <div class="cachet-sync-selection-notice" role="status">Up to @MaxSelection files can be submitted at once.</div>
                }
            </div>
        }
    </text>;

    /// <summary>
    /// CAS-030 §7 V9/V10 for the reload calls: <c>null</c> on a 401 (sets the session-expired
    /// state) or on a transient network failure (logged); otherwise the response.
    /// </summary>
    private async Task<HttpResponseMessage?> TryGetAsync(HttpClient client, string uri, string endpoint)
    {
        HttpResponseMessage response;
        try
        {
            response = await client.GetAsync(uri);
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("{Component}: transient poll failure on {Endpoint}", ScreenName, endpoint);
            return null;
        }

        if (response.StatusCode == System.Net.HttpStatusCode.Unauthorized)
        {
            Logger.LogWarning("{Component}: poll stopped on 401 from {Endpoint}", ScreenName, endpoint);
            sessionExpired = true;
            response.Dispose();
            return null;
        }

        return response;
    }

    // CAS-030 §8.5: failures are logged at Warning and never shown; the next open retries.
    private async Task AcknowledgeAsync(int taskId)
    {
        var client = HttpClientFactory.CreateClient("CachetApi");
        try
        {
            using var response = await client.PostAsync($"tasks/{taskId}/acknowledge", content: null);
            if (response.StatusCode != System.Net.HttpStatusCode.NoContent)
            {
                Logger.LogWarning("{Component}: acknowledge of task {TaskId} returned {StatusCode}", ScreenName, taskId, (int)response.StatusCode);
            }
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning("{Component}: acknowledge of task {TaskId} failed to reach the Api", ScreenName, taskId);
        }
    }

    // CAS-024 §3/§8.1: lightweight badge-count fetch — failures are logged and left silent (the
    // badge simply keeps its last-known count) rather than surfacing a banner on this page for a
    // capability this page does not otherwise use.
    private async Task LoadQuarantineCountAsync()
    {
        var client = HttpClientFactory.CreateClient("CachetApi");
        HttpResponseMessage response;
        try
        {
            response = await client.GetAsync("quarantine");
        }
        catch (Exception ex) when (ex is HttpRequestException or TaskCanceledException)
        {
            Logger.LogWarning(ex, "ODriveSyncContentScan screen: unable to reach Api for {Endpoint}", "GET /quarantine");
            return;
        }

        if (!response.IsSuccessStatusCode)
        {
            Logger.LogWarning("ODriveSyncContentScan screen: unexpected {StatusCode} from {Endpoint}", (int)response.StatusCode, "GET /quarantine");
            return;
        }

        var body = await response.Content.ReadFromJsonAsync<QuarantineListResponse>();
        quarantineCount = body?.TotalCount ?? 0;
    }

