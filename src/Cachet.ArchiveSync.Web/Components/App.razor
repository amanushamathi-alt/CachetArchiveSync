<!DOCTYPE html>
<html lang="en">

<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    @* Follows the app's PathBase so it works both at a site root (localhost:8066/) and under an
       IIS virtual application (e.g. /CachetArchiveSync/) — a fixed "/" sent every relative
       asset/link to the site root there. *@
    <base href="@($"{HttpContext?.Request.PathBase}/")" />
    <link rel="stylesheet" href="app.css" />
    <link rel="stylesheet" href="Cachet.ArchiveSync.Web.styles.css" />
    <HeadOutlet />
</head>

<body>
    <Routes />
    <script src="_framework/blazor.web.js"></script>
    <script src="js/panels.js"></script>
    <script src="js/download.js"></script>
    <script src="js/datepicker.js"></script>
</body>

</html>

@code {
    [CascadingParameter] private HttpContext? HttpContext { get; set; }
}
