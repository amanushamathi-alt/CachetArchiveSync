                        <FontWeight>=IIF(Fields!is_dormant.Value, "Bold", "Normal")</FontWeight>
                        </Style></TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs><Style><BackgroundColor>=IIF(Fields!is_dormant.Value, "#FAD7A0", IIF(RowNumber(Nothing) Mod 2 = 0, "#F7F9FC", "White"))</BackgroundColor>
