                        <FontFamily>Calibri</FontFamily><FontSize>9pt</FontSize><FontWeight>Bold</FontWeight>
                        </Style></TextRun></TextRuns><Style /></Paragraph></Paragraphs><Style><BackgroundColor>=IIF(Fields!is_dormant.Value, "#FFF8F0", IIF(RowNumber(Nothing) Mod 2 = 0, "#F7F9FC", "White"))</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft>
