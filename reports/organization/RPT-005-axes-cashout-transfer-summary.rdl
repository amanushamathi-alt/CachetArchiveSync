<?xml version="1.0" encoding="utf-8"?>
<!--
  RPT-005 — AXES Cashout Transfer Summary
  SSRS Report Definition Language (RDL)
  Spec: coding-agent/specs/web-reports/RPT-005-axes-cashout-transfer-summary.md
  Namespace: http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition
  Repository: reports/organization/RPT-005-axes-cashout-transfer-summary.rdl

  Deployment target: SSRS Web Portal → /GTW/GiftCards/RPT-005-AXES-Cashout-Transfer-Summary.rdl
  Data source: GTW_GiftCards_DS (Windows Integrated Security, ReadOnly, GiftCards DB)

  Role gate (enforced by calling portal before rendering URL):
    DAWN.usm.role.role_id IN (8=Owner, 9=Supervisor) WHERE role_type_id = 3

  Datasets:
    dsKPI               → gc.rpt_org_axes_transfer_kpi
    dsLocationSummary   → gc.rpt_org_axes_transfer_location_summary
    dsDetail            → gc.rpt_org_axes_transfer_detail
    dsOperators         → gc.rpt_org_operators_lst
    dsCashiers          → gc.rpt_location_cashiers_lst (org-wide mode via @organization_id)
    dsTransferTypes     → inline static dataset (3 rows: 0=All, 1=Auto, 2=Manual)

  Parameters (P1–P7):
    organization_id, from_date, to_date, operator_ids (multi), transfer_type,
    cashier_ids (multi, cascades from P5), min_amount

  Conditional formatting (Part B detail rows):
    is_reversed = True  → row bg #FDECEA, text/amount cells #E65100
    else                → alternating White / #F2F8FE

  Reversed banner (KPI section):
    Hidden = =IIF(First(Fields!reversed_count.Value, "dsKPI") = 0, True, False)

  Part B group subtotal expression (non-reversed only):
    =Sum(IIF(Fields!is_reversed.Value = False, Fields!amount.Value, CDec(0)), "OperatorGroup")

  Security:
    PII: cashier_display = first_name + ' ' + LEFT(LastName,1) + '.' (BR-10)
         customer_display = first_name + ' ' + last_initial + '.' (BR-8)
    No Vault JOIN, no PAN, no full last name, no phone, no DOB
    account_number from gc.gift_card_account — NOT a PAN
    org isolation via parent_organization_id JOIN (BR-1)
    ExecutionLog3 auto-audit (CC6.1, CC7.2, CC4.1, CC9.2)

  SVG design reference: reports-ui-design/RPT-005-axes-cashout-transfer-summary.svg
  TraceCounts / GTW Gift Card System — 2026-05-25
-->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">

  <!-- ══════════════════════════════════════════════════════════════════════
       REPORT PROPERTIES
  ══════════════════════════════════════════════════════════════════════════ -->
  <ReportID>RPT-005</ReportID>
  <Description>AXES Cashout Transfer Summary — Organisation-level AXES fund transfer reconciliation report. Owner and Supervisor access only.</Description>
  <Author>TraceCounts GTW System</Author>
  <AutoRefresh>0</AutoRefresh>
  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>

          <!-- ════════════════════════════════════════════════════════════
               REPORT HEADER BAND — #1A1A1A background, 1.0in high
          ════════════════════════════════════════════════════════════════ -->
          <Rectangle Name="ReportHeaderBand">
            <Style>
              <BackgroundColor>#1A1A1A</BackgroundColor>
            </Style>
            <Top>0in</Top>
            <Left>0in</Left>
            <Width>10.5in</Width>
            <Height>1.0in</Height>
            <ReportItems>
              <Textbox Name="TextboxTitle">
                <Value>AXES Cashout Transfer Summary</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>13pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <Color>White</Color>
                  <VerticalAlign>Middle</VerticalAlign>
                </Style>
                <Top>0.05in</Top>
                <Left>0.1in</Left>
                <Width>5.5in</Width>
                <Height>0.22in</Height>
                <CanGrow>false</CanGrow>
              </Textbox>
              <!-- Org name, period, timezone — pulled from dsKPI -->
              <Textbox Name="TextboxOrgLine">
                <Value>=First(Fields!org_name.Value, "dsKPI") &amp; "  ·  Period: " &amp; Format(Parameters!from_date.Value, "MM/dd/yyyy HH:mm") &amp; " – " &amp; Format(Parameters!to_date.Value, "MM/dd/yyyy HH:mm") &amp; "  ·  Transfer Type: " &amp; IIF(Parameters!transfer_type.Value = 0, "All Transfers", IIF(Parameters!transfer_type.Value = 1, "Auto Transfers (Type 8)", "Manual Transfers (Type 9)"))</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>8.5pt</FontSize>
                  <Color>#AAAAAA</Color>
                  <VerticalAlign>Middle</VerticalAlign>
                </Style>
                <DataSetName>dsKPI</DataSetName>
                <Top>0.29in</Top>
                <Left>0.1in</Left>
                <Width>6.5in</Width>
                <Height>0.17in</Height>
                <CanGrow>false</CanGrow>
              </Textbox>
              <Textbox Name="TextboxFiltersLine">
                <Value>="Filters: " &amp; IIF(Parameters!operator_ids.Count = 0, "All Operators", Parameters!operator_ids.Count &amp; " operator(s)") &amp; "  ·  Cashiers: " &amp; IIF(Parameters!cashier_ids.Count = 0, "All Cashiers", Parameters!cashier_ids.Count &amp; " cashier(s)") &amp; "  ·  Min Amount: $" &amp; Format(Parameters!min_amount.Value, "0.00")</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>8pt</FontSize>
                  <Color>#888888</Color>
                  <VerticalAlign>Middle</VerticalAlign>
                </Style>
                <Top>0.47in</Top>
                <Left>0.1in</Left>
                <Width>6.5in</Width>
                <Height>0.16in</Height>
                <CanGrow>false</CanGrow>
              </Textbox>
              <!-- Right-aligned run metadata -->
              <Textbox Name="TextboxGenerated">
                <Value>="Generated: " &amp; Format(Globals!ExecutionTime, "MM/dd/yyyy HH:mm") &amp; " UTC"</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>8.5pt</FontSize>
                  <Color>#AAAAAA</Color>
                  <TextAlign>Right</TextAlign>
                </Style>
                <Top>0.05in</Top>
                <Left>5.3in</Left>
                <Width>5.1in</Width>
                <Height>0.16in</Height>
                <CanGrow>false</CanGrow>
              </Textbox>
              <Textbox Name="TextboxUser">
                <Value>="By: " &amp; User!UserID</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>8.5pt</FontSize>
                  <Color>#AAAAAA</Color>
                  <TextAlign>Right</TextAlign>
                </Style>
                <Top>0.22in</Top>
                <Left>5.3in</Left>
                <Width>5.1in</Width>
                <Height>0.16in</Height>
                <CanGrow>false</CanGrow>
              </Textbox>
              <Textbox Name="TextboxReportID">
                <Value>Report ID: RPT-005  ·  SSRS Web Portal</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>8pt</FontSize>
                  <Color>#888888</Color>
                  <TextAlign>Right</TextAlign>
                </Style>
                <Top>0.39in</Top>
                <Left>5.3in</Left>
                <Width>5.1in</Width>
                <Height>0.14in</Height>
                <CanGrow>false</CanGrow>
              </Textbox>
            </ReportItems>
          </Rectangle>

          <!-- ════════════════════════════════════════════════════════════
               SECTION LABEL — KPI EXECUTIVE SUMMARY
          ════════════════════════════════════════════════════════════════ -->
          <Textbox Name="TextboxKpiSectionLabel">
            <Value>KPI — EXECUTIVE SUMMARY</Value>
            <Style>
              <FontFamily>Calibri</FontFamily>
              <FontSize>8.5pt</FontSize>
              <FontWeight>Bold</FontWeight>
              <Color>#1A1A1A</Color>
              <BackgroundColor>#D6E4F0</BackgroundColor>
              <VerticalAlign>Middle</VerticalAlign>
              <PaddingLeft>10pt</PaddingLeft>
            </Style>
            <Top>1.05in</Top>
            <Left>0in</Left>
            <Width>7in</Width>
            <Height>0.22in</Height>
          </Textbox>
          <Textbox Name="TextboxKpiDatasetLabel">
            <Value>dsKPI  ·  gc.rpt_org_axes_transfer_kpi</Value>
            <Style>
              <FontFamily>Calibri</FontFamily>
              <FontSize>7.5pt</FontSize>
              <Color>#555555</Color>
              <BackgroundColor>#D6E4F0</BackgroundColor>
              <TextAlign>Right</TextAlign>
              <VerticalAlign>Middle</VerticalAlign>
              <PaddingRight>8pt</PaddingRight>
            </Style>
            <Top>1.05in</Top>
            <Left>7in</Left>
            <Width>3.5in</Width>
            <Height>0.22in</Height>
          </Textbox>

          <!-- ════════════════════════════════════════════════════════════
               KPI TABLIX — dsKPI (single data row, 7 KPI tiles in 2 rows)
               Row 1: Total Transfers | Total Amount | Total Fees | Auto Transfers
               Row 2: Manual Transfers | Unique Accounts | Avg Transfer
               Rendered as tablix; tile style: white bg, left accent bar, #C8DBF0 border
          ════════════════════════════════════════════════════════════════ -->
          <Tablix Name="TablixKpiRow1">
            <DataSetName>dsKPI</DataSetName>
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>2.5in</Width></TablixColumn>  <!-- Total Transfers -->
                <TablixColumn><Width>2.5in</Width></TablixColumn>  <!-- Total Amount -->
                <TablixColumn><Width>2.5in</Width></TablixColumn>  <!-- Total Fees -->
                <TablixColumn><Width>3.0in</Width></TablixColumn>  <!-- Auto Transfers (wider) -->
              </TablixColumns>
              <TablixRows>
                <TablixRow>
                  <Height>1.0in</Height>
                  <TablixCells>

                    <!-- KPI 1: TOTAL TRANSFERS — accent #1A1A1A -->
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="KpiTile1">
                          <Style>
                            <BackgroundColor>White</BackgroundColor>
                            <BorderColor>#C8DBF0</BorderColor>
                            <BorderStyle>Solid</BorderStyle>
                            <BorderWidth>1.5pt</BorderWidth>
                          </Style>
                          <ReportItems>
                            <Rectangle Name="KpiTile1Accent">
                              <Style><BackgroundColor>#1A1A1A</BackgroundColor></Style>
                              <Top>0in</Top><Left>0in</Left>
                              <Width>0.07in</Width><Height>1.0in</Height>
                            </Rectangle>
                            <Textbox Name="KpiTile1Label">
                              <Value>TOTAL TRANSFERS</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                                <Color>#555555</Color><VerticalAlign>Middle</VerticalAlign>
                                <PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.1in</Top><Left>0.1in</Left>
                              <Width>2.35in</Width><Height>0.2in</Height>
                            </Textbox>
                            <Textbox Name="KpiTile1Value">
                              <Value>=Fields!total_transfer_count.Value</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>22pt</FontSize>
                                <FontWeight>Bold</FontWeight><Color>#1A1A1A</Color>
                                <Format>#,##0</Format><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.28in</Top><Left>0.1in</Left>
                              <Width>2.35in</Width><Height>0.42in</Height>
                            </Textbox>
                            <Textbox Name="KpiTile1Sub">
                              <Value>Non-reversed qualifying transactions</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize>
                                <Color>#888888</Color><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.72in</Top><Left>0.1in</Left>
                              <Width>2.35in</Width><Height>0.2in</Height>
                            </Textbox>
                          </ReportItems>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>

                    <!-- KPI 2: TOTAL AMOUNT — accent #375623 -->
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="KpiTile2">
                          <Style>
                            <BackgroundColor>White</BackgroundColor>
                            <BorderColor>#C8DBF0</BorderColor>
                            <BorderStyle>Solid</BorderStyle>
                            <BorderWidth>1.5pt</BorderWidth>
                          </Style>
                          <ReportItems>
                            <Rectangle Name="KpiTile2Accent">
                              <Style><BackgroundColor>#375623</BackgroundColor></Style>
                              <Top>0in</Top><Left>0in</Left>
                              <Width>0.07in</Width><Height>1.0in</Height>
                            </Rectangle>
                            <Textbox Name="KpiTile2Label">
                              <Value>TOTAL AMOUNT TRANSFERRED</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                                <Color>#555555</Color><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.1in</Top><Left>0.1in</Left>
                              <Width>2.35in</Width><Height>0.2in</Height>
                            </Textbox>
                            <Textbox Name="KpiTile2Value">
                              <Value>=Fields!total_amount_transferred.Value</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>22pt</FontSize>
                                <FontWeight>Bold</FontWeight><Color>#375623</Color>
                                <Format>$#,##0.00</Format><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.28in</Top><Left>0.1in</Left>
                              <Width>2.35in</Width><Height>0.42in</Height>
                            </Textbox>
                            <Textbox Name="KpiTile2Sub">
                              <Value>SUM(amount) — non-reversed only</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize>
                                <Color>#888888</Color><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.72in</Top><Left>0.1in</Left>
                              <Width>2.35in</Width><Height>0.2in</Height>
                            </Textbox>
                          </ReportItems>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>

                    <!-- KPI 3: TOTAL FEES — accent #833C00 -->
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="KpiTile3">
                          <Style>
                            <BackgroundColor>White</BackgroundColor>
                            <BorderColor>#C8DBF0</BorderColor>
                            <BorderStyle>Solid</BorderStyle>
                            <BorderWidth>1.5pt</BorderWidth>
                          </Style>
                          <ReportItems>
                            <Rectangle Name="KpiTile3Accent">
                              <Style><BackgroundColor>#833C00</BackgroundColor></Style>
                              <Top>0in</Top><Left>0in</Left>
                              <Width>0.07in</Width><Height>1.0in</Height>
                            </Rectangle>
                            <Textbox Name="KpiTile3Label">
                              <Value>TOTAL FEES</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                                <Color>#555555</Color><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.1in</Top><Left>0.1in</Left>
                              <Width>2.35in</Width><Height>0.2in</Height>
                            </Textbox>
                            <Textbox Name="KpiTile3Value">
                              <Value>=Fields!total_fees.Value</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>22pt</FontSize>
                                <FontWeight>Bold</FontWeight><Color>#833C00</Color>
                                <Format>$#,##0.00</Format><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.28in</Top><Left>0.1in</Left>
                              <Width>2.35in</Width><Height>0.42in</Height>
                            </Textbox>
                            <Textbox Name="KpiTile3Sub">
                              <Value>SUM(fee) — non-reversed only</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize>
                                <Color>#888888</Color><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.72in</Top><Left>0.1in</Left>
                              <Width>2.35in</Width><Height>0.2in</Height>
                            </Textbox>
                          </ReportItems>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>

                    <!-- KPI 4: AUTO TRANSFERS — accent #1A1A1A -->
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="KpiTile4">
                          <Style>
                            <BackgroundColor>White</BackgroundColor>
                            <BorderColor>#C8DBF0</BorderColor>
                            <BorderStyle>Solid</BorderStyle>
                            <BorderWidth>1.5pt</BorderWidth>
                          </Style>
                          <ReportItems>
                            <Rectangle Name="KpiTile4Accent">
                              <Style><BackgroundColor>#1A1A1A</BackgroundColor></Style>
                              <Top>0in</Top><Left>0in</Left>
                              <Width>0.07in</Width><Height>1.0in</Height>
                            </Rectangle>
                            <Textbox Name="KpiTile4Label">
                              <Value>AUTO TRANSFERS (TYPE 8)</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                                <Color>#555555</Color><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.1in</Top><Left>0.1in</Left>
                              <Width>2.85in</Width><Height>0.2in</Height>
                            </Textbox>
                            <Textbox Name="KpiTile4Value">
                              <Value>=Fields!auto_transfer_count.Value</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>22pt</FontSize>
                                <FontWeight>Bold</FontWeight><Color>#1A1A1A</Color>
                                <Format>#,##0</Format><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.28in</Top><Left>0.1in</Left>
                              <Width>2.85in</Width><Height>0.42in</Height>
                            </Textbox>
                            <Textbox Name="KpiTile4Sub">
                              <Value>=Format(Fields!auto_transfer_amount.Value, "$#,##0.00") &amp; "  ·  System-initiated (transaction_channel=3)"</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize>
                                <Color>#888888</Color><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.72in</Top><Left>0.1in</Left>
                              <Width>2.85in</Width><Height>0.2in</Height>
                            </Textbox>
                          </ReportItems>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>

                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>
            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember/><TablixMember/><TablixMember/><TablixMember/>
              </TablixMembers>
            </TablixColumnHierarchy>
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember>
                  <DataGroupName>KpiGroup1</DataGroupName>
                  <Group Name="KpiGroup1"/>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>
            <Top>1.3in</Top>
            <Left>0in</Left>
            <Width>10.5in</Width>
            <Height>1.0in</Height>
          </Tablix>

          <!-- KPI Row 2: Manual Transfers | Unique Accounts | Avg Transfer -->
          <Tablix Name="TablixKpiRow2">
            <DataSetName>dsKPI</DataSetName>
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>3.5in</Width></TablixColumn>  <!-- Manual Transfers (wider for sub-amount) -->
                <TablixColumn><Width>3.5in</Width></TablixColumn>  <!-- Unique Accounts -->
                <TablixColumn><Width>3.5in</Width></TablixColumn>  <!-- Avg Transfer -->
              </TablixColumns>
              <TablixRows>
                <TablixRow>
                  <Height>1.0in</Height>
                  <TablixCells>

                    <!-- KPI 5: MANUAL TRANSFERS — accent #1A1A1A -->
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="KpiTile5">
                          <Style>
                            <BackgroundColor>White</BackgroundColor>
                            <BorderColor>#C8DBF0</BorderColor>
                            <BorderStyle>Solid</BorderStyle>
                            <BorderWidth>1.5pt</BorderWidth>
                          </Style>
                          <ReportItems>
                            <Rectangle Name="KpiTile5Accent">
                              <Style><BackgroundColor>#1A1A1A</BackgroundColor></Style>
                              <Top>0in</Top><Left>0in</Left>
                              <Width>0.07in</Width><Height>1.0in</Height>
                            </Rectangle>
                            <Textbox Name="KpiTile5Label">
                              <Value>MANUAL TRANSFERS (TYPE 9)</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                                <Color>#555555</Color><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.1in</Top><Left>0.1in</Left>
                              <Width>3.35in</Width><Height>0.2in</Height>
                            </Textbox>
                            <Textbox Name="KpiTile5Value">
                              <Value>=Fields!manual_transfer_count.Value</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>22pt</FontSize>
                                <FontWeight>Bold</FontWeight><Color>#1A1A1A</Color>
                                <Format>#,##0</Format><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.28in</Top><Left>0.1in</Left>
                              <Width>3.35in</Width><Height>0.42in</Height>
                            </Textbox>
                            <Textbox Name="KpiTile5Sub">
                              <Value>=Format(Fields!manual_transfer_amount.Value, "$#,##0.00") &amp; "  ·  Cashier-initiated (GC-013 dual-txn)"</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize>
                                <Color>#888888</Color><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.72in</Top><Left>0.1in</Left>
                              <Width>3.35in</Width><Height>0.2in</Height>
                            </Textbox>
                          </ReportItems>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>

                    <!-- KPI 6: UNIQUE ACCOUNTS LOADED — accent #375623 -->
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="KpiTile6">
                          <Style>
                            <BackgroundColor>White</BackgroundColor>
                            <BorderColor>#C8DBF0</BorderColor>
                            <BorderStyle>Solid</BorderStyle>
                            <BorderWidth>1.5pt</BorderWidth>
                          </Style>
                          <ReportItems>
                            <Rectangle Name="KpiTile6Accent">
                              <Style><BackgroundColor>#375623</BackgroundColor></Style>
                              <Top>0in</Top><Left>0in</Left>
                              <Width>0.07in</Width><Height>1.0in</Height>
                            </Rectangle>
                            <Textbox Name="KpiTile6Label">
                              <Value>UNIQUE ACCOUNTS LOADED</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                                <Color>#555555</Color><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.1in</Top><Left>0.1in</Left>
                              <Width>3.35in</Width><Height>0.2in</Height>
                            </Textbox>
                            <Textbox Name="KpiTile6Value">
                              <Value>=Fields!unique_accounts_loaded.Value</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>22pt</FontSize>
                                <FontWeight>Bold</FontWeight><Color>#375623</Color>
                                <Format>#,##0</Format><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.28in</Top><Left>0.1in</Left>
                              <Width>3.35in</Width><Height>0.42in</Height>
                            </Textbox>
                            <Textbox Name="KpiTile6Sub">
                              <Value>COUNT(DISTINCT gift_card_account_id) — non-reversed</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize>
                                <Color>#888888</Color><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.72in</Top><Left>0.1in</Left>
                              <Width>3.35in</Width><Height>0.2in</Height>
                            </Textbox>
                          </ReportItems>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>

                    <!-- KPI 7: AVG TRANSFER AMOUNT — accent #375623 -->
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="KpiTile7">
                          <Style>
                            <BackgroundColor>White</BackgroundColor>
                            <BorderColor>#C8DBF0</BorderColor>
                            <BorderStyle>Solid</BorderStyle>
                            <BorderWidth>1.5pt</BorderWidth>
                          </Style>
                          <ReportItems>
                            <Rectangle Name="KpiTile7Accent">
                              <Style><BackgroundColor>#375623</BackgroundColor></Style>
                              <Top>0in</Top><Left>0in</Left>
                              <Width>0.07in</Width><Height>1.0in</Height>
                            </Rectangle>
                            <Textbox Name="KpiTile7Label">
                              <Value>AVG TRANSFER AMOUNT</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                                <Color>#555555</Color><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.1in</Top><Left>0.1in</Left>
                              <Width>3.35in</Width><Height>0.2in</Height>
                            </Textbox>
                            <Textbox Name="KpiTile7Value">
                              <Value>=Fields!avg_transfer_amount.Value</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>22pt</FontSize>
                                <FontWeight>Bold</FontWeight><Color>#375623</Color>
                                <Format>$#,##0.00</Format><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.28in</Top><Left>0.1in</Left>
                              <Width>3.35in</Width><Height>0.42in</Height>
                            </Textbox>
                            <Textbox Name="KpiTile7Sub">
                              <Value>SUM(amount) / COUNT(*) — non-reversed (BR-13)</Value>
                              <Style>
                                <FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize>
                                <Color>#888888</Color><PaddingLeft>4pt</PaddingLeft>
                              </Style>
                              <Top>0.72in</Top><Left>0.1in</Left>
                              <Width>3.35in</Width><Height>0.2in</Height>
                            </Textbox>
                          </ReportItems>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>

                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>
            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember/><TablixMember/><TablixMember/>
              </TablixMembers>
            </TablixColumnHierarchy>
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember>
                  <DataGroupName>KpiGroup2</DataGroupName>
                  <Group Name="KpiGroup2"/>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>
            <Top>2.35in</Top>
            <Left>0in</Left>
            <Width>10.5in</Width>
            <Height>1.0in</Height>
          </Tablix>

          <!-- ════════════════════════════════════════════════════════════
               REVERSED TRANSFERS BANNER
               Hidden when reversed_count = 0 (dsKPI field)
               Background: #FFF3CD (amber), border: #FFD073, text: #833C00
               Per §8.1 and §8.2: KPI reversed banner — visible expression
          ════════════════════════════════════════════════════════════════ -->
          <Rectangle Name="ReversedBanner">
            <Style>
              <BackgroundColor>#FFF3CD</BackgroundColor>
              <BorderColor>#FFD073</BorderColor>
              <BorderStyle>Solid</BorderStyle>
              <BorderWidth>1pt</BorderWidth>
            </Style>
            <Hidden>=IIF(First(Fields!reversed_count.Value, "dsKPI") = 0, True, False)</Hidden>
            <Top>3.4in</Top>
            <Left>0in</Left>
            <Width>10.5in</Width>
            <Height>0.3in</Height>
            <ReportItems>
              <Textbox Name="TextboxReversedBannerText">
                <Value>="⚠  " &amp; First(Fields!reversed_count.Value, "dsKPI") &amp; " reversed transfer(s) totalling " &amp; Format(First(Fields!reversed_amount.Value, "dsKPI"), "$#,##0.00") &amp; " are excluded from net totals above. They appear highlighted in the Detail section."</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>8pt</FontSize>
                  <Color>#833C00</Color>
                  <VerticalAlign>Middle</VerticalAlign>
                  <PaddingLeft>8pt</PaddingLeft>
                </Style>
                <Top>0.02in</Top>
                <Left>0in</Left>
                <Width>10.5in</Width>
                <Height>0.26in</Height>
                <CanGrow>false</CanGrow>
              </Textbox>
            </ReportItems>
          </Rectangle>

          <!-- ════════════════════════════════════════════════════════════
               SECTION LABEL — PART A LOCATION SUMMARY
          ════════════════════════════════════════════════════════════════ -->
          <Textbox Name="TextboxPartASectionLabel">
            <Value>PART A — LOCATION SUMMARY</Value>
            <Style>
              <FontFamily>Calibri</FontFamily><FontSize>8.5pt</FontSize>
              <FontWeight>Bold</FontWeight><Color>#1A1A1A</Color>
              <BackgroundColor>#D6E4F0</BackgroundColor>
              <VerticalAlign>Middle</VerticalAlign><PaddingLeft>10pt</PaddingLeft>
            </Style>
            <Top>3.75in</Top><Left>0in</Left>
            <Width>7in</Width><Height>0.22in</Height>
          </Textbox>
          <Textbox Name="TextboxPartADatasetLabel">
            <Value>dsLocationSummary  ·  gc.rpt_org_axes_transfer_location_summary</Value>
            <Style>
              <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
              <Color>#555555</Color><BackgroundColor>#D6E4F0</BackgroundColor>
              <TextAlign>Right</TextAlign><VerticalAlign>Middle</VerticalAlign>
              <PaddingRight>8pt</PaddingRight>
            </Style>
            <Top>3.75in</Top><Left>7in</Left>
            <Width>3.5in</Width><Height>0.22in</Height>
          </Textbox>

          <!-- ════════════════════════════════════════════════════════════
               PART A — LOCATION SUMMARY TABLIX
               One row per operator, no row groups (SP returns pre-aggregated rows)
               Columns: operator_display_name | auto_count | auto_amount |
                        manual_count | manual_amount | total_count | total_amount |
                        total_fees | avg_amount
               Grand Total footer row: SUM aggregates
               Sort: operator_display_name ASC (SP sorts)
               Reversed transactions EXCLUDED from all cells (SP filters, BR-4)
          ════════════════════════════════════════════════════════════════ -->
          <Tablix Name="TablixPartA">
            <DataSetName>dsLocationSummary</DataSetName>
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>2.2in</Width></TablixColumn>   <!-- Location -->
                <TablixColumn><Width>0.8in</Width></TablixColumn>   <!-- Auto Ct -->
                <TablixColumn><Width>1.2in</Width></TablixColumn>   <!-- Auto $ -->
                <TablixColumn><Width>0.8in</Width></TablixColumn>   <!-- Man Ct -->
                <TablixColumn><Width>1.2in</Width></TablixColumn>   <!-- Man $ -->
                <TablixColumn><Width>0.8in</Width></TablixColumn>   <!-- Total Ct -->
                <TablixColumn><Width>1.2in</Width></TablixColumn>   <!-- Total $ -->
                <TablixColumn><Width>1.0in</Width></TablixColumn>   <!-- Fees -->
                <TablixColumn><Width>1.3in</Width></TablixColumn>   <!-- Avg $ -->
              </TablixColumns>
              <TablixRows>
                <!-- Column header row -->
                <TablixRow>
                  <Height>0.25in</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="HdrALocation"><Value>Location</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HdrAAutoCt"><Value>Auto Ct</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HdrAAutoAmt"><Value>Auto $</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HdrAManCt"><Value>Man Ct</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HdrAManAmt"><Value>Man $</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HdrATotalCt"><Value>Total Ct</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HdrATotalAmt"><Value>Total $</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HdrAFees"><Value>Fees</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HdrAAvg"><Value>Avg $</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
                <!-- Data row — alternating row background -->
                <TablixRow>
                  <Height>0.22in</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="DataALocation">
                      <Value>=Fields!operator_display_name.Value</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#333333</Color>
                        <BackgroundColor>=IIF(RowNumber("OperatorSummaryGroup") Mod 2 = 0, "#F2F8FE", "White")</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="DataAAutoCt">
                      <Value>=Fields!auto_count.Value</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#333333</Color><Format>#,##0</Format><PaddingLeft>3pt</PaddingLeft>
                        <BackgroundColor>=IIF(RowNumber("OperatorSummaryGroup") Mod 2 = 0, "#F2F8FE", "White")</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="DataAAutoAmt">
                      <Value>=Fields!auto_amount.Value</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#333333</Color><Format>$#,##0.00</Format><PaddingLeft>3pt</PaddingLeft>
                        <BackgroundColor>=IIF(RowNumber("OperatorSummaryGroup") Mod 2 = 0, "#F2F8FE", "White")</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="DataAManCt">
                      <Value>=Fields!manual_count.Value</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#333333</Color><Format>#,##0</Format><PaddingLeft>3pt</PaddingLeft>
                        <BackgroundColor>=IIF(RowNumber("OperatorSummaryGroup") Mod 2 = 0, "#F2F8FE", "White")</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="DataAManAmt">
                      <Value>=Fields!manual_amount.Value</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#333333</Color><Format>$#,##0.00</Format><PaddingLeft>3pt</PaddingLeft>
                        <BackgroundColor>=IIF(RowNumber("OperatorSummaryGroup") Mod 2 = 0, "#F2F8FE", "White")</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="DataATotalCt">
                      <Value>=Fields!total_count.Value</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#333333</Color><Format>#,##0</Format><PaddingLeft>3pt</PaddingLeft>
                        <BackgroundColor>=IIF(RowNumber("OperatorSummaryGroup") Mod 2 = 0, "#F2F8FE", "White")</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="DataATotalAmt">
                      <Value>=Fields!total_amount.Value</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#333333</Color><Format>$#,##0.00</Format><PaddingLeft>3pt</PaddingLeft>
                        <BackgroundColor>=IIF(RowNumber("OperatorSummaryGroup") Mod 2 = 0, "#F2F8FE", "White")</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="DataAFees">
                      <Value>=Fields!total_fees.Value</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#333333</Color><Format>$#,##0.00</Format><PaddingLeft>3pt</PaddingLeft>
                        <BackgroundColor>=IIF(RowNumber("OperatorSummaryGroup") Mod 2 = 0, "#F2F8FE", "White")</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="DataAAvg">
                      <Value>=Fields!avg_amount.Value</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#333333</Color><Format>$#,##0.00</Format><PaddingLeft>3pt</PaddingLeft>
                        <BackgroundColor>=IIF(RowNumber("OperatorSummaryGroup") Mod 2 = 0, "#F2F8FE", "White")</BackgroundColor>
                        <VerticalAlign>Middle</VerticalAlign></Style>
                    </Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
                <!-- Grand Total row (#E2EFDA) -->
                <TablixRow>
                  <Height>0.25in</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="GrandTotalALabel">
                      <Value>Grand Total</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>8.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#375623</Color>
                        <BackgroundColor>#E2EFDA</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GrandTotalAAutoCt">
                      <Value>=Sum(Fields!auto_count.Value)</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#375623</Color>
                        <Format>#,##0</Format><BackgroundColor>#E2EFDA</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GrandTotalAAutoAmt">
                      <Value>=Sum(Fields!auto_amount.Value)</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#375623</Color>
                        <Format>$#,##0.00</Format><BackgroundColor>#E2EFDA</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GrandTotalAManCt">
                      <Value>=Sum(Fields!manual_count.Value)</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#375623</Color>
                        <Format>#,##0</Format><BackgroundColor>#E2EFDA</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GrandTotalAManAmt">
                      <Value>=Sum(Fields!manual_amount.Value)</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#375623</Color>
                        <Format>$#,##0.00</Format><BackgroundColor>#E2EFDA</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GrandTotalATotalCt">
                      <Value>=Sum(Fields!total_count.Value)</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#375623</Color>
                        <Format>#,##0</Format><BackgroundColor>#E2EFDA</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GrandTotalATotalAmt">
                      <Value>=Sum(Fields!total_amount.Value)</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#375623</Color>
                        <Format>$#,##0.00</Format><BackgroundColor>#E2EFDA</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GrandTotalAFees">
                      <Value>=Sum(Fields!total_fees.Value)</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#375623</Color>
                        <Format>$#,##0.00</Format><BackgroundColor>#E2EFDA</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style>
                    </Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="GrandTotalAAvg">
                      <!-- Avg from KPI tile (most accurate); fallback: Sum(total_amount)/Sum(total_count) -->
                      <Value>=IIF(Sum(Fields!total_count.Value) = 0, CDec(0), Sum(Fields!total_amount.Value) / Sum(Fields!total_count.Value))</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#375623</Color>
                        <Format>$#,##0.00</Format><BackgroundColor>#E2EFDA</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style>
                    </Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>
            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember/><TablixMember/><TablixMember/>
                <TablixMember/><TablixMember/><TablixMember/>
                <TablixMember/><TablixMember/><TablixMember/>
              </TablixMembers>
            </TablixColumnHierarchy>
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember/> <!-- Column header row (static) -->
                <TablixMember>  <!-- Data rows — one per operator, no grouping (SP pre-aggregates) -->
                  <DataGroupName>OperatorSummaryGroup</DataGroupName>
                  <Group Name="OperatorSummaryGroup">
                    <GroupExpressions>
                      <GroupExpression>=Fields!operator_id.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <SortExpressions>
                    <SortExpression>
                      <Value>=Fields!operator_display_name.Value</Value>
                      <Direction>Ascending</Direction>
                    </SortExpression>
                  </SortExpressions>
                </TablixMember>
                <TablixMember/> <!-- Grand Total row (static) -->
              </TablixMembers>
            </TablixRowHierarchy>
            <Top>4.0in</Top>
            <Left>0in</Left>
            <Width>10.5in</Width>
          </Tablix>

          <!-- ════════════════════════════════════════════════════════════
               SECTION LABEL — PART B TRANSFER DETAIL
          ════════════════════════════════════════════════════════════════ -->
          <Textbox Name="TextboxPartBSectionLabel">
            <Value>PART B — TRANSFER DETAIL  (grouped by Location, sorted Date/Time DESC)</Value>
            <Style>
              <FontFamily>Calibri</FontFamily><FontSize>8.5pt</FontSize>
              <FontWeight>Bold</FontWeight><Color>#1A1A1A</Color>
              <BackgroundColor>#D6E4F0</BackgroundColor>
              <VerticalAlign>Middle</VerticalAlign><PaddingLeft>10pt</PaddingLeft>
            </Style>
            <Top>5.4in</Top><Left>0in</Left>
            <Width>7in</Width><Height>0.22in</Height>
          </Textbox>
          <Textbox Name="TextboxPartBDatasetLabel">
            <Value>dsDetail  ·  gc.rpt_org_axes_transfer_detail</Value>
            <Style>
              <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
              <Color>#555555</Color><BackgroundColor>#D6E4F0</BackgroundColor>
              <TextAlign>Right</TextAlign><VerticalAlign>Middle</VerticalAlign>
              <PaddingRight>8pt</PaddingRight>
            </Style>
            <Top>5.4in</Top><Left>7in</Left>
            <Width>3.5in</Width><Height>0.22in</Height>
          </Textbox>

          <!-- ════════════════════════════════════════════════════════════
               PART B — TRANSFER DETAIL TABLIX
               Row group: operator_display_name (with group header row)
               Detail rows: one per AXES transfer transaction
               Sorted: operator_display_name ASC, transaction_date_local DESC

               Conditional row background (BR-4, §8.2):
                 is_reversed = True  → #FDECEA (red)
                 else                → alternating White / #F2F8FE

               Group subtotal footer (non-reversed amounts only):
                 =Sum(IIF(Fields!is_reversed.Value = False, Fields!amount.Value, CDec(0)), "OperatorGroup")

               Columns:
                 transaction_date_local | transfer_type_display | cashier_display |
                 customer_display | account_number | amount | fee | total_amount |
                 transaction_status_name
          ════════════════════════════════════════════════════════════════ -->
          <Tablix Name="TablixPartB">
            <DataSetName>dsDetail</DataSetName>
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>1.3in</Width></TablixColumn>   <!-- Date/Time (Local) -->
                <TablixColumn><Width>0.65in</Width></TablixColumn>  <!-- Type -->
                <TablixColumn><Width>1.2in</Width></TablixColumn>   <!-- Cashier -->
                <TablixColumn><Width>1.2in</Width></TablixColumn>   <!-- Customer -->
                <TablixColumn><Width>1.1in</Width></TablixColumn>   <!-- Account -->
                <TablixColumn><Width>0.85in</Width></TablixColumn>  <!-- Amt -->
                <TablixColumn><Width>0.7in</Width></TablixColumn>   <!-- Fee -->
                <TablixColumn><Width>0.95in</Width></TablixColumn>  <!-- Total -->
                <TablixColumn><Width>2.55in</Width></TablixColumn>  <!-- Status (wider; completes 10.5in) -->
              </TablixColumns>
              <TablixRows>
                <!-- Column header row -->
                <TablixRow>
                  <Height>0.22in</Height>
                  <TablixCells>
                    <TablixCell><CellContents><Textbox Name="HdrBDateTime"><Value>Date/Time (Local)</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HdrBType"><Value>Type</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HdrBCashier"><Value>Cashier</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HdrBCustomer"><Value>Customer</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HdrBAccount"><Value>Account</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HdrBAmt"><Value>Amt</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HdrBFee"><Value>Fee</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HdrBTotal"><Value>Total</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                    <TablixCell><CellContents><Textbox Name="HdrBStatus"><Value>Status</Value>
                      <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>White</Color><BackgroundColor>#1A1A1A</BackgroundColor><VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft></Style></Textbox></CellContents></TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- Group header row — operator location name -->
                <TablixRow>
                  <Height>0.2in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBGroupHeader">
                          <!-- Spans all 9 columns (ColSpan=9) -->
                          <Value>="▼  " &amp; Fields!operator_display_name.Value</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>9pt</FontSize>
                            <FontWeight>Bold</FontWeight><Color>#1A1A1A</Color>
                            <BackgroundColor>#D6E4F0</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign><PaddingLeft>6pt</PaddingLeft>
                          </Style>
                          <ColSpan>9</ColSpan>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- Detail data row — conditional background: reversed=#FDECEA, else alt White/#F2F8FE -->
                <TablixRow>
                  <Height>0.2in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBDateTime">
                          <Value>=Format(Fields!transaction_date_local.Value, "MM/dd/yyyy HH:mm")</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                            <Color>=IIF(Fields!is_reversed.Value = True, "#E65100", "#333333")</Color>
                            <PaddingLeft>3pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign>
                            <BackgroundColor>=IIF(Fields!is_reversed.Value = True, "#FDECEA", IIF(RowNumber(Nothing) Mod 2 = 0, "#F2F8FE", "White"))</BackgroundColor>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBType">
                          <Value>=Fields!transfer_type_display.Value</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                            <Color>=IIF(Fields!is_reversed.Value = True, "#E65100", "#333333")</Color>
                            <PaddingLeft>3pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign>
                            <BackgroundColor>=IIF(Fields!is_reversed.Value = True, "#FDECEA", IIF(RowNumber(Nothing) Mod 2 = 0, "#F2F8FE", "White"))</BackgroundColor>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <!-- cashier_display is NULL for type 8 (Auto); render dash via IIF -->
                        <Textbox Name="DataBCashier">
                          <Value>=IIF(IsNothing(Fields!cashier_display.Value), "—", Fields!cashier_display.Value)</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                            <Color>=IIF(Fields!is_reversed.Value = True, "#E65100", IIF(IsNothing(Fields!cashier_display.Value), "#CCCCCC", "#333333"))</Color>
                            <PaddingLeft>3pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign>
                            <BackgroundColor>=IIF(Fields!is_reversed.Value = True, "#FDECEA", IIF(RowNumber(Nothing) Mod 2 = 0, "#F2F8FE", "White"))</BackgroundColor>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBCustomer">
                          <!-- customer_display = first_name + ' ' + last_initial + '.' — BR-8 -->
                          <Value>=Fields!customer_display.Value</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                            <Color>=IIF(Fields!is_reversed.Value = True, "#E65100", "#333333")</Color>
                            <PaddingLeft>3pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign>
                            <BackgroundColor>=IIF(Fields!is_reversed.Value = True, "#FDECEA", IIF(RowNumber(Nothing) Mod 2 = 0, "#F2F8FE", "White"))</BackgroundColor>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <!-- account_number = gc.gift_card_account.account_number — NOT a PAN (§11) -->
                        <Textbox Name="DataBAccount">
                          <Value>=Fields!account_number.Value</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                            <Color>=IIF(Fields!is_reversed.Value = True, "#E65100", "#333333")</Color>
                            <PaddingLeft>3pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign>
                            <BackgroundColor>=IIF(Fields!is_reversed.Value = True, "#FDECEA", IIF(RowNumber(Nothing) Mod 2 = 0, "#F2F8FE", "White"))</BackgroundColor>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBAmt">
                          <Value>=Fields!amount.Value</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                            <Color>=IIF(Fields!is_reversed.Value = True, "#E65100", "#333333")</Color>
                            <Format>$#,##0.00</Format><PaddingLeft>3pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign>
                            <BackgroundColor>=IIF(Fields!is_reversed.Value = True, "#FDECEA", IIF(RowNumber(Nothing) Mod 2 = 0, "#F2F8FE", "White"))</BackgroundColor>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBFee">
                          <Value>=Fields!fee.Value</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                            <Color>=IIF(Fields!is_reversed.Value = True, "#E65100", "#333333")</Color>
                            <Format>$#,##0.00</Format><PaddingLeft>3pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign>
                            <BackgroundColor>=IIF(Fields!is_reversed.Value = True, "#FDECEA", IIF(RowNumber(Nothing) Mod 2 = 0, "#F2F8FE", "White"))</BackgroundColor>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBTotalAmt">
                          <Value>=Fields!total_amount.Value</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                            <Color>=IIF(Fields!is_reversed.Value = True, "#E65100", "#333333")</Color>
                            <Format>$#,##0.00</Format><PaddingLeft>3pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign>
                            <BackgroundColor>=IIF(Fields!is_reversed.Value = True, "#FDECEA", IIF(RowNumber(Nothing) Mod 2 = 0, "#F2F8FE", "White"))</BackgroundColor>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBStatus">
                          <Value>=Fields!transaction_status_name.Value</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                            <!-- Approved = green, Reversed = orange/red, others = default -->
                            <Color>=IIF(Fields!is_reversed.Value = True, "#E65100", IIF(Fields!transaction_status_name.Value = "Approved", "#2E7D32", "#333333"))</Color>
                            <PaddingLeft>3pt</PaddingLeft><VerticalAlign>Middle</VerticalAlign>
                            <BackgroundColor>=IIF(Fields!is_reversed.Value = True, "#FDECEA", IIF(RowNumber(Nothing) Mod 2 = 0, "#F2F8FE", "White"))</BackgroundColor>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- Location subtotal footer row (group footer) — non-reversed only (SC-8) -->
                <TablixRow>
                  <Height>0.22in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBSubtotalLabel">
                          <!-- Spans columns 1–5; ColSpan=5 -->
                          <Value>=Fields!operator_display_name.Value &amp; " Subtotal (non-reversed)  —  " &amp; Sum(IIF(Fields!is_reversed.Value = False, 1, 0), "OperatorGroup") &amp; " transfer(s)"</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                            <FontWeight>Bold</FontWeight><Color>#375623</Color>
                            <BackgroundColor>#E2EFDA</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft>
                          </Style>
                          <ColSpan>5</ColSpan>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <!-- Non-reversed amount only: SC-8 -->
                        <Textbox Name="DataBSubtotalAmt">
                          <Value>=Sum(IIF(Fields!is_reversed.Value = False, Fields!amount.Value, CDec(0)), "OperatorGroup")</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                            <FontWeight>Bold</FontWeight><Color>#375623</Color>
                            <BackgroundColor>#E2EFDA</BackgroundColor>
                            <Format>$#,##0.00</Format>
                            <VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBSubtotalFee">
                          <Value>=Sum(IIF(Fields!is_reversed.Value = False, Fields!fee.Value, CDec(0)), "OperatorGroup")</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                            <FontWeight>Bold</FontWeight><Color>#375623</Color>
                            <BackgroundColor>#E2EFDA</BackgroundColor>
                            <Format>$#,##0.00</Format>
                            <VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBSubtotalTotal">
                          <Value>=Sum(IIF(Fields!is_reversed.Value = False, Fields!total_amount.Value, CDec(0)), "OperatorGroup")</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
                            <FontWeight>Bold</FontWeight><Color>#375623</Color>
                            <BackgroundColor>#E2EFDA</BackgroundColor>
                            <Format>$#,##0.00</Format>
                            <VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBSubtotalPad">
                          <Value></Value>
                          <Style><BackgroundColor>#E2EFDA</BackgroundColor></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>

                <!-- Report grand total row -->
                <TablixRow>
                  <Height>0.26in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBGrandTotalLabel">
                          <Value>="Report Grand Total (non-reversed)  —  " &amp; Sum(IIF(Fields!is_reversed.Value = False, 1, 0)) &amp; " transfer(s)"</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>9pt</FontSize>
                            <FontWeight>Bold</FontWeight><Color>#375623</Color>
                            <BackgroundColor>#E2EFDA</BackgroundColor>
                            <VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft>
                          </Style>
                          <ColSpan>5</ColSpan>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBGrandTotalAmt">
                          <Value>=Sum(IIF(Fields!is_reversed.Value = False, Fields!amount.Value, CDec(0)))</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>9pt</FontSize>
                            <FontWeight>Bold</FontWeight><Color>#375623</Color>
                            <BackgroundColor>#E2EFDA</BackgroundColor>
                            <Format>$#,##0.00</Format>
                            <VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBGrandTotalFee">
                          <Value>=Sum(IIF(Fields!is_reversed.Value = False, Fields!fee.Value, CDec(0)))</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>9pt</FontSize>
                            <FontWeight>Bold</FontWeight><Color>#375623</Color>
                            <BackgroundColor>#E2EFDA</BackgroundColor>
                            <Format>$#,##0.00</Format>
                            <VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBGrandTotalTotal">
                          <Value>=Sum(IIF(Fields!is_reversed.Value = False, Fields!total_amount.Value, CDec(0)))</Value>
                          <Style>
                            <FontFamily>Calibri</FontFamily><FontSize>9pt</FontSize>
                            <FontWeight>Bold</FontWeight><Color>#375623</Color>
                            <BackgroundColor>#E2EFDA</BackgroundColor>
                            <Format>$#,##0.00</Format>
                            <VerticalAlign>Middle</VerticalAlign><PaddingLeft>3pt</PaddingLeft>
                          </Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="DataBGrandTotalPad">
                          <Value></Value>
                          <Style><BackgroundColor>#E2EFDA</BackgroundColor></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>

              </TablixRows>
            </TablixBody>

            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember/><TablixMember/><TablixMember/>
                <TablixMember/><TablixMember/><TablixMember/>
                <TablixMember/><TablixMember/><TablixMember/>
              </TablixMembers>
            </TablixColumnHierarchy>

            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember/> <!-- Column header row (static) -->
                <TablixMember>  <!-- Operator group: header + detail + subtotal -->
                  <DataGroupName>OperatorGroup</DataGroupName>
                  <Group Name="OperatorGroup">
                    <GroupExpressions>
                      <GroupExpression>=Fields!operator_display_name.Value</GroupExpression>
                    </GroupExpressions>
                  </Group>
                  <SortExpressions>
                    <SortExpression>
                      <Value>=Fields!operator_display_name.Value</Value>
                      <Direction>Ascending</Direction>
                    </SortExpression>
                  </SortExpressions>
                  <TablixMembers>
                    <!-- Group header row -->
                    <TablixMember>
                      <KeepWithGroup>After</KeepWithGroup>
                      <RepeatOnNewPage>true</RepeatOnNewPage>
                    </TablixMember>
                    <!-- Detail rows — sorted transaction_date_local DESC (BR-4, §8.1) -->
                    <TablixMember>
                      <DataGroupName>DetailGroup</DataGroupName>
                      <Group Name="DetailGroup"/>
                      <SortExpressions>
                        <SortExpression>
                          <Value>=Fields!transaction_date_local.Value</Value>
                          <Direction>Descending</Direction>
                        </SortExpression>
                      </SortExpressions>
                    </TablixMember>
                    <!-- Group subtotal footer -->
                    <TablixMember>
                      <KeepWithGroup>Before</KeepWithGroup>
                    </TablixMember>
                  </TablixMembers>
                </TablixMember>
                <!-- Grand total row (static) -->
                <TablixMember/>
              </TablixMembers>
            </TablixRowHierarchy>

            <Top>5.65in</Top>
            <Left>0in</Left>
            <Width>10.5in</Width>
          </Tablix>

          <!-- Detail footnote — PII note -->
          <Textbox Name="TextboxDetailNote">
            <Value>Reversed transfers are highlighted in red. Grand totals exclude reversed amounts. Cashier display = first_name + last_initial + '.' (BR-10). Customer display = first_name + last_initial + '.' (BR-8). Auto transfers (type 8) have no cashier — displayed as dash. account_number is gc.gift_card_account.account_number, NOT a PAN. No Vault JOIN.</Value>
            <Style>
              <FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize>
              <Color>#888888</Color><FontStyle>Italic</FontStyle>
            </Style>
            <Top>8.5in</Top><Left>0in</Left>
            <Width>10.5in</Width><Height>0.2in</Height>
            <CanGrow>false</CanGrow>
          </Textbox>

        </ReportItems>
        <Height>8.75in</Height>
        <Style/>
      </Body>
      <Width>10.5in</Width>
      <Page>
        <PageWidth>11in</PageWidth>
        <PageHeight>8.5in</PageHeight>
        <LeftMargin>0.25in</LeftMargin>
        <RightMargin>0.25in</RightMargin>
        <TopMargin>0.25in</TopMargin>
        <BottomMargin>0.25in</BottomMargin>
        <Style/>
      </Page>

      <!-- ════════════════════════════════════════════════════════════════
           PAGE HEADER (repeats on every page)
      ════════════════════════════════════════════════════════════════════ -->
      <PageHeader>
        <Height>0.4in</Height>
        <PrintOnFirstPage>true</PrintOnFirstPage>
        <PrintOnLastPage>true</PrintOnLastPage>
        <ReportItems>
          <Textbox Name="PageHdrTitle">
            <Value>AXES Cashout Transfer Summary  —  RPT-005</Value>
            <Style>
              <FontFamily>Calibri</FontFamily><FontSize>9pt</FontSize>
              <FontWeight>Bold</FontWeight><Color>#1A1A1A</Color>
              <VerticalAlign>Middle</VerticalAlign>
            </Style>
            <Top>0.04in</Top><Left>0in</Left>
            <Width>5in</Width><Height>0.2in</Height>
            <CanGrow>false</CanGrow>
          </Textbox>
          <Textbox Name="PageHdrOrg">
            <Value>=First(Fields!org_name.Value, "dsKPI") &amp; "  ·  " &amp; Format(Parameters!from_date.Value, "MM/dd/yyyy") &amp; " – " &amp; Format(Parameters!to_date.Value, "MM/dd/yyyy")</Value>
            <DataSetName>dsKPI</DataSetName>
            <Style>
              <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
              <Color>#555555</Color><VerticalAlign>Middle</VerticalAlign>
            </Style>
            <Top>0.24in</Top><Left>0in</Left>
            <Width>6in</Width><Height>0.14in</Height>
            <CanGrow>false</CanGrow>
          </Textbox>
          <Textbox Name="PageHdrRuntime">
            <Value>="Generated: " &amp; Format(Globals!ExecutionTime, "MM/dd/yyyy HH:mm") &amp; " UTC"</Value>
            <Style>
              <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
              <Color>#888888</Color><TextAlign>Right</TextAlign>
            </Style>
            <Top>0.04in</Top><Left>6.5in</Left>
            <Width>4in</Width><Height>0.14in</Height>
            <CanGrow>false</CanGrow>
          </Textbox>
        </ReportItems>
        <Style/>
      </PageHeader>

      <!-- ════════════════════════════════════════════════════════════════
           PAGE FOOTER (repeats on every page)
           Page X of Y  |  CONFIDENTIAL  |  PII and disclaimer note
      ════════════════════════════════════════════════════════════════════ -->
      <PageFooter>
        <Height>0.45in</Height>
        <PrintOnFirstPage>true</PrintOnFirstPage>
        <PrintOnLastPage>true</PrintOnLastPage>
        <ReportItems>

          <!-- Left: Page X of Y -->
          <Textbox Name="FooterPageNum">
            <Value>="Page " &amp; Globals!PageNumber &amp; " of " &amp; Globals!TotalPages</Value>
            <Style>
              <FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize>
              <Color>#888888</Color><BackgroundColor>#F5F5F5</BackgroundColor>
              <VerticalAlign>Middle</VerticalAlign>
              <BorderColor><Bottom>#DDDDDD</Bottom></BorderColor>
              <BorderStyle><Bottom>Solid</Bottom></BorderStyle>
            </Style>
            <Top>0.05in</Top><Left>0in</Left>
            <Width>2in</Width><Height>0.22in</Height>
            <CanGrow>false</CanGrow>
          </Textbox>

          <!-- Centre: CONFIDENTIAL -->
          <Textbox Name="FooterConfidential">
            <Value>CONFIDENTIAL</Value>
            <Style>
              <FontFamily>Calibri</FontFamily><FontSize>8.5pt</FontSize>
              <FontWeight>Bold</FontWeight><Color>#CC0000</Color>
              <BackgroundColor>#F5F5F5</BackgroundColor>
              <TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign>
              <BorderColor><Bottom>#DDDDDD</Bottom></BorderColor>
              <BorderStyle><Bottom>Solid</Bottom></BorderStyle>
            </Style>
            <Top>0.05in</Top><Left>3.5in</Left>
            <Width>3.5in</Width><Height>0.22in</Height>
            <CanGrow>false</CanGrow>
          </Textbox>

          <!-- Right: PII note -->
          <Textbox Name="FooterPiiNote">
            <Value>This report contains minimised PII — not for public disclosure</Value>
            <Style>
              <FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize>
              <Color>#888888</Color><BackgroundColor>#F5F5F5</BackgroundColor>
              <TextAlign>Right</TextAlign><VerticalAlign>Middle</VerticalAlign>
              <BorderColor><Bottom>#DDDDDD</Bottom></BorderColor>
              <BorderStyle><Bottom>Solid</Bottom></BorderStyle>
            </Style>
            <Top>0.05in</Top><Left>7.5in</Left>
            <Width>3in</Width><Height>0.22in</Height>
            <CanGrow>false</CanGrow>
          </Textbox>

          <!-- Second line: reconciliation disclaimer -->
          <Textbox Name="FooterDisclaimer">
            <Value>Reversed transfers highlighted in red. Grand totals exclude reversed amounts.</Value>
            <Style>
              <FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize>
              <Color>#888888</Color><BackgroundColor>#F5F5F5</BackgroundColor>
              <TextAlign>Center</TextAlign><VerticalAlign>Middle</VerticalAlign>
              <FontStyle>Italic</FontStyle>
            </Style>
            <Top>0.29in</Top><Left>0in</Left>
            <Width>10.5in</Width><Height>0.14in</Height>
            <CanGrow>false</CanGrow>
          </Textbox>

        </ReportItems>
        <Style>
          <BackgroundColor>#F5F5F5</BackgroundColor>
          <BorderColor><Top>#DDDDDD</Top></BorderColor>
          <BorderStyle><Top>Solid</Top></BorderStyle>
        </Style>
      </PageFooter>

    </ReportSection>
  </ReportSections>

  <!-- ══════════════════════════════════════════════════════════════════════
       DATA SOURCES
  ══════════════════════════════════════════════════════════════════════════ -->
  <DataSources>
    <!-- Shared data source from RPT-001; reuse if already deployed -->
    <DataSource Name="GTW_GiftCards_DS">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=&lt;sql-server-hostname&gt;;Initial Catalog=GiftCards;Integrated Security=True;ApplicationIntent=ReadOnly</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
        <Prompt></Prompt>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
      <rd:DataSourceID>GTW_GiftCards_DS</rd:DataSourceID>
    </DataSource>
  </DataSources>

  <!-- ══════════════════════════════════════════════════════════════════════
       DATA SETS
  ══════════════════════════════════════════════════════════════════════════ -->
  <DataSets>

    <!-- dsKPI — returns single wide row of KPI metrics (§7.1)
         Non-reversed totals + reversed_count/reversed_amount
         Used by KPI tiles and reversed banner visibility expression -->
    <DataSet Name="dsKPI">
      <Query>
        <DataSourceName>GTW_GiftCards_DS</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>gc.rpt_org_axes_transfer_kpi</CommandText>
        <QueryParameters>
          <QueryParameter Name="@organization_id">
            <Value>=Parameters!organization_id.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@from_date">
            <Value>=Parameters!from_date.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@to_date">
            <Value>=Parameters!to_date.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@operator_ids">
            <Value>=IIF(Parameters!operator_ids.Count = 0, Nothing, Join(Parameters!operator_ids.Value, ","))</Value>
          </QueryParameter>
          <QueryParameter Name="@transfer_type">
            <Value>=Parameters!transfer_type.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@cashier_ids">
            <!-- BR-9: cashier filter ignored when transfer_type = 1 (Auto) -->
            <Value>=IIF(Parameters!transfer_type.Value = 1, Nothing, IIF(Parameters!cashier_ids.Count = 0, Nothing, Join(Parameters!cashier_ids.Value, ",")))</Value>
          </QueryParameter>
          <QueryParameter Name="@min_amount">
            <Value>=Parameters!min_amount.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="total_transfer_count"><DataField>total_transfer_count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="total_amount_transferred"><DataField>total_amount_transferred</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="total_fees"><DataField>total_fees</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="auto_transfer_count"><DataField>auto_transfer_count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="auto_transfer_amount"><DataField>auto_transfer_amount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="manual_transfer_count"><DataField>manual_transfer_count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="manual_transfer_amount"><DataField>manual_transfer_amount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="unique_accounts_loaded"><DataField>unique_accounts_loaded</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="avg_transfer_amount"><DataField>avg_transfer_amount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="reversed_count"><DataField>reversed_count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="reversed_amount"><DataField>reversed_amount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <!-- org_name sourced from dsKPI for header display -->
        <Field Name="org_name"><DataField>org_name</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>

    <!-- dsLocationSummary — one row per operator, Part A (§7.2)
         Reversed transactions excluded from all cells (BR-4)
         Sorted operator_display_name ASC -->
    <DataSet Name="dsLocationSummary">
      <Query>
        <DataSourceName>GTW_GiftCards_DS</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>gc.rpt_org_axes_transfer_location_summary</CommandText>
        <QueryParameters>
          <QueryParameter Name="@organization_id"><Value>=Parameters!organization_id.Value</Value></QueryParameter>
          <QueryParameter Name="@from_date"><Value>=Parameters!from_date.Value</Value></QueryParameter>
          <QueryParameter Name="@to_date"><Value>=Parameters!to_date.Value</Value></QueryParameter>
          <QueryParameter Name="@operator_ids"><Value>=IIF(Parameters!operator_ids.Count = 0, Nothing, Join(Parameters!operator_ids.Value, ","))</Value></QueryParameter>
          <QueryParameter Name="@transfer_type"><Value>=Parameters!transfer_type.Value</Value></QueryParameter>
          <QueryParameter Name="@cashier_ids"><Value>=IIF(Parameters!transfer_type.Value = 1, Nothing, IIF(Parameters!cashier_ids.Count = 0, Nothing, Join(Parameters!cashier_ids.Value, ",")))</Value></QueryParameter>
          <QueryParameter Name="@min_amount"><Value>=Parameters!min_amount.Value</Value></QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="operator_id"><DataField>operator_id</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="operator_display_name"><DataField>operator_display_name</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="auto_count"><DataField>auto_count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="auto_amount"><DataField>auto_amount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="manual_count"><DataField>manual_count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="manual_amount"><DataField>manual_amount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="total_count"><DataField>total_count</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="total_amount"><DataField>total_amount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="total_fees"><DataField>total_fees</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="avg_amount"><DataField>avg_amount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
      </Fields>
    </DataSet>

    <!-- dsDetail — one row per AXES transfer transaction, Part B (§7.3)
         Includes reversed rows (is_reversed=1 flag) — BR-4
         cashier_display NULL for type 8 (Auto) — BR-7, BR-10
         account_number = gc.gift_card_account.account_number (NOT PAN) — §11
         Sorted operator_display_name ASC, transaction_date_local DESC -->
    <DataSet Name="dsDetail">
      <Query>
        <DataSourceName>GTW_GiftCards_DS</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>gc.rpt_org_axes_transfer_detail</CommandText>
        <QueryParameters>
          <QueryParameter Name="@organization_id"><Value>=Parameters!organization_id.Value</Value></QueryParameter>
          <QueryParameter Name="@from_date"><Value>=Parameters!from_date.Value</Value></QueryParameter>
          <QueryParameter Name="@to_date"><Value>=Parameters!to_date.Value</Value></QueryParameter>
          <QueryParameter Name="@operator_ids"><Value>=IIF(Parameters!operator_ids.Count = 0, Nothing, Join(Parameters!operator_ids.Value, ","))</Value></QueryParameter>
          <QueryParameter Name="@transfer_type"><Value>=Parameters!transfer_type.Value</Value></QueryParameter>
          <QueryParameter Name="@cashier_ids"><Value>=IIF(Parameters!transfer_type.Value = 1, Nothing, IIF(Parameters!cashier_ids.Count = 0, Nothing, Join(Parameters!cashier_ids.Value, ",")))</Value></QueryParameter>
          <QueryParameter Name="@min_amount"><Value>=Parameters!min_amount.Value</Value></QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="transaction_id"><DataField>transaction_id</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <Field Name="transaction_reference_number"><DataField>transaction_reference_number</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="transaction_date_local"><DataField>transaction_date_local</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
        <Field Name="operator_id"><DataField>operator_id</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="operator_display_name"><DataField>operator_display_name</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="terminal_name"><DataField>terminal_name</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="transfer_type_display"><DataField>transfer_type_display</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <!-- cashier_display: NULL for type 8; CONCAT(first_name, ' ', LEFT(LastName,1), '.') for type 9 — BR-7, BR-10 -->
        <Field Name="cashier_display"><DataField>cashier_display</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <!-- customer_display: CONCAT(first_name, ' ', last_initial, '.') — BR-8 -->
        <Field Name="customer_display"><DataField>customer_display</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <!-- account_number: gc.gift_card_account.account_number — NOT a PAN -->
        <Field Name="account_number"><DataField>account_number</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="amount"><DataField>amount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="fee"><DataField>fee</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="total_amount"><DataField>total_amount</DataField><rd:TypeName>System.Decimal</rd:TypeName></Field>
        <Field Name="transaction_status_name"><DataField>transaction_status_name</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <!-- is_reversed: CASE WHEN transaction_status = 3 THEN 1 ELSE 0 END — BR-4 -->
        <Field Name="is_reversed"><DataField>is_reversed</DataField><rd:TypeName>System.Boolean</rd:TypeName></Field>
        <Field Name="correlation_id"><DataField>correlation_id</DataField><rd:TypeName>System.Guid</rd:TypeName></Field>
        <Field Name="axes_transfer_id"><DataField>axes_transfer_id</DataField><rd:TypeName>System.Int64</rd:TypeName></Field>
        <!-- axes_reference_number: pending Q1 resolution for gc.axes_transfer columns -->
        <Field Name="axes_reference_number"><DataField>axes_reference_number</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="axes_player_id"><DataField>axes_player_id</DataField><rd:TypeName>System.String</rd:TypeName></Field>
        <Field Name="axes_timestamp"><DataField>axes_timestamp</DataField><rd:TypeName>System.DateTime</rd:TypeName></Field>
      </Fields>
    </DataSet>

    <!-- dsOperators — populates P4 operator_ids multi-select (§7.5, reused from RPT-001) -->
    <DataSet Name="dsOperators">
      <Query>
        <DataSourceName>GTW_GiftCards_DS</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>gc.rpt_org_operators_lst</CommandText>
        <QueryParameters>
          <QueryParameter Name="@organization_id">
            <Value>=Parameters!organization_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="operator_id"><DataField>operator_id</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="display_name"><DataField>display_name</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>

    <!-- dsCashiers — populates P6 cashier_ids multi-select (§7.4 extended SP)
         Called in org-wide mode with @organization_id parameter
         BR-9: only visible/applied when transfer_type IN (0, 2) — not for Auto-only -->
    <DataSet Name="dsCashiers">
      <Query>
        <DataSourceName>GTW_GiftCards_DS</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <!-- Extended gc.rpt_location_cashiers_lst with @organization_id for org-wide mode (§7.4) -->
        <CommandText>gc.rpt_location_cashiers_lst</CommandText>
        <QueryParameters>
          <!-- Pass @organization_id (org-wide mode); @operator_id defaults to NULL -->
          <QueryParameter Name="@organization_id">
            <Value>=Parameters!organization_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="cashier_id"><DataField>cashier_id</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="display_name"><DataField>display_name</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>

    <!-- dsTransferTypes — static inline dataset for P5 transfer_type dropdown (§8.3) -->
    <DataSet Name="dsTransferTypes">
      <Query>
        <DataSourceName>GTW_GiftCards_DS</DataSourceName>
        <CommandType>Text</CommandType>
        <!-- Static 3-row lookup; no actual DB call semantics — uses literal VALUES -->
        <CommandText>SELECT type_value, type_label FROM (VALUES
  (0, N'All Transfers'),
  (1, N'Auto Transfers (System — Type 8)'),
  (2, N'Manual Transfers (Cashier-initiated — Type 9)')
) AS t(type_value, type_label)
ORDER BY type_value</CommandText>
      </Query>
      <Fields>
        <Field Name="type_value"><DataField>type_value</DataField><rd:TypeName>System.Int32</rd:TypeName></Field>
        <Field Name="type_label"><DataField>type_label</DataField><rd:TypeName>System.String</rd:TypeName></Field>
      </Fields>
    </DataSet>

  </DataSets>

  <!-- ══════════════════════════════════════════════════════════════════════
       PARAMETERS  (P1–P7, in dependency order)
       P1 → P4 (dsOperators cascades); P5 → P6 (dsCashiers visibility)
       P2, P3, P7 are independent
  ══════════════════════════════════════════════════════════════════════════ -->
  <ReportParameters>

    <!-- P1: organization_id — hidden in S2S mode; enforces row-level org isolation in all SPs -->
    <ReportParameter Name="organization_id">
      <DataType>Integer</DataType>
      <Nullable>false</Nullable>
      <AllowBlank>false</AllowBlank>
      <MultiValue>false</MultiValue>
      <Hidden>false</Hidden>
      <Prompt>Organization ID</Prompt>
      <!-- Note: set Hidden=true in S2S deployment; calling portal enforces role_id IN (8,9) -->
    </ReportParameter>

    <!-- P2: from_date — date/time picker, defaults to first day of current month -->
    <ReportParameter Name="from_date">
      <DataType>DateTime</DataType>
      <Nullable>false</Nullable>
      <AllowBlank>false</AllowBlank>
      <MultiValue>false</MultiValue>
      <DefaultValue>
        <!-- First day of current month at 00:00:00 -->
        <Values>
          <Value>=DateSerial(Year(Today()), Month(Today()), 1)</Value>
        </Values>
      </DefaultValue>
      <Prompt>From Date (local)</Prompt>
      <!-- V1: SP enforces DATEDIFF(DAY, @from_date, @to_date) <= 365 -->
      <!-- V2: SP enforces @from_date <= @to_date -->
    </ReportParameter>

    <!-- P3: to_date — date/time picker, defaults to today -->
    <ReportParameter Name="to_date">
      <DataType>DateTime</DataType>
      <Nullable>false</Nullable>
      <AllowBlank>false</AllowBlank>
      <MultiValue>false</MultiValue>
      <DefaultValue>
        <Values>
          <Value>=Today()</Value>
        </Values>
      </DefaultValue>
      <Prompt>To Date (local)</Prompt>
    </ReportParameter>

    <!-- P4: operator_ids — multi-select, cascades from P1 via dsOperators -->
    <ReportParameter Name="operator_ids">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <MultiValue>true</MultiValue>
      <DefaultValue>
        <!-- Default: all operators for the org -->
        <DataSetReference>
          <DataSetName>dsOperators</DataSetName>
          <ValueField>operator_id</ValueField>
        </DataSetReference>
      </DefaultValue>
      <ValidValues>
        <DataSetReference>
          <DataSetName>dsOperators</DataSetName>
          <ValueField>operator_id</ValueField>
          <LabelField>display_name</LabelField>
        </DataSetReference>
      </ValidValues>
      <Prompt>Operator(s)</Prompt>
    </ReportParameter>

    <!-- P5: transfer_type — single-select dropdown, default 0 (All Transfers) -->
    <ReportParameter Name="transfer_type">
      <DataType>Integer</DataType>
      <Nullable>false</Nullable>
      <AllowBlank>false</AllowBlank>
      <MultiValue>false</MultiValue>
      <DefaultValue>
        <Values>
          <Value>0</Value>
        </Values>
      </DefaultValue>
      <ValidValues>
        <DataSetReference>
          <DataSetName>dsTransferTypes</DataSetName>
          <ValueField>type_value</ValueField>
          <LabelField>type_label</LabelField>
        </DataSetReference>
      </ValidValues>
      <Prompt>Transfer Type</Prompt>
      <!-- V8: SP treats values outside {0,1,2} as 0 (All) -->
    </ReportParameter>

    <!-- P6: cashier_ids — multi-select, cascades from P5
         BR-9: only meaningful when transfer_type IN (0,2); parameter is still offered
         but cashier filter is suppressed in all three SPs when transfer_type = 1 -->
    <ReportParameter Name="cashier_ids">
      <DataType>String</DataType>
      <Nullable>true</Nullable>
      <AllowBlank>true</AllowBlank>
      <MultiValue>true</MultiValue>
      <DefaultValue>
        <!-- Default: all cashiers in the org -->
        <DataSetReference>
          <DataSetName>dsCashiers</DataSetName>
          <ValueField>cashier_id</ValueField>
        </DataSetReference>
      </DefaultValue>
      <ValidValues>
        <DataSetReference>
          <DataSetName>dsCashiers</DataSetName>
          <ValueField>cashier_id</ValueField>
          <LabelField>display_name</LabelField>
        </DataSetReference>
      </ValidValues>
      <!-- Hide when transfer_type = 1 (Auto only — no cashier attribution) -->
      <Hidden>=IIF(Parameters!transfer_type.Value = 1, True, False)</Hidden>
      <Prompt>Cashier(s)</Prompt>
    </ReportParameter>

    <!-- P7: min_amount — decimal text input, default 0.00 -->
    <ReportParameter Name="min_amount">
      <DataType>Float</DataType>
      <Nullable>false</Nullable>
      <AllowBlank>false</AllowBlank>
      <MultiValue>false</MultiValue>
      <DefaultValue>
        <Values>
          <Value>0.00</Value>
        </Values>
      </DefaultValue>
      <Prompt>Min Amount ($)</Prompt>
      <!-- V3: SP enforces @min_amount >= 0; RAISERROR if negative -->
    </ReportParameter>

  </ReportParameters>

  <!-- ══════════════════════════════════════════════════════════════════════
       REPORT LANGUAGE / LOCALIZATION
  ══════════════════════════════════════════════════════════════════════════ -->
  <Language>en-US</Language>
  <ConsumeContainerWhitespace>true</ConsumeContainerWhitespace>

</Report>
