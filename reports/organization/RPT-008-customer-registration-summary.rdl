<?xml version="1.0" encoding="utf-8"?>
<!--
  RPT-008 — Customer Registration Summary
  SSRS Report Definition Language (RDL)
  Spec: coding-agent/specs/web-reports/RPT-008-customer-registration-summary.md
  Namespace: http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition
  Repository: reports/organization/RPT-008-customer-registration-summary.rdl

  Page: A4 Landscape (11.69in × 8.27in), 10mm (0.394in) margins, body width = 10.9in
  Deployment target: SSRS Web Portal → /GTW/GiftCards/RPT-008-Customer-Registration-Summary.rdl
  Data source: GTW_GiftCards_DS (Windows Integrated Security, ReadOnly, GiftCards DB)

  Role gate (enforced by calling portal before rendering URL):
    DAWN.usm.role.role_id IN (8=Owner, 9=Supervisor) WHERE role_type_id = 3

  Datasets:
    dsKPI        → gc.rpt_org_customer_registration_kpi
    dsActivity   → gc.rpt_org_customer_registration_activity
    dsDetail     → gc.rpt_org_customer_registration_detail
    dsOperators  → gc.rpt_org_operators_lst  (shared SP from RPT-001)

  Parameters (P1–P5):
    organization_id, from_date, to_date, operator_ids (multi), include_incomplete_only

  KPI Row 1 (4 tiles @ 2.725in): New Registrations | Physical Card | Virtual Card | Both Cards
  KPI Row 2 (3 tiles @ 3.633/3.634in): Phone Verified | ID Verified | PIN Set
  Part A: 8 columns, flat table, ORGANISATION TOTAL sentinel row (green highlight)
  Part B: 7 columns, grouped by operator, amber rows = incomplete onboarding

  Layout (direct body children, A4 Landscape, all absolute positions):
    ReportHeaderBand       : Top=0in,      Height=0.688in
    TextboxKpiSectionLabel : Top=0.698in,  Height=0.22in
    TablixKpiRow1          : Top=0.938in,  Height=0.88in
    TablixKpiRow2          : Top=1.858in,  Height=0.88in
    TextboxPartASectionLabel : Top=2.778in, Height=0.22in
    TablixPartA            : Top=3.018in,  Height=1.21in  (grows)
    TextboxPartBSectionLabel : Top=4.248in, Height=0.22in  (pushed down as PartA grows)
    TablixPartB            : Top=4.488in   (grows)

  Column widths (Part A, sum = 10.9in):
    Location 2.910 | New Reg 0.934 | Txns 0.934 | Dep.Count 0.934
    Dep.Amount 1.400 | W/D Count 0.934 | W/D Amount 1.400 | Avg Balance 1.454

  Column widths (Part B, sum = 10.9in):
    Reg Date 2.100 | Customer 2.410 | Card Type 1.150 | Phone 1.048
    ID 1.048 | PIN 1.048 | Initial Load 2.096

  Security: PII minimised — customer_display = first_name + ' ' + last_initial + '.' only.
            No phone, DOB, PAN, full name, customer_id in any output column.
            No Vault JOIN. No gc.customer_kyc reference anywhere.
            ExecutionLog3 auto-audit (SOC 2 CC6.1/CC7.2/CC4.1).

  TraceCounts / GTW Gift Card System — 2026-06-05
-->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">

  <ReportID>RPT-008</ReportID>
  <Description>Customer Registration Summary — Organisation-level new customer onboarding volume, card type mix, onboarding completeness (phone/ID/PIN) and financial activity per location. Owner and Supervisor access only. No KYC. No PAN. No full name.</Description>
  <Author>TraceCounts GTW System</Author>
  <AutoRefresh>0</AutoRefresh>

  <ReportSections>
    <ReportSection>
      <Body>
        <ReportItems>

          <!-- ════════════════════════════════════════════════════════════
               REPORT HEADER BAND — #1A1A1A background, 0.688in high
          ════════════════════════════════════════════════════════════════ -->
          <Rectangle Name="ReportHeaderBand">
            <Style>
              <BackgroundColor>#1A1A1A</BackgroundColor>
            </Style>
            <Top>0in</Top>
            <Left>0in</Left>
            <Width>10.9in</Width>
            <Height>0.688in</Height>
            <ReportItems>
              <Textbox Name="TextboxTitle">
                <Value>Customer Registration Summary</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>13pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                  <Color>#FFFFFF</Color>
                  <VerticalAlign>Middle</VerticalAlign>
                </Style>
                <Top>0.05in</Top>
                <Left>0.1in</Left>
                <Width>6.5in</Width>
                <Height>0.22in</Height>
                <CanGrow>false</CanGrow>
              </Textbox>
              <Textbox Name="TextboxOrgLine">
                <Value>=First(Fields!org_name.Value, "dsKPI") &amp; "  ·  Period: " &amp; Format(Parameters!from_date.Value, "MM/dd/yyyy") &amp; " – " &amp; Format(Parameters!to_date.Value, "MM/dd/yyyy") &amp; "  (" &amp; First(Fields!org_windows_timezone_id.Value, "dsKPI") &amp; ")"</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>8.5pt</FontSize>
                  <Color>#AAAAAA</Color>
                  <VerticalAlign>Middle</VerticalAlign>
                </Style>
                <DataSetName>dsKPI</DataSetName>
                <Top>0.30in</Top>
                <Left>0.1in</Left>
                <Width>7.0in</Width>
                <Height>0.17in</Height>
                <CanGrow>false</CanGrow>
              </Textbox>
              <Textbox Name="TextboxFiltersLine">
                <Value>="Operators: " &amp; IIF(Parameters!operator_ids.Count = 0, "All", CStr(Parameters!operator_ids.Count) &amp; " selected") &amp; "  ·  Filter: " &amp; IIF(Parameters!include_incomplete_only.Value, "Incomplete Only", "All Registrations")</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>8pt</FontSize>
                  <Color>#888888</Color>
                  <VerticalAlign>Middle</VerticalAlign>
                </Style>
                <Top>0.48in</Top>
                <Left>0.1in</Left>
                <Width>7.0in</Width>
                <Height>0.16in</Height>
                <CanGrow>false</CanGrow>
              </Textbox>
              <Textbox Name="TextboxGenerated">
                <Value>="Generated: " &amp; Format(Globals!ExecutionTime, "MM/dd/yyyy HH:mm") &amp; " UTC"</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>8.5pt</FontSize>
                  <Color>#AAAAAA</Color>
                  <TextAlign>Right</TextAlign>
                </Style>
                <Top>0.05in</Top>
                <Left>7.2in</Left>
                <Width>3.6in</Width>
                <Height>0.16in</Height>
                <CanGrow>false</CanGrow>
              </Textbox>
              <Textbox Name="TextboxUser">
                <Value>="By: " &amp; User!UserID</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>8.5pt</FontSize>
                  <Color>#AAAAAA</Color>
                  <TextAlign>Right</TextAlign>
                </Style>
                <Top>0.22in</Top>
                <Left>7.2in</Left>
                <Width>3.6in</Width>
                <Height>0.16in</Height>
                <CanGrow>false</CanGrow>
              </Textbox>
              <Textbox Name="TextboxReportID">
                <Value>Report ID: RPT-008  ·  SSRS Web Portal</Value>
                <Style>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>8pt</FontSize>
                  <Color>#888888</Color>
                  <TextAlign>Right</TextAlign>
                </Style>
                <Top>0.39in</Top>
                <Left>7.2in</Left>
                <Width>3.6in</Width>
                <Height>0.14in</Height>
                <CanGrow>false</CanGrow>
              </Textbox>
            </ReportItems>
          </Rectangle>

          <!-- ════════════════════════════════════════════════════════════
               SECTION LABEL — KPI EXECUTIVE SUMMARY
          ════════════════════════════════════════════════════════════════ -->
          <Textbox Name="TextboxKpiSectionLabel">
            <Value>KPI — EXECUTIVE SUMMARY</Value>
            <Style>
              <FontFamily>Calibri</FontFamily>
              <FontSize>8.5pt</FontSize>
              <FontWeight>Bold</FontWeight>
              <Color>#1A1A1A</Color>
              <BackgroundColor>#D6E4F0</BackgroundColor>
              <VerticalAlign>Middle</VerticalAlign>
              <PaddingLeft>10pt</PaddingLeft>
            </Style>
            <Top>0.698in</Top>
            <Left>0in</Left>
            <Width>7.5in</Width>
            <Height>0.22in</Height>
          </Textbox>
          <Textbox Name="TextboxKpiDatasetLabel">
            <Value>dsKPI  ·  gc.rpt_org_customer_registration_kpi</Value>
            <Style>
              <FontFamily>Calibri</FontFamily>
              <FontSize>7.5pt</FontSize>
              <Color>#555555</Color>
              <BackgroundColor>#D6E4F0</BackgroundColor>
              <TextAlign>Right</TextAlign>
              <VerticalAlign>Middle</VerticalAlign>
              <PaddingRight>8pt</PaddingRight>
            </Style>
            <Top>0.698in</Top>
            <Left>7.5in</Left>
            <Width>3.4in</Width>
            <Height>0.22in</Height>
          </Textbox>

          <!-- ════════════════════════════════════════════════════════════
               KPI ROW 1 — 4 tiles: New Reg | Physical Card | Virtual Card | Both Cards
               Each tile = 2.725in wide × 0.88in tall
          ════════════════════════════════════════════════════════════════ -->
          <Tablix Name="TablixKpiRow1">
            <DataSetName>dsKPI</DataSetName>
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>2.725in</Width></TablixColumn>
                <TablixColumn><Width>2.725in</Width></TablixColumn>
                <TablixColumn><Width>2.725in</Width></TablixColumn>
                <TablixColumn><Width>2.725in</Width></TablixColumn>
              </TablixColumns>
              <TablixRows>
                <TablixRow>
                  <Height>0.88in</Height>
                  <TablixCells>

                    <!-- T1: NEW REGISTRATIONS — accent #1A1A1A, count only -->
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="KpiTile1">
                          <Style>
                            <BackgroundColor>#FFFFFF</BackgroundColor>
                            <BorderColor>#C8DBF0</BorderColor>
                            <BorderStyle>Solid</BorderStyle>
                            <BorderWidth>1.5pt</BorderWidth>
                          </Style>
                          <ReportItems>
                            <Rectangle Name="KpiTile1Accent">
                              <Style><BackgroundColor>#1A1A1A</BackgroundColor></Style>
                              <Top>0in</Top><Left>0in</Left>
                              <Width>0.07in</Width><Height>0.88in</Height>
                            </Rectangle>
                            <Textbox Name="KpiTile1Label">
                              <Value>NEW REGISTRATIONS</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#555555</Color><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.04in</Top><Left>0.1in</Left>
                              <Width>2.575in</Width><Height>0.17in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                            <Textbox Name="KpiTile1Value">
                              <Value>=Fields!new_registrations_count.Value</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight><Color>#1A1A1A</Color><Format>#,##0</Format><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.23in</Top><Left>0.1in</Left>
                              <Width>2.575in</Width><Height>0.35in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                            <Textbox Name="KpiTile1Sub">
                              <Value>New customer accounts created in date range</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#888888</Color><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.62in</Top><Left>0.1in</Left>
                              <Width>2.575in</Width><Height>0.22in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                          </ReportItems>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>

                    <!-- T2: PHYSICAL CARD — accent #1F3864 -->
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="KpiTile2">
                          <Style>
                            <BackgroundColor>#FFFFFF</BackgroundColor>
                            <BorderColor>#C8DBF0</BorderColor>
                            <BorderStyle>Solid</BorderStyle>
                            <BorderWidth>1.5pt</BorderWidth>
                          </Style>
                          <ReportItems>
                            <Rectangle Name="KpiTile2Accent">
                              <Style><BackgroundColor>#1F3864</BackgroundColor></Style>
                              <Top>0in</Top><Left>0in</Left>
                              <Width>0.07in</Width><Height>0.88in</Height>
                            </Rectangle>
                            <Textbox Name="KpiTile2Label">
                              <Value>PHYSICAL CARD</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#555555</Color><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.04in</Top><Left>0.1in</Left>
                              <Width>2.575in</Width><Height>0.17in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                            <Textbox Name="KpiTile2Value">
                              <Value>=Fields!physical_card_count.Value</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight><Color>#1F3864</Color><Format>#,##0</Format><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.23in</Top><Left>0.1in</Left>
                              <Width>2.575in</Width><Height>0.28in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                            <Textbox Name="KpiTile2Pct">
                              <Value>=IIF(IsNothing(Fields!physical_card_pct.Value), "N/A", Format(CDbl(Fields!physical_card_pct.Value), "0.0") &amp; "% of new registrations")</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><Color>#1F3864</Color><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.53in</Top><Left>0.1in</Left>
                              <Width>2.575in</Width><Height>0.17in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                            <Textbox Name="KpiTile2Sub">
                              <Value>use_physical_card = 1</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#888888</Color><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.71in</Top><Left>0.1in</Left>
                              <Width>2.575in</Width><Height>0.15in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                          </ReportItems>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>

                    <!-- T3: VIRTUAL CARD — accent #375623 -->
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="KpiTile3">
                          <Style>
                            <BackgroundColor>#FFFFFF</BackgroundColor>
                            <BorderColor>#C8DBF0</BorderColor>
                            <BorderStyle>Solid</BorderStyle>
                            <BorderWidth>1.5pt</BorderWidth>
                          </Style>
                          <ReportItems>
                            <Rectangle Name="KpiTile3Accent">
                              <Style><BackgroundColor>#375623</BackgroundColor></Style>
                              <Top>0in</Top><Left>0in</Left>
                              <Width>0.07in</Width><Height>0.88in</Height>
                            </Rectangle>
                            <Textbox Name="KpiTile3Label">
                              <Value>VIRTUAL CARD</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#555555</Color><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.04in</Top><Left>0.1in</Left>
                              <Width>2.575in</Width><Height>0.17in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                            <Textbox Name="KpiTile3Value">
                              <Value>=Fields!virtual_card_count.Value</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight><Color>#375623</Color><Format>#,##0</Format><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.23in</Top><Left>0.1in</Left>
                              <Width>2.575in</Width><Height>0.28in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                            <Textbox Name="KpiTile3Pct">
                              <Value>=IIF(IsNothing(Fields!virtual_card_pct.Value), "N/A", Format(CDbl(Fields!virtual_card_pct.Value), "0.0") &amp; "% of new registrations")</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><Color>#375623</Color><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.53in</Top><Left>0.1in</Left>
                              <Width>2.575in</Width><Height>0.17in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                            <Textbox Name="KpiTile3Sub">
                              <Value>use_virtual_card = 1</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#888888</Color><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.71in</Top><Left>0.1in</Left>
                              <Width>2.575in</Width><Height>0.15in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                          </ReportItems>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>

                    <!-- T4: BOTH CARDS — accent #833C00 -->
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="KpiTile4">
                          <Style>
                            <BackgroundColor>#FFFFFF</BackgroundColor>
                            <BorderColor>#C8DBF0</BorderColor>
                            <BorderStyle>Solid</BorderStyle>
                            <BorderWidth>1.5pt</BorderWidth>
                          </Style>
                          <ReportItems>
                            <Rectangle Name="KpiTile4Accent">
                              <Style><BackgroundColor>#833C00</BackgroundColor></Style>
                              <Top>0in</Top><Left>0in</Left>
                              <Width>0.07in</Width><Height>0.88in</Height>
                            </Rectangle>
                            <Textbox Name="KpiTile4Label">
                              <Value>BOTH CARDS</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#555555</Color><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.04in</Top><Left>0.1in</Left>
                              <Width>2.575in</Width><Height>0.17in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                            <Textbox Name="KpiTile4Value">
                              <Value>=Fields!both_card_count.Value</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight><Color>#833C00</Color><Format>#,##0</Format><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.23in</Top><Left>0.1in</Left>
                              <Width>2.575in</Width><Height>0.28in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                            <Textbox Name="KpiTile4Pct">
                              <Value>=IIF(IsNothing(Fields!both_card_pct.Value), "N/A", Format(CDbl(Fields!both_card_pct.Value), "0.0") &amp; "% of new registrations")</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><Color>#833C00</Color><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.53in</Top><Left>0.1in</Left>
                              <Width>2.575in</Width><Height>0.17in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                            <Textbox Name="KpiTile4Sub">
                              <Value>physical = 1 AND virtual = 1</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#888888</Color><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.71in</Top><Left>0.1in</Left>
                              <Width>2.575in</Width><Height>0.15in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                          </ReportItems>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>

                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>
            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember/><TablixMember/><TablixMember/><TablixMember/>
              </TablixMembers>
            </TablixColumnHierarchy>
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember>
                  <DataGroupName>KpiGroup1</DataGroupName>
                  <Group Name="KpiGroup1"/>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>
            <Top>0.938in</Top>
            <Left>0in</Left>
            <Width>10.9in</Width>
            <Height>0.88in</Height>
          </Tablix>

          <!-- ════════════════════════════════════════════════════════════
               KPI ROW 2 — 3 tiles: Phone Verified | ID Verified | PIN Set
               T5/T6: 3.633in wide; T7: 3.634in wide  (sum = 10.9in)
          ════════════════════════════════════════════════════════════════ -->
          <Tablix Name="TablixKpiRow2">
            <DataSetName>dsKPI</DataSetName>
            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>3.633in</Width></TablixColumn>
                <TablixColumn><Width>3.633in</Width></TablixColumn>
                <TablixColumn><Width>3.634in</Width></TablixColumn>
              </TablixColumns>
              <TablixRows>
                <TablixRow>
                  <Height>0.88in</Height>
                  <TablixCells>

                    <!-- T5: PHONE VERIFIED — accent #C45911 -->
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="KpiTile5">
                          <Style>
                            <BackgroundColor>#FFFFFF</BackgroundColor>
                            <BorderColor>#C8DBF0</BorderColor>
                            <BorderStyle>Solid</BorderStyle>
                            <BorderWidth>1.5pt</BorderWidth>
                          </Style>
                          <ReportItems>
                            <Rectangle Name="KpiTile5Accent">
                              <Style><BackgroundColor>#C45911</BackgroundColor></Style>
                              <Top>0in</Top><Left>0in</Left>
                              <Width>0.07in</Width><Height>0.88in</Height>
                            </Rectangle>
                            <Textbox Name="KpiTile5Label">
                              <Value>PHONE VERIFIED</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#555555</Color><VerticalAlign>Middle</VerticalAlign><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.04in</Top><Left>0.1in</Left>
                              <Width>3.483in</Width><Height>0.17in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                            <Textbox Name="KpiTile5Value">
                              <Value>=Fields!phone_verified_count.Value</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>14pt</FontSize><FontWeight>Bold</FontWeight><Color>#C45911</Color><Format>#,##0</Format><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.23in</Top><Left>0.1in</Left>
                              <Width>3.483in</Width><Height>0.28in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                            <Textbox Name="KpiTile5Pct">
                              <Value>=IIF(IsNothing(Fields!phone_verified_pct.Value), "N/A", Format(CDbl(Fields!phone_verified_pct.Value), "0.0") &amp; "% of new registrations")</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><Color>#C45911</Color><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.53in</Top><Left>0.1in</Left>
                              <Width>3.483in</Width><Height>0.17in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                            <Textbox Name="KpiTile5Sub">
                              <Value>OTP confirmed via registration cashier session bridge</Value>
                              <Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#888888</Color><PaddingLeft>4pt</PaddingLeft></Style>
                              <Top>0.71in</Top><Left>0.1in</Left>
                              <Width>3.483in</Width><Height>0.15in</Height>
                              <CanGrow>false</CanGrow>
                            </Textbox>
                          </ReportItems>
                        </Rectangle>
                      </CellContents>
