                          <Value>=Fields!transaction_reference_number.Value</Value>
                          <Style><Color>#555555</Color><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize></Style>
                        </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                        <Style>
                          <BackgroundColor>=IIF(RowNumber("TablePartB_Details") Mod 2 = 0, "#F7F2FB", "#FFFFFF")</BackgroundColor>
                          <VerticalAlign>Middle</VerticalAlign>
                          <PaddingLeft>3pt</PaddingLeft>
                          <Border><Style>Solid</Style><Color>#EEEEEE</Color><Width>0.25pt</Width></Border>
                        </Style>
                        <CanGrow>true</CanGrow>
                      </Textbox>
                    </CellContents></TablixCell>

                    <!-- Col 7: amount — green #375623, bold, right-aligned -->
                    <TablixCell><CellContents>
                      <Textbox Name="tdAmount">
                        <Paragraphs><Paragraph><TextRuns><TextRun>
                          <Value>="$" &amp; Format(Fields!amount.Value, "#,##0.00")</Value>
                          <Style><Color>#375623</Color><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style>
                        </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                        <Style>
                          <BackgroundColor>=IIF(RowNumber("TablePartB_Details") Mod 2 = 0, "#F7F2FB", "#FFFFFF")</BackgroundColor>
                          <VerticalAlign>Middle</VerticalAlign>
                          <PaddingRight>3pt</PaddingRight>
                          <Border><Style>Solid</Style><Color>#EEEEEE</Color><Width>0.25pt</Width></Border>
                        </Style>
                        <CanGrow>true</CanGrow>
                      </Textbox>
                    </CellContents></TablixCell>

                    <!-- Col 8: approval_tier_name — bound from DB ("Supervisor" or "Owner") -->
                    <TablixCell><CellContents>
                      <Textbox Name="tdTier">
                        <Paragraphs><Paragraph><TextRuns><TextRun>
                          <Value>=Fields!approval_tier_name.Value</Value>
                          <Style><Color>#1A1A1A</Color><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize></Style>
                        </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                        <Style>
                          <BackgroundColor>=IIF(RowNumber("TablePartB_Details") Mod 2 = 0, "#F7F2FB", "#FFFFFF")</BackgroundColor>
                          <VerticalAlign>Middle</VerticalAlign>
                          <PaddingLeft>3pt</PaddingLeft>
                          <Border><Style>Solid</Style><Color>#EEEEEE</Color><Width>0.25pt</Width></Border>
                        </Style>
                        <CanGrow>true</CanGrow>
                      </Textbox>
                    </CellContents></TablixCell>

                    <!-- Col 9: approver_display_name (full name — internal audit report) -->
                    <TablixCell><CellContents>
                      <Textbox Name="tdApprover">
                        <Paragraphs><Paragraph><TextRuns><TextRun>
                          <Value>=Fields!approver_display_name.Value</Value>
                          <Style><Color>#1A1A1A</Color><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize></Style>
                        </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                        <Style>
                          <BackgroundColor>=IIF(RowNumber("TablePartB_Details") Mod 2 = 0, "#F7F2FB", "#FFFFFF")</BackgroundColor>
                          <VerticalAlign>Middle</VerticalAlign>
                          <PaddingLeft>3pt</PaddingLeft>
                          <Border><Style>Solid</Style><Color>#EEEEEE</Color><Width>0.25pt</Width></Border>
                        </Style>
                        <CanGrow>true</CanGrow>
                      </Textbox>
                    </CellContents></TablixCell>

                    <!-- Col 10: response_time_minutes — right-aligned, null-guarded -->
                    <TablixCell><CellContents>
                      <Textbox Name="tdRespMin">
                        <Paragraphs><Paragraph><TextRuns><TextRun>
                          <Value>=IIF(IsNothing(Fields!response_time_minutes.Value), "", Format(Fields!response_time_minutes.Value, "#,##0"))</Value>
                          <Style><Color>#1A1A1A</Color><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize></Style>
                        </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                        <Style>
                          <BackgroundColor>=IIF(RowNumber("TablePartB_Details") Mod 2 = 0, "#F7F2FB", "#FFFFFF")</BackgroundColor>
                          <VerticalAlign>Middle</VerticalAlign>
                          <PaddingRight>3pt</PaddingRight>
                          <Border><Style>Solid</Style><Color>#EEEEEE</Color><Width>0.25pt</Width></Border>
                        </Style>
                        <CanGrow>true</CanGrow>
                      </Textbox>
                    </CellContents></TablixCell>

                  </TablixCells>
                </TablixRow>

              </TablixRows>
            </TablixBody>

            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember />
                <TablixMember />
              </TablixMembers>
            </TablixColumnHierarchy>

            <TablixRowHierarchy>
              <TablixMembers>
                <!-- Header row member — FixedData (screen freeze) + RepeatOnNewPage (PDF print) -->
                <TablixMember>
                  <FixedData>true</FixedData>
                  <KeepWithGroup>After</KeepWithGroup>
                  <RepeatOnNewPage>true</RepeatOnNewPage>
                  <KeepTogether>true</KeepTogether>
                </TablixMember>
                <!-- Detail row member -->
                <TablixMember>
                  <Group Name="TablePartB_Details">
                    <DataGroupName>TablePartB_Details</DataGroupName>
                  </Group>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>

            <Style><Border><Style>None</Style></Border></Style>
          </Tablix>

          <!-- ══════════════════════════════════════════════════════════
               5. FOOTNOTE STRIP
               Four report notes sourced from SVG text lines
          ════════════════════════════════════════════════════════════ -->
          <Rectangle Name="FootnoteStrip">
            <Left>0in</Left><Top>13.0in</Top>
            <Width>8.052in</Width><Height>0.700in</Height>
            <Style>
              <BackgroundColor>#FFFFFF</BackgroundColor>
              <Border><Style>None</Style></Border>
            </Style>
            <ReportItems>

              <Textbox Name="tbFootnoteHeader">
                <Left>0in</Left><Top>0in</Top>
                <Width>8.052in</Width><Height>0.13in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>Report Notes:</Value>
                  <Style><Color>#555555</Color><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><FontWeight>Bold</FontWeight></Style>
                </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

              <Textbox Name="tbFootnote1">
                <Left>0in</Left><Top>0.13in</Top>
                <Width>8.052in</Width><Height>0.13in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>&#xB9;  Only transactions with a committed supervisor_approval_id are shown. Unapproved or expired approval requests are not recorded in gc.transactions and do not appear in this report.</Value>
                  <Style><Color>#888888</Color><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize></Style>
                </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

              <Textbox Name="tbFootnote2">
                <Left>0in</Left><Top>0.26in</Top>
                <Width>8.052in</Width><Height>0.13in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>&#xB2;  Cashier display: first_name + last_initial + '.' (PII-minimised). Approver display: full name (internal compliance report).</Value>
                  <Style><Color>#888888</Color><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize></Style>
                </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

              <Textbox Name="tbFootnote3">
                <Left>0in</Left><Top>0.39in</Top>
                <Width>8.052in</Width><Height>0.13in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>&#xB3;  Resp. (min): DATEDIFF(MINUTE, sa.requested_datetime, sa.approved_datetime). Date/times shown in organisation local time as converted by SP.</Value>
                  <Style><Color>#888888</Color><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize></Style>
                </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

              <Textbox Name="tbFootnote4">
                <Left>0in</Left><Top>0.52in</Top>
                <Width>8.052in</Width><Height>0.13in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>&#x2074;  Approval Tier sourced from mst.approval_tier via gc.supervisor_approval.approval_tier FK. Threshold configuration is managed separately in gc.approval_threshold.</Value>
                  <Style><Color>#888888</Color><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize></Style>
                </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

            </ReportItems>
          </Rectangle>

          <!-- ══════════════════════════════════════════════════════════
               6. FILTER SUMMARY PANEL
               Background #F7F2FB, left purple accent strip #7B2D8B
          ════════════════════════════════════════════════════════════ -->
          <Rectangle Name="FilterSummaryPanel">
            <Left>0in</Left><Top>13.75in</Top>
            <Width>8.052in</Width><Height>0.625in</Height>
            <Style>
              <BackgroundColor>#F7F2FB</BackgroundColor>
              <Border><Style>None</Style></Border>
            </Style>
            <ReportItems>

              <!-- Left accent strip -->
              <Rectangle Name="rectFilterAccent">
                <Left>0in</Left><Top>0in</Top>
                <Width>0.042in</Width><Height>0.625in</Height>
                <Style><BackgroundColor>#7B2D8B</BackgroundColor><Border><Style>None</Style></Border></Style>
              </Rectangle>

              <!-- "Applied Filters" label -->
              <Textbox Name="tbFilterHeader">
                <Left>0.08in</Left><Top>0.04in</Top>
                <Width>4in</Width><Height>0.13in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>Applied Filters</Value>
                  <Style><Color>#4A1060</Color><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight></Style>
                </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

              <!-- Organisation filter display -->
              <Textbox Name="tbFilterOrg">
                <Left>0.08in</Left><Top>0.17in</Top>
                <Width>4in</Width><Height>0.13in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>="Locations: " &amp; IIF(Parameters!operator_ids.Count = CountRows("dsLocations"), "All", Join(Parameters!operator_ids.Label, ", "))</Value>
                  <Style><Color>#555555</Color><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize></Style>
                </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

              <!-- Terminals + Cashiers filter display -->
              <Textbox Name="tbFilterTermCashier">
                <Left>0.08in</Left><Top>0.30in</Top>
                <Width>4in</Width><Height>0.13in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>="Terminals: " &amp; IIF(Parameters!terminal_ids.Count = CountRows("dsTerminals"), "All", Join(Parameters!terminal_ids.Label, ", ")) &amp; "  ·  Cashiers: " &amp; IIF(Parameters!cashier_ids.Count = CountRows("dsCashiers"), "All", Join(Parameters!cashier_ids.Label, ", "))</Value>
                  <Style><Color>#555555</Color><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize></Style>
                </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

              <!-- Date range filter display -->
              <Textbox Name="tbFilterDateRange">
                <Left>0.08in</Left><Top>0.43in</Top>
                <Width>4in</Width><Height>0.13in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>="Date Range: " &amp; Format(Parameters!from_date.Value, "MM/dd/yyyy") &amp; " 00:00 – " &amp; Format(Parameters!to_date.Value, "MM/dd/yyyy") &amp; " 23:59 local  (converted to UTC internally by SP)"</Value>
                  <Style><Color>#555555</Color><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize></Style>
                </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

              <!-- Right side: parameter + data source notes -->
              <Textbox Name="tbFilterNotes1">
                <Left>4.1in</Left><Top>0.04in</Top>
                <Width>3.952in</Width><Height>0.13in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>Parameters passed as SSRS report parameters → gc.rpt_loc_supervisor_override_kpi / _detail</Value>
                  <Style><Color>#888888</Color><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize></Style>
                </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

              <Textbox Name="tbFilterNotes2">
                <Left>4.1in</Left><Top>0.17in</Top>
                <Width>3.952in</Width><Height>0.13in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>NULL = All (no filter applied)  ·  Multi-value params: comma-delimited NVARCHAR(MAX)</Value>
                  <Style><Color>#888888</Color><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize></Style>
                </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

              <Textbox Name="tbFilterNotes3">
                <Left>4.1in</Left><Top>0.30in</Top>
                <Width>3.952in</Width><Height>0.13in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>Data source: GTW_GiftCards_DS  ·  Auth: Windows Auth S2S  ·  ApplicationIntent=ReadOnly</Value>
                  <Style><Color>#888888</Color><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize></Style>
                </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

            </ReportItems>
          </Rectangle>

        </ReportItems>
        <Style />
      </Body>

    </ReportSection>
  </ReportSections>

</Report>
