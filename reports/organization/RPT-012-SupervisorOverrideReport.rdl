<?xml version='1.0' encoding='utf-8'?>
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition" xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">

  <AutoRefresh>0</AutoRefresh>
  <ConsumeContainerWhitespace>true</ConsumeContainerWhitespace>
  <Language>en-US</Language>
  <rd:ReportUnitType>Inch</rd:ReportUnitType>

  <!-- ══════════════════════════════════════════════════════════════════
       DATA SOURCES
  ════════════════════════════════════════════════════════════════════ -->
  <DataSources>
    <DataSource Name="GTW_GiftCards_DS">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=&lt;sql-server-hostname&gt;;Initial Catalog=GiftCards;Integrated Security=True;ApplicationIntent=ReadOnly</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
    </DataSource>
  </DataSources>

  <!-- ══════════════════════════════════════════════════════════════════
       DATASETS
  ════════════════════════════════════════════════════════════════════ -->
  <DataSets>

    <!-- dsKPI: One summary row for Part A KPI tiles -->
    <DataSet Name="dsKPI">
      <Query>
        <DataSourceName>GTW_GiftCards_DS</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>gc.rpt_loc_supervisor_override_kpi</CommandText>
        <QueryParameters>
          <QueryParameter Name="@organization_id">
            <Value>=Parameters!organization_id.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@from_date">
            <Value>=Parameters!from_date.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@to_date">
            <Value>=Parameters!to_date.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@operator_ids">
            <Value>=Join(Parameters!operator_ids.Value, ",")</Value>
          </QueryParameter>
          <QueryParameter Name="@terminal_ids">
            <Value>=Join(Parameters!terminal_ids.Value, ",")</Value>
          </QueryParameter>
          <QueryParameter Name="@cashier_ids">
            <Value>=Join(Parameters!cashier_ids.Value, ",")</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="total_override_count"><DataField>total_override_count</DataField></Field>
        <Field Name="total_amount_approved"><DataField>total_amount_approved</DataField></Field>
        <Field Name="avg_override_amount"><DataField>avg_override_amount</DataField></Field>
        <Field Name="avg_response_time_minutes"><DataField>avg_response_time_minutes</DataField></Field>
      </Fields>
    </DataSet>

    <!-- dsDetail: One row per approved supervisor override event for Part B -->
    <DataSet Name="dsDetail">
      <Query>
        <DataSourceName>GTW_GiftCards_DS</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>gc.rpt_loc_supervisor_override_detail</CommandText>
        <QueryParameters>
          <QueryParameter Name="@organization_id"><Value>=Parameters!organization_id.Value</Value></QueryParameter>
          <QueryParameter Name="@from_date"><Value>=Parameters!from_date.Value</Value></QueryParameter>
          <QueryParameter Name="@to_date"><Value>=Parameters!to_date.Value</Value></QueryParameter>
          <QueryParameter Name="@operator_ids"><Value>=Join(Parameters!operator_ids.Value, ",")</Value></QueryParameter>
          <QueryParameter Name="@terminal_ids"><Value>=Join(Parameters!terminal_ids.Value, ",")</Value></QueryParameter>
          <QueryParameter Name="@cashier_ids"><Value>=Join(Parameters!cashier_ids.Value, ",")</Value></QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="supervisor_approval_id"><DataField>supervisor_approval_id</DataField></Field>
        <Field Name="requested_datetime_local"><DataField>requested_datetime_local</DataField></Field>
        <Field Name="approved_datetime_local"><DataField>approved_datetime_local</DataField></Field>
        <Field Name="location_name"><DataField>location_name</DataField></Field>
        <Field Name="terminal_name"><DataField>terminal_name</DataField></Field>
        <Field Name="cashier_display"><DataField>cashier_display</DataField></Field>
        <Field Name="transaction_reference_number"><DataField>transaction_reference_number</DataField></Field>
        <Field Name="transaction_type_name"><DataField>transaction_type_name</DataField></Field>
        <Field Name="amount"><DataField>amount</DataField></Field>
        <Field Name="approval_tier_name"><DataField>approval_tier_name</DataField></Field>
        <Field Name="approver_display_name"><DataField>approver_display_name</DataField></Field>
        <Field Name="response_time_minutes"><DataField>response_time_minutes</DataField></Field>
      </Fields>
    </DataSet>

    <!-- dsLocations: Available values for operator_ids parameter -->
    <DataSet Name="dsLocations">
      <Query>
        <DataSourceName>GTW_GiftCards_DS</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>gc.rpt_org_operators_lst</CommandText>
        <QueryParameters>
          <QueryParameter Name="@organization_id"><Value>=Parameters!organization_id.Value</Value></QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="operator_id"><DataField>operator_id</DataField></Field>
        <Field Name="operator_name"><DataField>operator_name</DataField></Field>
      </Fields>
    </DataSet>

    <!-- dsTerminals: Available values for terminal_ids parameter — cascades from operator_ids -->
    <DataSet Name="dsTerminals">
      <Query>
        <DataSourceName>GTW_GiftCards_DS</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>gc.rpt_loc_terminals_lst</CommandText>
        <QueryParameters>
          <QueryParameter Name="@organization_id"><Value>=Parameters!organization_id.Value</Value></QueryParameter>
          <QueryParameter Name="@operator_ids"><Value>=Join(Parameters!operator_ids.Value, ",")</Value></QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="terminal_id"><DataField>terminal_id</DataField></Field>
        <Field Name="display_name"><DataField>display_name</DataField></Field>
      </Fields>
    </DataSet>

    <!-- dsCashiers: Available values for cashier_ids parameter -->
    <DataSet Name="dsCashiers">
      <Query>
        <DataSourceName>GTW_GiftCards_DS</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>gc.rpt_location_cashiers_lst</CommandText>
        <QueryParameters>
          <QueryParameter Name="@organization_id"><Value>=Parameters!organization_id.Value</Value></QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="user_id"><DataField>user_id</DataField></Field>
        <Field Name="display_name"><DataField>display_name</DataField></Field>
      </Fields>
    </DataSet>

  </DataSets>

  <!-- ══════════════════════════════════════════════════════════════════
       REPORT PARAMETERS
  ════════════════════════════════════════════════════════════════════ -->
  <ReportParameters>

    <!-- organization_id: Hidden — populated from auth context (S2S) -->
    <ReportParameter Name="organization_id">
      <DataType>Integer</DataType>
      <Prompt>Organisation</Prompt>
      <Hidden>true</Hidden>
    </ReportParameter>

    <!-- from_date: Date picker; defaults to first day of current month -->
    <ReportParameter Name="from_date">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values><Value>=DateSerial(Year(Today()), Month(Today()), 1)</Value></Values>
      </DefaultValue>
      <Prompt>From Date</Prompt>
    </ReportParameter>

    <!-- to_date: Date picker; defaults to today -->
    <ReportParameter Name="to_date">
      <DataType>DateTime</DataType>
      <DefaultValue>
        <Values><Value>=Today()</Value></Values>
      </DefaultValue>
      <Prompt>To Date</Prompt>
    </ReportParameter>

    <!-- operator_ids: Multi-value; cascades on organization_id; defaults to All -->
    <ReportParameter Name="operator_ids">
      <DataType>Integer</DataType>
      <MultiValue>true</MultiValue>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>dsLocations</DataSetName>
          <ValueField>operator_id</ValueField>
        </DataSetReference>
      </DefaultValue>
      <ValidValues>
        <DataSetReference>
          <DataSetName>dsLocations</DataSetName>
          <ValueField>operator_id</ValueField>
          <LabelField>operator_name</LabelField>
        </DataSetReference>
      </ValidValues>
      <Prompt>Location</Prompt>
    </ReportParameter>

    <!-- terminal_ids: Multi-value; cascades on operator_ids; defaults to All -->
    <ReportParameter Name="terminal_ids">
      <DataType>Integer</DataType>
      <MultiValue>true</MultiValue>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>dsTerminals</DataSetName>
          <ValueField>terminal_id</ValueField>
        </DataSetReference>
      </DefaultValue>
      <ValidValues>
        <DataSetReference>
          <DataSetName>dsTerminals</DataSetName>
          <ValueField>terminal_id</ValueField>
          <LabelField>display_name</LabelField>
        </DataSetReference>
      </ValidValues>
      <Prompt>Terminal</Prompt>
    </ReportParameter>

    <!-- cashier_ids: Multi-value; org-wide list; defaults to All -->
    <ReportParameter Name="cashier_ids">
      <DataType>Integer</DataType>
      <MultiValue>true</MultiValue>
      <DefaultValue>
        <DataSetReference>
          <DataSetName>dsCashiers</DataSetName>
          <ValueField>user_id</ValueField>
        </DataSetReference>
      </DefaultValue>
      <ValidValues>
        <DataSetReference>
          <DataSetName>dsCashiers</DataSetName>
          <ValueField>user_id</ValueField>
          <LabelField>display_name</LabelField>
        </DataSetReference>
      </ValidValues>
      <Prompt>Cashier</Prompt>
    </ReportParameter>

  </ReportParameters>

  <!-- ══════════════════════════════════════════════════════════════════
       REPORT SECTIONS
  ════════════════════════════════════════════════════════════════════ -->
  <ReportSections>
    <ReportSection>

      <!-- ═════════════════════════════════════════════════════════════
           PAGE DEFINITION — A4 Portrait, 10mm all margins
      ═════════════════════════════════════════════════════════════════ -->
      <Page>

        <!-- ── PAGE HEADER ── -->
        <PageHeader>
          <Height>0.75in</Height>
          <PrintOnFirstPage>true</PrintOnFirstPage>
          <PrintOnLastPage>true</PrintOnLastPage>
          <ReportItems>

            <!-- Dark background rectangle -->
            <Rectangle Name="rectPageHeader">
              <Left>0in</Left><Top>0in</Top>
              <Width>8.052in</Width><Height>0.75in</Height>
              <Style>
                <BackgroundColor>#1A1A1A</BackgroundColor>
                <Border><Style>None</Style></Border>
              </Style>
            </Rectangle>

            <!-- Purple accent strip — left edge compliance indicator -->
            <Rectangle Name="rectHeaderAccent">
              <Left>0in</Left><Top>0in</Top>
              <Width>0.063in</Width><Height>0.75in</Height>
              <ZIndex>1</ZIndex>
              <Style>
                <BackgroundColor>#7B2D8B</BackgroundColor>
                <Border><Style>None</Style></Border>
              </Style>
            </Rectangle>

            <!-- Title: "Supervisor Override Report" -->
            <Textbox Name="tbHeaderTitle">
              <Left>0.1in</Left><Top>0.06in</Top>
              <Width>5.5in</Width><Height>0.22in</Height>
              <ZIndex>2</ZIndex>
              <Paragraphs><Paragraph><TextRuns><TextRun>
                <Value>Supervisor Override Report</Value>
                <Style>
                  <Color>#FFFFFF</Color>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>13pt</FontSize>
                  <FontWeight>Bold</FontWeight>
                </Style>
              </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
              <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
              <CanGrow>true</CanGrow>
            </Textbox>

            <!-- Subtitle: org + location + period context -->
            <Textbox Name="tbHeaderOrg">
              <Left>0.1in</Left><Top>0.30in</Top>
              <Width>5.5in</Width><Height>0.18in</Height>
              <ZIndex>2</ZIndex>
              <Paragraphs><Paragraph><TextRuns><TextRun>
                <Value>="Period: " &amp; Format(Parameters!from_date.Value, "MM/dd/yyyy") &amp; " 00:00 – " &amp; Format(Parameters!to_date.Value, "MM/dd/yyyy") &amp; " 23:59"</Value>
                <Style>
                  <Color>#AAAAAA</Color>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>8.5pt</FontSize>
                </Style>
              </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
              <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
              <CanGrow>true</CanGrow>
            </Textbox>

            <!-- Filter line: terminals + cashiers summary -->
            <Textbox Name="tbHeaderFilters">
              <Left>0.1in</Left><Top>0.50in</Top>
              <Width>5.5in</Width><Height>0.18in</Height>
              <ZIndex>2</ZIndex>
              <Paragraphs><Paragraph><TextRuns><TextRun>
                <Value>="Terminals: " &amp; IIF(Parameters!terminal_ids.Count = CountRows("dsTerminals"), "All", Join(Parameters!terminal_ids.Label, ", ")) &amp; "  ·  Cashiers: " &amp; IIF(Parameters!cashier_ids.Count = CountRows("dsCashiers"), "All", Join(Parameters!cashier_ids.Label, ", "))</Value>
                <Style>
                  <Color>#888888</Color>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>8pt</FontSize>
                </Style>
              </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
              <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
              <CanGrow>true</CanGrow>
            </Textbox>

            <!-- Right: Generated datetime -->
            <Textbox Name="tbHeaderGenerated">
              <Left>5.75in</Left><Top>0.06in</Top>
              <Width>2.302in</Width><Height>0.18in</Height>
              <ZIndex>2</ZIndex>
              <Paragraphs><Paragraph><TextRuns><TextRun>
                <Value>="Generated: " &amp; Format(Globals!ExecutionTime, "MM/dd/yyyy HH:mm") &amp; " UTC"</Value>
                <Style>
                  <Color>#AAAAAA</Color>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>8.5pt</FontSize>
                </Style>
              </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
              <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
              <CanGrow>true</CanGrow>
            </Textbox>

            <!-- Right: By user -->
            <Textbox Name="tbHeaderUser">
              <Left>5.75in</Left><Top>0.26in</Top>
              <Width>2.302in</Width><Height>0.18in</Height>
              <ZIndex>2</ZIndex>
              <Paragraphs><Paragraph><TextRuns><TextRun>
                <Value>="By: " &amp; User!UserID</Value>
                <Style>
                  <Color>#AAAAAA</Color>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>8.5pt</FontSize>
                </Style>
              </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
              <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
              <CanGrow>true</CanGrow>
            </Textbox>

            <!-- Right: Report ID -->
            <Textbox Name="tbHeaderReportID">
              <Left>5.75in</Left><Top>0.46in</Top>
              <Width>2.302in</Width><Height>0.18in</Height>
              <ZIndex>2</ZIndex>
              <Paragraphs><Paragraph><TextRuns><TextRun>
                <Value>Report ID: RPT-012  ·  SSRS Web Portal</Value>
                <Style>
                  <Color>#888888</Color>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>8pt</FontSize>
                </Style>
              </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
              <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
              <CanGrow>true</CanGrow>
            </Textbox>

          </ReportItems>
          <Style />
        </PageHeader>

        <!-- ── PAGE FOOTER ── -->
        <PageFooter>
          <Height>0.30in</Height>
          <PrintOnFirstPage>true</PrintOnFirstPage>
          <PrintOnLastPage>true</PrintOnLastPage>
          <ReportItems>

            <!-- Left: access/confidentiality label -->
            <Textbox Name="tbFooterLabel">
              <Left>0in</Left><Top>0.05in</Top>
              <Width>6.5in</Width><Height>0.20in</Height>
              <Paragraphs><Paragraph><TextRuns><TextRun>
                <Value>RPT-012 — Supervisor Override Report  ·  Confidential — Internal Use Only  ·  Access: GTW Admin, Org Owner (role_id=8), Org Supervisor (role_id=9)</Value>
                <Style>
                  <Color>#AAAAAA</Color>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>7pt</FontSize>
                </Style>
              </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
              <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
              <CanGrow>true</CanGrow>
            </Textbox>

            <!-- Right: Page X of Y -->
            <Textbox Name="tbFooterPage">
              <Left>6.5in</Left><Top>0.05in</Top>
              <Width>1.552in</Width><Height>0.20in</Height>
              <Paragraphs><Paragraph><TextRuns><TextRun>
                <Value>="Page " &amp; Globals!PageNumber &amp; " of " &amp; Globals!TotalPages</Value>
                <Style>
                  <Color>#AAAAAA</Color>
                  <FontFamily>Calibri</FontFamily>
                  <FontSize>7pt</FontSize>
                </Style>
              </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
              <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
              <CanGrow>true</CanGrow>
            </Textbox>

          </ReportItems>
          <Style />
        </PageFooter>

        <!-- A4 Portrait page dimensions -->
        <PageHeight>11.693in</PageHeight>
        <PageWidth>8.268in</PageWidth>
        <LeftMargin>0.394in</LeftMargin>
        <RightMargin>0.394in</RightMargin>
        <TopMargin>0.394in</TopMargin>
        <BottomMargin>0.394in</BottomMargin>
        <Style />
      </Page>

      <!-- ═════════════════════════════════════════════════════════════
           BODY
           Direct body children (TraceCounts deviation — no root wrap):
             1. KpiBanner (Textbox)
             2. PartASection (Tablix)
             3. PartBBanner (Textbox)
             4. PartBSection (Tablix)
             5. FootnoteStrip (Rectangle)
             6. FilterSummaryPanel (Rectangle)
      ═════════════════════════════════════════════════════════════════ -->
      <Body>
        <Height>18in</Height>
        <Width>8.052in</Width>
        <ReportItems>

          <!-- ══════════════════════════════════════════════════════════
               1. KPI BANNER — section label strip
          ════════════════════════════════════════════════════════════ -->
          <Textbox Name="tbKpiBanner">
            <Left>0in</Left><Top>0in</Top>
            <Width>8.052in</Width><Height>0.188in</Height>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>PART A — KPI SUMMARY</Value>
                    <Style>
                      <Color>#4A1060</Color>
                      <FontFamily>Calibri</FontFamily>
                      <FontSize>8.5pt</FontSize>
                      <FontWeight>Bold</FontWeight>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style><TextAlign>Left</TextAlign></Style>
              </Paragraph>
            </Paragraphs>
            <Style>
              <BackgroundColor>#E8D5F0</BackgroundColor>
              <VerticalAlign>Middle</VerticalAlign>
              <PaddingLeft>6pt</PaddingLeft>
              <Border><Style>None</Style></Border>
            </Style>
            <CanGrow>true</CanGrow>
          </Textbox>

          <!-- KPI banner right-side SP label — overlaid via absolute position textbox -->
          <Textbox Name="tbKpiBannerSP">
            <Left>4.5in</Left><Top>0in</Top>
            <Width>3.552in</Width><Height>0.188in</Height>
            <ZIndex>1</ZIndex>
            <Paragraphs>
              <Paragraph>
                <TextRuns>
                  <TextRun>
                    <Value>dsKPI  ·  gc.rpt_loc_supervisor_override_kpi</Value>
                    <Style>
                      <Color>#7B2D8B</Color>
                      <FontFamily>Calibri</FontFamily>
                      <FontSize>7.5pt</FontSize>
                    </Style>
                  </TextRun>
                </TextRuns>
                <Style><TextAlign>Right</TextAlign></Style>
              </Paragraph>
            </Paragraphs>
            <Style>
              <BackgroundColor>#E8D5F0</BackgroundColor>
              <VerticalAlign>Middle</VerticalAlign>
              <PaddingRight>4pt</PaddingRight>
              <Border><Style>None</Style></Border>
            </Style>
            <CanGrow>true</CanGrow>
          </Textbox>

          <!-- ══════════════════════════════════════════════════════════
               2. PART A — KPI TABLIX (TablePartA)
               2 columns × 2 data rows — 4 KPI tiles (2×2 grid)
               Each cell contains a nested rectangle tile card.
               Width: 8.052in / 2 = 4.026in per column
          ════════════════════════════════════════════════════════════ -->
          <Tablix Name="TablePartA">
            <DataSetName>dsKPI</DataSetName>
            <Left>0in</Left><Top>0.208in</Top>
            <Width>8.052in</Width><Height>1.500in</Height>
            <NoRowsMessage>No KPI data available for the selected filters.</NoRowsMessage>

            <TablixBody>
              <TablixColumns>
                <TablixColumn><Width>4.026in</Width></TablixColumn>
                <TablixColumn><Width>4.026in</Width></TablixColumn>
              </TablixColumns>

              <TablixRows>

                <!-- ── KPI Row 1: Tile 1 (Total Override Approvals) + Tile 2 (Total Amount Approved) ── -->
                <TablixRow>
                  <Height>0.750in</Height>
                  <TablixCells>

                    <!-- Tile 1: TOTAL OVERRIDE APPROVALS — accent #1A1A1A -->
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="rectKpi1">
                          <Left>0in</Left><Top>0in</Top>
                          <Width>4.026in</Width><Height>0.750in</Height>
                          <Style>
                            <BackgroundColor>#FFFFFF</BackgroundColor>
                            <Border><Style>Solid</Style><Color>#D5C0E8</Color><Width>0.75pt</Width></Border>
                          </Style>
                          <ReportItems>
                            <!-- Colored accent strip -->
                            <Rectangle Name="rectKpi1Accent">
                              <Left>0in</Left><Top>0in</Top>
                              <Width>0.052in</Width><Height>0.750in</Height>
                              <Style><BackgroundColor>#1A1A1A</BackgroundColor><Border><Style>None</Style></Border></Style>
                            </Rectangle>
                            <!-- Label -->
                            <Textbox Name="tbKpi1Label">
                              <Left>0.1in</Left><Top>0.06in</Top>
                              <Width>3.826in</Width><Height>0.15in</Height>
                              <Paragraphs><Paragraph><TextRuns><TextRun>
                                <Value>TOTAL OVERRIDE APPROVALS</Value>
                                <Style><Color>#555555</Color><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize></Style>
                              </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                              <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                              <CanGrow>true</CanGrow>
                            </Textbox>
                            <!-- Value -->
                            <Textbox Name="tbKpi1Value">
                              <Left>0.1in</Left><Top>0.22in</Top>
                              <Width>3.826in</Width><Height>0.32in</Height>
                              <Paragraphs><Paragraph><TextRuns><TextRun>
                                <Value>=Format(Fields!total_override_count.Value, "#,##0")</Value>
                                <Style><Color>#1A1A1A</Color><FontFamily>Calibri</FontFamily><FontSize>22pt</FontSize><FontWeight>Bold</FontWeight></Style>
                              </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                              <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                              <CanGrow>true</CanGrow>
                            </Textbox>
                            <!-- Subtext -->
                            <Textbox Name="tbKpi1Sub">
                              <Left>0.1in</Left><Top>0.58in</Top>
                              <Width>3.826in</Width><Height>0.13in</Height>
                              <Paragraphs><Paragraph><TextRuns><TextRun>
                                <Value>Override events in selected period</Value>
                                <Style><Color>#888888</Color><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize></Style>
                              </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                              <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                              <CanGrow>true</CanGrow>
                            </Textbox>
                          </ReportItems>
                        </Rectangle>
                      </CellContents>
                    </TablixCell>

                    <!-- Tile 2: TOTAL AMOUNT APPROVED — accent #375623 -->
                    <TablixCell>
                      <CellContents>
                        <Rectangle Name="rectKpi2">
                          <Left>0in</Left><Top>0in</Top>
