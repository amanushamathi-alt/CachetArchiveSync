<?xml version="1.0" encoding="utf-8"?>
<!--
  RPT-010 — Customer Account Inquiry (Main Report)
  SSRS Report Definition Language (RDL 2016)
  Spec:   coding-agent/specs/web-reports/RPT-010-customer-account-inquiry.md
  Design: reports-ui-design/RPT-010-Customer-Account-Inquiry.svg
  Deploy to: /GTW/GiftCards/RPT-010-Customer-Account-Inquiry.rdl
  Data source: GTW_GiftCards_DS  (Windows Auth S2S, GiftCards DB, ReadOnly)

  PII CONTROLS:
    - pan_hash / first_name_hash / last_name_hash / id_number_hash are Hidden parameters
      and are NEVER rendered in any Textbox expression.
    - customer_display = first_name + ' ' + last_initial + '.' only (no full last name).
    - phone_last4 is displayed as "***-***-XXXX" only.
    - card_number_redacted is displayed as stored (last-4 format from DB).
    - No Vault JOIN. No raw PAN. No DOB. No full phone. (PCI DSS Req 3 / HIPAA)

  SECURITY:
    - Role gate (Owner role_id=8 / Supervisor role_id=9 / GTW Admin) enforced by calling portal (EF-4).
    - Org isolation enforced by SP BR-1; this RDL trusts the parameter.
    - SSRS Windows Authentication (S2S). All renders logged to ExecutionLog3.
-->
<Report xmlns="http://schemas.microsoft.com/sqlserver/reporting/2016/01/reportdefinition"
        xmlns:rd="http://schemas.microsoft.com/SQLServer/reporting/reportdesigner">

  <AutoRefresh>0</AutoRefresh>
  <ConsumeContainerWhitespace>true</ConsumeContainerWhitespace>
  <Language>en-US</Language>
  <rd:ReportUnitType>Inch</rd:ReportUnitType>

  <!-- ══════════════════════════════════════════════════════════════════
       DATA SOURCE  — configure connection string before deployment
  ═══════════════════════════════════════════════════════════════════ -->
  <DataSources>
    <DataSource Name="GTW_GiftCards_DS">
      <ConnectionProperties>
        <DataProvider>SQL</DataProvider>
        <ConnectString>Data Source=&lt;sql-server-hostname&gt;;Initial Catalog=GiftCards;Integrated Security=True;ApplicationIntent=ReadOnly</ConnectString>
        <IntegratedSecurity>true</IntegratedSecurity>
      </ConnectionProperties>
      <rd:SecurityType>Integrated</rd:SecurityType>
    </DataSource>
  </DataSources>

  <!-- ══════════════════════════════════════════════════════════════════
       DATASETS  (4 in main report — dsTransactions lives in subreport)
  ═══════════════════════════════════════════════════════════════════ -->
  <DataSets>

    <!-- ── dsAccountInquiry ── main customer/account/card grid ─── -->
    <DataSet Name="dsAccountInquiry">
      <Query>
        <DataSourceName>GTW_GiftCards_DS</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>gc.rpt_customer_account_inquiry</CommandText>
        <QueryParameters>
          <QueryParameter Name="@organization_id">
            <Value>=Parameters!organization_id.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@operator_id">
            <Value>=Parameters!operator_id.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@pan_hash">
            <Value>=Parameters!pan_hash.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@first_name_hash">
            <Value>=Parameters!first_name_hash.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@last_name_hash">
            <Value>=Parameters!last_name_hash.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@id_number_hash">
            <Value>=Parameters!id_number_hash.Value</Value>
          </QueryParameter>
          <QueryParameter Name="@customer_status_ids">
            <Value>=IIF(Parameters!customer_status_ids.Count = 0, Nothing, Join(Parameters!customer_status_ids.Value, ","))</Value>
          </QueryParameter>
          <QueryParameter Name="@card_status_ids">
            <Value>=IIF(Parameters!card_status_ids.Count = 0, Nothing, Join(Parameters!card_status_ids.Value, ","))</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="customer_id"><DataField>customer_id</DataField></Field>
        <Field Name="customer_number"><DataField>customer_number</DataField></Field>
        <Field Name="customer_display"><DataField>customer_display</DataField></Field>
        <Field Name="phone_last4"><DataField>phone_last4</DataField></Field>
        <Field Name="customer_status"><DataField>customer_status</DataField></Field>
        <Field Name="registration_location"><DataField>registration_location</DataField></Field>
        <Field Name="organization_name"><DataField>organization_name</DataField></Field>
        <Field Name="member_since"><DataField>member_since</DataField></Field>
        <Field Name="gift_card_account_id"><DataField>gift_card_account_id</DataField></Field>
        <Field Name="account_number"><DataField>account_number</DataField></Field>
        <Field Name="current_balance"><DataField>current_balance</DataField></Field>
        <Field Name="max_balance"><DataField>max_balance</DataField></Field>
        <Field Name="account_status"><DataField>account_status</DataField></Field>
        <Field Name="last_activity_date"><DataField>last_activity_date</DataField></Field>
        <Field Name="card_number_redacted"><DataField>card_number_redacted</DataField></Field>
        <Field Name="card_type"><DataField>card_type</DataField></Field>
        <Field Name="card_status"><DataField>card_status</DataField></Field>
        <Field Name="card_issued_date"><DataField>card_issued_date</DataField></Field>
        <Field Name="card_expiry_date"><DataField>card_expiry_date</DataField></Field>
        <Field Name="has_multiple_accounts"><DataField>has_multiple_accounts</DataField></Field>
        <Field Name="has_id_on_file"><DataField>has_id_on_file</DataField></Field>
        <Field Name="id_document_type"><DataField>id_document_type</DataField></Field>
        <Field Name="has_phone_verified"><DataField>has_phone_verified</DataField></Field>
        <Field Name="has_kyc_completed"><DataField>has_kyc_completed</DataField></Field>
      </Fields>
    </DataSet>

    <!-- ── dsOperators ── P2 operator cascading dropdown ────────── -->
    <DataSet Name="dsOperators">
      <Query>
        <DataSourceName>GTW_GiftCards_DS</DataSourceName>
        <CommandType>StoredProcedure</CommandType>
        <CommandText>gc.rpt_org_operators_lst</CommandText>
        <QueryParameters>
          <QueryParameter Name="@organization_id">
            <Value>=Parameters!organization_id.Value</Value>
          </QueryParameter>
        </QueryParameters>
      </Query>
      <Fields>
        <Field Name="operator_id"><DataField>operator_id</DataField></Field>
        <Field Name="display_name"><DataField>display_name</DataField></Field>
      </Fields>
    </DataSet>

    <!-- ── dsCustomerStatuses ── P6 multi-value checklist ────────── -->
    <DataSet Name="dsCustomerStatuses">
      <Query>
        <DataSourceName>GTW_GiftCards_DS</DataSourceName>
        <CommandText>SELECT status_id, status AS status_name FROM mst.gift_card_customer_status WHERE is_active = 1 ORDER BY status_id</CommandText>
      </Query>
      <Fields>
        <Field Name="status_id"><DataField>status_id</DataField></Field>
        <Field Name="status_name"><DataField>status_name</DataField></Field>
      </Fields>
    </DataSet>

    <!-- ── dsCardStatuses ── P7 multi-value checklist ─────────────── -->
    <DataSet Name="dsCardStatuses">
      <Query>
        <DataSourceName>GTW_GiftCards_DS</DataSourceName>
        <CommandText>SELECT card_status_id, card_status_name FROM mst.card_status ORDER BY card_status_id</CommandText>
      </Query>
      <Fields>
        <Field Name="card_status_id"><DataField>card_status_id</DataField></Field>
        <Field Name="card_status_name"><DataField>card_status_name</DataField></Field>
      </Fields>
    </DataSet>

  </DataSets>

  <!-- ══════════════════════════════════════════════════════════════════
       REPORT PARAMETERS  (8 parameters — §6 of spec)
       SECURITY: hash params (P3/P4a/P4b/P5) are Hidden=true.
       Hash values are NEVER rendered in any Textbox.
  ═══════════════════════════════════════════════════════════════════ -->
  <ReportParameters>

    <!-- P1: organization_id — visible dropdown -->
    <ReportParameter Name="organization_id">
      <DataType>Integer</DataType>
      <Prompt>Organisation</Prompt>
      <Hidden>false</Hidden>
      <Nullable>true</Nullable>
    </ReportParameter>

    <!-- P2: operator_id — cascades from P1 -->
    <ReportParameter Name="operator_id">
      <DataType>Integer</DataType>
      <Prompt>Location</Prompt>
      <Hidden>false</Hidden>
      <Nullable>true</Nullable>
      <ValidValues>
        <DataSetReference>
          <DataSetName>dsOperators</DataSetName>
          <ValueField>operator_id</ValueField>
          <LabelField>display_name</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>

    <!-- P3: pan_hash — HIDDEN, passed via URL only. NEVER rendered. -->
    <ReportParameter Name="pan_hash">
      <DataType>String</DataType>
      <Prompt>PAN Hash</Prompt>
      <Hidden>true</Hidden>
      <Nullable>true</Nullable>
    </ReportParameter>

    <!-- P4a: first_name_hash — HIDDEN, passed via URL only. NEVER rendered. -->
    <ReportParameter Name="first_name_hash">
      <DataType>String</DataType>
      <Prompt>First Name Hash</Prompt>
      <Hidden>true</Hidden>
      <Nullable>true</Nullable>
    </ReportParameter>

    <!-- P4b: last_name_hash — HIDDEN, passed via URL only. NEVER rendered. -->
    <ReportParameter Name="last_name_hash">
      <DataType>String</DataType>
      <Prompt>Last Name Hash</Prompt>
      <Hidden>true</Hidden>
      <Nullable>true</Nullable>
    </ReportParameter>

    <!-- P5: id_number_hash — HIDDEN, passed via URL only. NEVER rendered. -->
    <ReportParameter Name="id_number_hash">
      <DataType>String</DataType>
      <Prompt>ID Number Hash</Prompt>
      <Hidden>true</Hidden>
      <Nullable>true</Nullable>
    </ReportParameter>

    <!-- P6: customer_status_ids — visible multi-value checklist -->
    <ReportParameter Name="customer_status_ids">
      <DataType>Integer</DataType>
      <MultiValue>true</MultiValue>
      <Prompt>Customer Status</Prompt>
      <Hidden>false</Hidden>
      <Nullable>true</Nullable>
      <ValidValues>
        <DataSetReference>
          <DataSetName>dsCustomerStatuses</DataSetName>
          <ValueField>status_id</ValueField>
          <LabelField>status_name</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>

    <!-- P7: card_status_ids — visible multi-value checklist -->
    <ReportParameter Name="card_status_ids">
      <DataType>Integer</DataType>
      <MultiValue>true</MultiValue>
      <Prompt>Card Status</Prompt>
      <Hidden>false</Hidden>
      <Nullable>true</Nullable>
      <ValidValues>
        <DataSetReference>
          <DataSetName>dsCardStatuses</DataSetName>
          <ValueField>card_status_id</ValueField>
          <LabelField>card_status_name</LabelField>
        </DataSetReference>
      </ValidValues>
    </ReportParameter>

    <!-- P8: transaction_rows_max — visible dropdown [10, 20, 50, 100] -->
    <ReportParameter Name="transaction_rows_max">
      <DataType>Integer</DataType>
      <Prompt>Max Transactions</Prompt>
      <Hidden>false</Hidden>
      <Nullable>false</Nullable>
      <DefaultValue>
        <Values><Value>20</Value></Values>
      </DefaultValue>
      <ValidValues>
        <ParameterValues>
          <ParameterValue><Value>10</Value><Label>10</Label></ParameterValue>
          <ParameterValue><Value>20</Value><Label>20</Label></ParameterValue>
          <ParameterValue><Value>50</Value><Label>50</Label></ParameterValue>
          <ParameterValue><Value>100</Value><Label>100</Label></ParameterValue>
        </ParameterValues>
      </ValidValues>
    </ReportParameter>

  </ReportParameters>

  <!-- ══════════════════════════════════════════════════════════════════
       REPORT SECTIONS
  ═══════════════════════════════════════════════════════════════════ -->
  <ReportSections>
    <ReportSection>

      <!-- ════════════════════════════════════════════════════════════
           PAGE SETUP  — Letter, Portrait, 0.25in margins all sides
      ═══════════════════════════════════════════════════════════════ -->
      <Page>

        <!-- PAGE FOOTER — dark band, CONFIDENTIAL text, every page -->
        <PageFooter>
          <Height>0.2in</Height>
          <PrintOnFirstPage>true</PrintOnFirstPage>
          <PrintOnLastPage>true</PrintOnLastPage>
          <ReportItems>

            <Rectangle Name="rectFooterBg">
              <Left>0in</Left><Top>0in</Top>
              <Width>8.0in</Width><Height>0.2in</Height>
              <Style>
                <BackgroundColor>#1A1A1A</BackgroundColor>
                <Border><Style>None</Style></Border>
              </Style>
            </Rectangle>

            <Textbox Name="Footer_PageNum">
              <Left>0.05in</Left><Top>0.02in</Top>
              <Width>1.5in</Width><Height>0.16in</Height>
              <ZIndex>1</ZIndex>
              <Paragraphs><Paragraph><TextRuns><TextRun>
                <Value>="Page " &amp; Globals!PageNumber &amp; " of " &amp; Globals!TotalPages</Value>
                <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><Color>#AAAAAA</Color></Style>
              </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
              <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
              <CanGrow>true</CanGrow>
            </Textbox>

            <Textbox Name="Footer_Confidential">
              <Left>1.8in</Left><Top>0.02in</Top>
              <Width>4.4in</Width><Height>0.16in</Height>
              <ZIndex>1</ZIndex>
              <Paragraphs><Paragraph><TextRuns><TextRun>
                <Value>CONFIDENTIAL — This report contains minimised PII. Not for public disclosure.</Value>
                <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#CCCCCC</Color></Style>
              </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
              <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
              <CanGrow>true</CanGrow>
            </Textbox>

            <Textbox Name="Footer_ReportID">
              <Left>6.4in</Left><Top>0.02in</Top>
              <Width>1.55in</Width><Height>0.16in</Height>
              <ZIndex>1</ZIndex>
              <Paragraphs><Paragraph><TextRuns><TextRun>
                <Value>RPT-010 v1.0  ·  GTW Gift Card System</Value>
                <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#888888</Color></Style>
              </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
              <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
              <CanGrow>true</CanGrow>
            </Textbox>

          </ReportItems>
          <Style />
        </PageFooter>

        <PageHeight>11in</PageHeight>
        <PageWidth>8.5in</PageWidth>
        <LeftMargin>0.25in</LeftMargin>
        <RightMargin>0.25in</RightMargin>
        <TopMargin>0.25in</TopMargin>
        <BottomMargin>0.25in</BottomMargin>
        <Style />
      </Page>

      <!-- ════════════════════════════════════════════════════════════
           BODY
           Direct body children (per tracecounts-rdl-state.md convention):
             1. ReportHeader     (Rectangle)
             2. AccountList      (Tablix  — List pattern, dsAccountInquiry)
             3. NoResultsMsg     (Rectangle — visible only on 0 rows)
           Usable body width: 8.0in
      ═══════════════════════════════════════════════════════════════ -->
      <Body>
        <Height>14in</Height>
        <Width>8.0in</Width>
        <ReportItems>

          <!-- ─────────────────────────────────────────────────────────
               1. REPORT HEADER RECTANGLE
               Dark band with title, org/location line, search criteria,
               generated timestamp, user, report ID.
               Height: 72px → 72/96 = 0.75in (using standard 96dpi for body header)
               NOTE: per task spec, header is 0.537in. Using spec value.
          ──────────────────────────────────────────────────────────── -->
          <Rectangle Name="ReportHeader">
            <Left>0in</Left><Top>0in</Top>
            <Width>8.0in</Width><Height>0.537in</Height>
            <Style>
              <BackgroundColor>#1A1A1A</BackgroundColor>
              <Border><Style>None</Style></Border>
            </Style>
            <ReportItems>

              <Textbox Name="Header_Title">
                <Left>0.089in</Left><Top>0.0in</Top>
                <Width>4.0in</Width><Height>0.16in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>Customer Account Inquiry</Value>
                  <Style><FontFamily>Calibri</FontFamily><FontSize>10pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style>
                </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

              <Textbox Name="Header_OrgLine">
                <Left>0.089in</Left><Top>0.18in</Top>
                <Width>5.5in</Width><Height>0.13in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>="Organisation: " &amp; IIF(IsNothing(Parameters!organization_id.Value), "(All Organisations)", First(Fields!organization_name.Value, "dsAccountInquiry")) &amp; "  ·  Location: " &amp; IIF(IsNothing(Parameters!operator_id.Value), "(All Locations)", First(Fields!registration_location.Value, "dsAccountInquiry"))</Value>
                  <Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#AAAAAA</Color></Style>
                </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

              <Textbox Name="Header_SearchLine">
                <Left>0.089in</Left><Top>0.313in</Top>
                <Width>5.5in</Width><Height>0.13in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>=IIF(NOT IsNothing(Parameters!pan_hash.Value), "Search: PAN Supplied (hashed)", IIF(NOT IsNothing(Parameters!first_name_hash.Value), "Search: Customer Name Supplied (hashed)", IIF(NOT IsNothing(Parameters!id_number_hash.Value), "Search: ID Number Supplied (hashed)", "[No search criteria]")))</Value>
                  <Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#888888</Color></Style>
                </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

              <Textbox Name="Header_Generated">
                <Left>4.5in</Left><Top>0.0in</Top>
                <Width>3.5in</Width><Height>0.13in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>="Generated: " &amp; Format(Globals!ExecutionTime, "MM/dd/yyyy HH:mm") &amp; " UTC"</Value>
                  <Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#AAAAAA</Color></Style>
                </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

              <Textbox Name="Header_User">
                <Left>4.5in</Left><Top>0.18in</Top>
                <Width>3.5in</Width><Height>0.13in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>="By: " &amp; User!UserID</Value>
                  <Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><Color>#AAAAAA</Color></Style>
                </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

              <Textbox Name="Header_ReportIDLine">
                <Left>4.5in</Left><Top>0.313in</Top>
                <Width>3.5in</Width><Height>0.13in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>Report ID: RPT-010  ·  SSRS Web Portal</Value>
                  <Style><FontFamily>Calibri</FontFamily><FontSize>6.5pt</FontSize><Color>#888888</Color></Style>
                </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

            </ReportItems>
          </Rectangle>

          <!-- ─────────────────────────────────────────────────────────
               2. ACCOUNT LIST CONTAINER — skills requirement:
               all new Tablix elements must be inside a Rectangle
               (svg-to-rdl.md layout rule + tracecounts-rdl-state.md).
               AccountList Tablix is positioned at 0/0 relative to this.
          ──────────────────────────────────────────────────────────── -->
          <Rectangle Name="AccountListContainer">
            <Left>0in</Left><Top>0.6in</Top>
            <Width>8.0in</Width><Height>4.2in</Height>
            <KeepTogether>false</KeepTogether>
            <Style><Border><Style>None</Style></Border></Style>
            <ReportItems>

          <Tablix Name="AccountList">
            <DataSetName>dsAccountInquiry</DataSetName>
            <Left>0in</Left><Top>0in</Top>
            <Width>8.0in</Width>
            <NoRowsMessage></NoRowsMessage>

            <TablixBody>
              <TablixColumns>
                <!-- Single column — full width -->
                <TablixColumn><Width>8.0in</Width></TablixColumn>
              </TablixColumns>

              <TablixRows>
                <!-- Header row: 0.001in (structurally required by rdl-tablix-patterns.md;
                     invisible — this is a List with no column headers) -->
                <TablixRow>
                  <Height>0.001in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>
                        <Textbox Name="AccountList_EmptyHeader">
                          <Paragraphs><Paragraph><TextRuns><TextRun>
                            <Value></Value>
                          </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                          <Style><Border><Style>None</Style></Border></Style>
                        </Textbox>
                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
                <!-- One detail row — auto-height via inner content -->
                <TablixRow>
                  <Height>4.2in</Height>
                  <TablixCells>
                    <TablixCell>
                      <CellContents>

                        <!-- AccountRecord: outer container per customer -->
                        <Rectangle Name="AccountRecord">
                          <Left>0in</Left><Top>0in</Top>
                          <Width>8.0in</Width>
                          <Style>
                            <Border><Style>None</Style></Border>
                          </Style>
                          <ReportItems>

                            <!-- ── A. CustomerSeparatorBar ── -->
                            <Rectangle Name="CustomerSeparatorBar">
                              <Left>0in</Left><Top>0in</Top>
                              <Width>8.0in</Width><Height>0.164in</Height>
                              <Style>
                                <BackgroundColor>#1A1A1A</BackgroundColor>
                                <Border><Style>None</Style></Border>
                              </Style>
                              <ReportItems>

                                <Textbox Name="Sep_CustomerLabel">
                                  <Left>0.074in</Left><Top>0.022in</Top>
                                  <Width>4.0in</Width><Height>0.12in</Height>
                                  <Paragraphs><Paragraph><TextRuns><TextRun>
                                    <Value>="Customer Record  —  " &amp; Fields!customer_number.Value</Value>
                                    <Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><FontWeight>Bold</FontWeight><Color>#FFFFFF</Color></Style>
                                  </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                                  <CanGrow>true</CanGrow>
                                </Textbox>

                                <Textbox Name="Sep_AccountLabel">
                                  <Left>6.0in</Left><Top>0.022in</Top>
                                  <Width>2.0in</Width><Height>0.12in</Height>
                                  <Paragraphs><Paragraph><TextRuns><TextRun>
                                    <Value>="Account: " &amp; Fields!account_number.Value</Value>
                                    <Style><FontFamily>Calibri</FontFamily><FontSize>6.5pt</FontSize><Color>#AAAAAA</Color></Style>
                                  </TextRun></TextRuns><Style><TextAlign>Right</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                                  <CanGrow>true</CanGrow>
                                </Textbox>

                              </ReportItems>
                            </Rectangle>

                            <!-- ── B. CustomerProfilePanel ── Left panel, row 1 -->
                            <Rectangle Name="CustomerProfilePanel">
                              <Left>0in</Left><Top>0.177in</Top>
                              <Width>3.85in</Width><Height>0.836in</Height>
                              <Style>
                                <BackgroundColor>#FFFFFF</BackgroundColor>
                                <Border><Style>Solid</Style><Color>#C8DBF0</Color><Width>1pt</Width></Border>
                              </Style>
                              <ReportItems>

                                <!-- Left accent bar -->
                                <Rectangle Name="ProfileAccentBar">
