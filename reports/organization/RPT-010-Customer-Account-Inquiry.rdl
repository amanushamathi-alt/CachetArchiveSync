                                  <Width>3.5in</Width><Height>0.1in</Height>
                                  <Paragraphs><Paragraph><TextRuns><TextRun>
                                    <Value>VERIFICATION STATUS</Value>
                                    <Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><FontWeight>Bold</FontWeight><Color>#555555</Color></Style>
                                  </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                                  <CanGrow>true</CanGrow>
                                </Textbox>

                                <!-- Row 1: ID on File -->
                                <Textbox Name="Verif_ID_Indicator">
                                  <Left>0.112in</Left><Top>0.18in</Top>
                                  <Width>0.15in</Width><Height>0.12in</Height>
                                  <Paragraphs><Paragraph><TextRuns><TextRun>
                                    <Value>=IIF(Fields!has_id_on_file.Value = 1, "✓", "✗")</Value>
                                    <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight>
                                      <Color>=IIF(Fields!has_id_on_file.Value = 1, "#375623", "#C45911")</Color>
                                    </Style>
                                  </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style>
                                    <BackgroundColor>=IIF(Fields!has_id_on_file.Value = 1, "#E8F5E9", "#FEEDE5")</BackgroundColor>
                                    <VerticalAlign>Middle</VerticalAlign>
                                    <Border><Style>None</Style></Border>
                                  </Style>
                                  <CanGrow>false</CanGrow>
                                </Textbox>
                                <Textbox Name="Verif_ID_Label">
                                  <Left>0.28in</Left><Top>0.18in</Top>
                                  <Width>1.0in</Width><Height>0.12in</Height>
                                  <Paragraphs><Paragraph><TextRuns><TextRun>
                                    <Value>ID on File</Value>
                                    <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#1A1A1A</Color></Style>
                                  </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                                  <CanGrow>true</CanGrow>
                                </Textbox>
                                <Textbox Name="Verif_ID_Detail">
                                  <Left>1.35in</Left><Top>0.18in</Top>
                                  <Width>2.5in</Width><Height>0.12in</Height>
                                  <Paragraphs><Paragraph><TextRuns><TextRun>
                                    <Value>=IIF(Fields!has_id_on_file.Value = 1, IIF(IsNothing(Fields!id_document_type.Value), "On File", Fields!id_document_type.Value), "Not on file")</Value>
                                    <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#555555</Color></Style>
                                  </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                                  <CanGrow>true</CanGrow>
                                </Textbox>

                                <!-- Row 2: Phone Verified -->
                                <Textbox Name="Verif_Phone_Indicator">
                                  <Left>0.112in</Left><Top>0.33in</Top>
                                  <Width>0.15in</Width><Height>0.12in</Height>
                                  <Paragraphs><Paragraph><TextRuns><TextRun>
                                    <Value>=IIF(Fields!has_phone_verified.Value = 1, "✓", "✗")</Value>
                                    <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight>
                                      <Color>=IIF(Fields!has_phone_verified.Value = 1, "#375623", "#C45911")</Color>
                                    </Style>
                                  </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style>
                                    <BackgroundColor>=IIF(Fields!has_phone_verified.Value = 1, "#E8F5E9", "#FEEDE5")</BackgroundColor>
                                    <VerticalAlign>Middle</VerticalAlign>
                                    <Border><Style>None</Style></Border>
                                  </Style>
                                  <CanGrow>false</CanGrow>
                                </Textbox>
                                <Textbox Name="Verif_Phone_Label">
                                  <Left>0.28in</Left><Top>0.33in</Top>
                                  <Width>1.0in</Width><Height>0.12in</Height>
                                  <Paragraphs><Paragraph><TextRuns><TextRun>
                                    <Value>Phone Verified</Value>
                                    <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#1A1A1A</Color></Style>
                                  </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                                  <CanGrow>true</CanGrow>
                                </Textbox>
                                <Textbox Name="Verif_Phone_Detail">
                                  <Left>1.35in</Left><Top>0.33in</Top>
                                  <Width>2.5in</Width><Height>0.12in</Height>
                                  <Paragraphs><Paragraph><TextRuns><TextRun>
                                    <Value>=IIF(Fields!has_phone_verified.Value = 1, "Verified", "Not verified")</Value>
                                    <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#555555</Color></Style>
                                  </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                                  <CanGrow>true</CanGrow>
                                </Textbox>

                                <!-- Row 3: KYC Completed -->
                                <Textbox Name="Verif_KYC_Indicator">
                                  <Left>0.112in</Left><Top>0.48in</Top>
                                  <Width>0.15in</Width><Height>0.12in</Height>
                                  <Paragraphs><Paragraph><TextRuns><TextRun>
                                    <Value>=IIF(Fields!has_kyc_completed.Value = 1, "✓", "✗")</Value>
                                    <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight>
                                      <Color>=IIF(Fields!has_kyc_completed.Value = 1, "#375623", "#C45911")</Color>
                                    </Style>
                                  </TextRun></TextRuns><Style><TextAlign>Center</TextAlign></Style></Paragraph></Paragraphs>
                                  <Style>
                                    <BackgroundColor>=IIF(Fields!has_kyc_completed.Value = 1, "#E8F5E9", "#FEEDE5")</BackgroundColor>
                                    <VerticalAlign>Middle</VerticalAlign>
                                    <Border><Style>None</Style></Border>
                                  </Style>
                                  <CanGrow>false</CanGrow>
                                </Textbox>
                                <Textbox Name="Verif_KYC_Label">
                                  <Left>0.28in</Left><Top>0.48in</Top>
                                  <Width>1.0in</Width><Height>0.12in</Height>
                                  <Paragraphs><Paragraph><TextRuns><TextRun>
                                    <Value>KYC Completed</Value>
                                    <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#1A1A1A</Color></Style>
                                  </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                                  <CanGrow>true</CanGrow>
                                </Textbox>
                                <Textbox Name="Verif_KYC_Detail">
                                  <Left>1.35in</Left><Top>0.48in</Top>
                                  <Width>2.5in</Width><Height>0.12in</Height>
                                  <Paragraphs><Paragraph><TextRuns><TextRun>
                                    <Value>=IIF(Fields!has_kyc_completed.Value = 1, "Completed", "Not completed")</Value>
                                    <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#555555</Color></Style>
                                  </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                                  <CanGrow>true</CanGrow>
                                </Textbox>

                                <!-- Multiple Accounts warning — visible only when has_multiple_accounts = 1 -->
                                <Textbox Name="VerifNote_MultipleAccounts">
                                  <Left>0.112in</Left><Top>0.63in</Top>
                                  <Width>3.7in</Width><Height>0.1in</Height>
                                  <Visibility>
                                    <Hidden>=IIF(Fields!has_multiple_accounts.Value = 1, false, true)</Hidden>
                                  </Visibility>
                                  <Paragraphs><Paragraph><TextRuns><TextRun>
                                    <Value>⚠ Multiple accounts on file</Value>
                                    <Style><FontFamily>Calibri</FontFamily><FontSize>7pt</FontSize><FontStyle>Italic</FontStyle><Color>#833C00</Color></Style>
                                  </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                                  <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                                  <CanGrow>true</CanGrow>
                                </Textbox>

                              </ReportItems>
                            </Rectangle>

                            <!-- ── F. TransactionHistoryLabel ── -->
                            <Textbox Name="TransactionHistoryLabel">
                              <Left>0in</Left><Top>1.887in</Top>
                              <Width>8.0in</Width><Height>0.134in</Height>
                              <Paragraphs><Paragraph><TextRuns><TextRun>
                                <Value>="TRANSACTION HISTORY  (Last " &amp; Parameters!transaction_rows_max.Value &amp; " Transactions — account " &amp; Fields!account_number.Value &amp; ")"</Value>
                                <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><FontWeight>Bold</FontWeight><Color>#1A1A1A</Color></Style>
                              </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                              <Style>
                                <BackgroundColor>#D6E4F0</BackgroundColor>
                                <VerticalAlign>Middle</VerticalAlign>
                                <PaddingLeft>5pt</PaddingLeft>
                                <Border><Style>None</Style></Border>
                              </Style>
                              <CanGrow>true</CanGrow>
                            </Textbox>

                            <!-- ── G. TransactionSubreportItem ── -->
                            <Subreport Name="TransactionSubreportItem">
                              <Left>0in</Left><Top>2.045in</Top>
                              <Width>8.0in</Width><Height>2.0in</Height>
                              <ReportName>RPT-010-Transactions-Subreport</ReportName>
                              <Parameters>
                                <Parameter Name="gift_card_account_id">
                                  <Value>=Fields!gift_card_account_id.Value</Value>
                                </Parameter>
                                <Parameter Name="top_n">
                                  <Value>=Parameters!transaction_rows_max.Value</Value>
                                </Parameter>
                                <Parameter Name="organization_timezone">
                                  <Value>0</Value>
                                </Parameter>
                              </Parameters>
                              <Style>
                                <Border><Style>None</Style></Border>
                              </Style>
                            </Subreport>

                            <!-- ── H. CustomerSeparatorRule ── dashed line at bottom of record -->
                            <Line Name="CustomerSeparatorRule">
                              <Left>0in</Left><Top>4.1in</Top>
                              <Width>8.0in</Width><Height>0in</Height>
                              <Style>
                                <Border>
                                  <Style>Dashed</Style>
                                  <Color>#1A1A1A</Color>
                                  <Width>1pt</Width>
                                </Border>
                              </Style>
                            </Line>

                          </ReportItems>
                        </Rectangle>

                      </CellContents>
                    </TablixCell>
                  </TablixCells>
                </TablixRow>
              </TablixRows>
            </TablixBody>

            <!-- TablixCorner required by rdl-tablix-patterns.md mandatory checklist -->
            <TablixCorner />

            <TablixColumnHierarchy>
              <TablixMembers>
                <TablixMember />
              </TablixMembers>
            </TablixColumnHierarchy>

            <!-- Header member required by rdl-tablix-patterns.md (List has no visible
                 header row — 0.001in empty row satisfies the structural requirement) -->
            <TablixRowHierarchy>
              <TablixMembers>
                <TablixMember>
                  <KeepWithGroup>After</KeepWithGroup>
                  <RepeatOnNewPage>true</RepeatOnNewPage>
                  <KeepTogether>true</KeepTogether>
                </TablixMember>
                <TablixMember>
                  <Group Name="AccountList_Details">
                    <DataGroupName>AccountList_Details</DataGroupName>
                  </Group>
                </TablixMember>
              </TablixMembers>
            </TablixRowHierarchy>

            <Style><Border><Style>None</Style></Border></Style>
          </Tablix>

            </ReportItems>
          </Rectangle>

          <!-- ─────────────────────────────────────────────────────────
               3. NO RESULTS MESSAGE
               Shown only when dsAccountInquiry returns 0 rows.
               Hidden = true when rows exist; shown when rows = 0.
          ──────────────────────────────────────────────────────────── -->
          <Rectangle Name="NoResultsMsg">
            <Left>0in</Left><Top>0.6in</Top>
            <Width>8.0in</Width><Height>0.45in</Height>
            <Visibility>
              <Hidden>=IIF(CountRows("dsAccountInquiry") > 0, true, false)</Hidden>
            </Visibility>
            <Style>
              <BackgroundColor>#FFFFFF</BackgroundColor>
              <Border><Style>Solid</Style><Color>#C8DBF0</Color><Width>1pt</Width></Border>
            </Style>
            <ReportItems>

              <!-- Left accent — warning orange -->
              <Rectangle Name="NoResults_AccentBar">
                <Left>0in</Left><Top>0in</Top>
                <Width>0.037in</Width><Height>0.45in</Height>
                <Style>
                  <BackgroundColor>#833C00</BackgroundColor>
                  <Border><Style>None</Style></Border>
                </Style>
              </Rectangle>

              <Textbox Name="NoResults_Title">
                <Left>0.112in</Left><Top>0.037in</Top>
                <Width>7.8in</Width><Height>0.14in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>No customer accounts found matching the provided search criteria.</Value>
                  <Style><FontFamily>Calibri</FontFamily><FontSize>8pt</FontSize><FontWeight>Bold</FontWeight><Color>#833C00</Color></Style>
                </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

              <Textbox Name="NoResults_Sub">
                <Left>0.112in</Left><Top>0.22in</Top>
                <Width>7.8in</Width><Height>0.14in</Height>
                <Paragraphs><Paragraph><TextRuns><TextRun>
                  <Value>Verify the PAN, customer name, or ID number entered and try again.</Value>
                  <Style><FontFamily>Calibri</FontFamily><FontSize>7.5pt</FontSize><Color>#555555</Color></Style>
                </TextRun></TextRuns><Style /></Paragraph></Paragraphs>
                <Style><VerticalAlign>Middle</VerticalAlign><Border><Style>None</Style></Border></Style>
                <CanGrow>true</CanGrow>
              </Textbox>

            </ReportItems>
          </Rectangle>

        </ReportItems>
        <Style />
      </Body>

    </ReportSection>
  </ReportSections>

</Report>
